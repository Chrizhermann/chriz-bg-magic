BACKUP ~weidu_external/backup/chriz-bg-magic~
AUTHOR ~Christopher Hermann (github.com/Chrizhermann/chriz-bg-magic)~
VERSION ~v0.1.0-dev~

ALWAYS
  INCLUDE ~chriz-bg-magic/lib/cbmagic_shared.tpa~
  INCLUDE ~chriz-bg-magic/lib/cbmagic_spells.tpa~
  INCLUDE ~chriz-bg-magic/lib/cbmagic_fixes.tpa~
  INCLUDE ~chriz-bg-magic/lib/cbmagic_sr.tpa~
END

LANGUAGE ~English~ ~english~ ~chriz-bg-magic/languages/english/setup.tra~

// ============================================================
// chriz-bg-magic: Christopher's own spell mod for BG2:EE and EET.
// Only the changes he picked; everything else stays as in the base game.
//
// 0  Chriz BG Magic: every decided change, one function each
//    (chriz-bg-magic/lib/*.tpa; what each does: docs/components.md)
// ============================================================

BEGIN @100 DESIGNATED 0
LABEL ~chriz-bg-magic-main~
REQUIRE_PREDICATE GAME_IS ~bg2ee eet~ @9000
LAF cbmagic_check_spell_revisions END
LAM cbmagic_index_scrolls
LAF cbmagic_fix_spirit_armor END
LAF cbmagic_fix_minor_spell_deflection END
LAF cbmagic_fix_breath_saves END
LAF cbmagic_fix_wake_on_damage END
LAF cbmagic_fix_web END
LAF cbmagic_kept_invisibility END
LAF cbmagic_kept_luck END
LAF cbmagic_kept_clairvoyance END
LAF cbmagic_kept_invisibility_sphere END
LAF cbmagic_kept_confusion END
LAF cbmagic_kept_minor_sequencer END
LAF cbmagic_kept_teleport_field END
LAF cbmagic_kept_oracle END
LAF cbmagic_kept_contingency END
LAF cbmagic_kept_sphere_of_chaos END
LAF cbmagic_kept_spell_sequencer END
LAF cbmagic_kept_spell_trigger END
LAF cbmagic_kept_chain_contingency END
LAF cbmagic_kept_bless END
LAF cbmagic_kept_shillelagh END
LAF cbmagic_kept_doom END
LAF cbmagic_kept_faerie_fire END
LAF cbmagic_kept_aid END
LAF cbmagic_kept_silence END
LAF cbmagic_kept_free_action END
LAF cbmagic_kept_neutralize_poison END
LAF cbmagic_kept_divine_power END
LAF cbmagic_kept_negative_plane_protection END
LAF cbmagic_kept_iron_skins END
LAF cbmagic_kept_mass_regenerate END
LAF cbmagic_kept_regeneration END
LAF cbmagic_kept_greater_restoration END
