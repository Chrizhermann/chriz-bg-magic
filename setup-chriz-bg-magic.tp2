BACKUP ~weidu_external/backup/chriz-bg-magic~
AUTHOR ~Christopher Hermann (github.com/Chrizhermann/chriz-bg-magic)~
VERSION ~v0.1.0-dev~

ALWAYS
  INCLUDE ~chriz-bg-magic/lib/cbmagic_shared.tpa~
  INCLUDE ~chriz-bg-magic/lib/cbmagic_spells.tpa~
  INCLUDE ~chriz-bg-magic/lib/cbmagic_fixes.tpa~
  INCLUDE ~chriz-bg-magic/lib/cbmagic_scs.tpa~
END

LANGUAGE ~English~ ~english~ ~chriz-bg-magic/languages/english/setup.tra~

// ============================================================
// chriz-bg-magic: Christopher's own spell mod for BG2:EE and EET.
// Only the changes he picked; everything else stays as in the base game.
//
// 0  Chriz BG Magic: every decided change, one function each
//    (chriz-bg-magic/lib/*.tpa; what each does: docs/components.md)
// ============================================================

BEGIN @100 DESIGNATED 0
LABEL ~chriz-bg-magic-main~
REQUIRE_PREDICATE GAME_IS ~bg2ee eet~ @9000
LAF cbmagic_check_spell_revisions END
LAM cbmagic_index_scrolls
LAF cbmagic_fix_spirit_armor END
LAF cbmagic_fix_minor_spell_deflection END
LAF cbmagic_fix_breath_saves END
LAF cbmagic_fix_wake_on_damage END
LAF cbmagic_fix_web END
LAF cbmagic_scs_chromatic_orb END
LAF cbmagic_scs_melfs_minute_meteors END
LAF cbmagic_scs_skull_trap END
LAF cbmagic_scs_lower_resistance END
LAF cbmagic_scs_power_word_silence END
LAF cbmagic_scs_power_word_stun END
LAF cbmagic_scs_mantle END
LAF cbmagic_scs_project_image END
LAF cbmagic_scs_abi_dalzim END
LAF cbmagic_scs_improved_mantle END
LAF cbmagic_scs_power_word_blind END
LAF cbmagic_scs_simulacrum END
LAF cbmagic_scs_wizard_symbol_death END
LAF cbmagic_scs_wizard_symbol_stun END
LAF cbmagic_scs_wizard_symbol_fear END
LAF cbmagic_scs_absolute_immunity END
LAF cbmagic_scs_power_word_kill END
LAF cbmagic_scs_cleric_symbol_death END
LAF cbmagic_scs_cleric_symbol_stun END
LAF cbmagic_scs_cleric_symbol_fear END
LAF cbmagic_scs_cacofiend END
LAF cbmagic_scs_summon_fiend END
LAF cbmagic_scs_wizard_gate END
LAF cbmagic_scs_cleric_gate END
LAF cbmagic_scs_blade_barrier END
LAF cbmagic_scs_call_lightning END
LAF cbmagic_scs_defensive_harmony END
LAF cbmagic_scs_globe_of_blades END
LAF cbmagic_scs_glyph_of_warding END
LAF cbmagic_scs_magical_stone END
LAF cbmagic_scs_insect_plague END
LAF cbmagic_scs_natures_beauty END
LAF cbmagic_scs_lesser_restoration END
