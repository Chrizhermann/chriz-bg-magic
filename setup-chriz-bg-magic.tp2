BACKUP ~weidu_external/backup/chriz-bg-magic~
AUTHOR ~Christopher Hermann (github.com/Chrizhermann/chriz-bg-magic)~
VERSION ~v0.1.0-dev~

ALWAYS
  INCLUDE ~chriz-bg-magic/lib/cbmagic_shared.tpa~
  INCLUDE ~chriz-bg-magic/lib/cbmagic_spells.tpa~
  INCLUDE ~chriz-bg-magic/lib/cbmagic_healing.tpa~
  INCLUDE ~chriz-bg-magic/lib/cbmagic_fixes.tpa~
  INCLUDE ~chriz-bg-magic/lib/cbmagic_bonus.tpa~
  INCLUDE ~chriz-bg-magic/lib/cbmagic_iwd.tpa~
  INCLUDE ~chriz-bg-magic/lib/cbmagic_live.tpa~
  INCLUDE ~chriz-bg-magic/lib/cbmagic_resources.tpa~
END

LANGUAGE ~English~ ~english~ ~chriz-bg-magic/languages/english/setup.tra~ ~chriz-bg-magic/languages/english/resources.tra~

// ============================================================
// chriz-bg-magic: Christopher's own spell mod for BG2:EE and EET.
// Only the changes he picked; everything else stays as in the base game.
//
// 0  Chriz BG Magic. Every spell and item it changes is written whole from
//    defs/; what stood there before does not matter.
// ============================================================

BEGIN @100 DESIGNATED 0
LABEL ~chriz-bg-magic-main~
REQUIRE_PREDICATE GAME_IS ~bg2ee eet~ @9000
LAF cbmagic_check_spell_revisions END
LAF cbmagic_write_resources END
LAM cbmagic_index_scrolls
LAF cbmagic_iwd_spells END
LAF cbmagic_record_live END
LAF cbmagic_bonus END
