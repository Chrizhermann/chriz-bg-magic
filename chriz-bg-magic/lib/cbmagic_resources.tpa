    WRITE_LONG 0x9e cbm_state_HASTE_IMMUNITY
    WRITE_LONG 0xd2 cbm_Haste
    WRITE_LONG 0x162 cbm_state_HASTE_IMMUNITY
  COPY ~chriz-bg-magic/res/spwm112.spl~ ~override/spwm112.spl~
    WRITE_LONG 0x9e cbm_state_SLOW_IMMUNITY
    WRITE_LONG 0x102 cbm_Haste
  COPY ~chriz-bg-magic/res/spwm112a.spl~ ~override/spwm112a.spl~
    WRITE_BYTE 0x27 cbm_Slow
    WRITE_LONG 0xa2 cbm_Slow
    WRITE_LONG 0x12e cbm_state_HASTE_IMMUNITY
  COPY ~chriz-bg-magic/res/spwm115.spl~ ~override/spwm115.spl~
    WRITE_LONG 0x9e cbm_state_HASTE_IMMUNITY
    WRITE_LONG 0x102 cbm_Slow
  COPY ~chriz-bg-magic/res/spwm115a.spl~ ~override/spwm115a.spl~
    WRITE_BYTE 0x27 cbm_Haste
    WRITE_LONG 0x9e cbm_state_HASTE_IMMUNITY
    WRITE_LONG 0xd2 cbm_Haste
  COPY ~chriz-bg-magic/res/spwm126.spl~ ~override/spwm126.spl~
    WRITE_LONG 0xa2 cbm_state_MINOR_GLOBE
  COPY ~chriz-bg-magic/res/spwm164.spl~ ~override/spwm164.spl~
    WRITE_LONG 0x9e cbm_state_SLOW_IMMUNITY
    WRITE_LONG 0x102 cbm_Haste
  COPY ~chriz-bg-magic/res/spwm164a.spl~ ~override/spwm164a.spl~
    WRITE_BYTE 0x27 cbm_Slow
    WRITE_LONG 0xa2 cbm_Slow
    WRITE_LONG 0x12e cbm_state_HASTE_IMMUNITY
  COPY ~chriz-bg-magic/res/spwm168.spl~ ~override/spwm168.spl~
  COPY ~chriz-bg-magic/res/staf11.itm~ ~override/staf11.itm~
    WRITE_LONG 0x122 cbm_state_CHARM_IMMUNITY
    WRITE_LONG 0x7e2 cbm_DispelScreen
  COPY ~chriz-bg-magic/res/sw1h27.itm~ ~override/sw1h27.itm~
    WRITE_LONG 0xea cbm_state_HOLD_IMMUNITY
    WRITE_LONG 0x326 cbm_state_HASTE_IMMUNITY
    WRITE_LONG 0x38a cbm_Slow
  COPY ~chriz-bg-magic/res/sw1h27.spl~ ~override/sw1h27.spl~
    WRITE_BYTE 0x27 cbm_Haste
    WRITE_LONG 0x9e cbm_state_HASTE_IMMUNITY
    WRITE_LONG 0xd2 cbm_Haste
  COPY ~chriz-bg-magic/res/sw2h10.itm~ ~override/sw2h10.itm~
    WRITE_LONG 0x38a cbm_DispelScreen
  COPY ~chriz-bg-magic/res/sw2h10dm.spl~ ~override/sw2h10dm.spl~
    WRITE_LONG 0x222 cbm_DispelScreen
  COPY ~chriz-bg-magic/res/sw2h19.itm~ ~override/sw2h19.itm~
    WRITE_LONG 0x38a cbm_DispelScreen
  COPY ~chriz-bg-magic/res/trollall.itm~ ~override/trollall.itm~
  COPY ~chriz-bg-magic/res/trollsp.itm~ ~override/trollsp.itm~
  COPY ~chriz-bg-magic/res/trollspi.itm~ ~override/trollspi.itm~
  COPY ~chriz-bg-magic/res/trolltor.itm~ ~override/trolltor.itm~
    WRITE_LONG 0x1ce cbm_state_SLOW_IMMUNITY
    WRITE_LONG 0x232 cbm_Haste
  COPY ~chriz-bg-magic/res/trolltor.spl~ ~override/trolltor.spl~
    WRITE_BYTE 0x27 cbm_Slow
    WRITE_LONG 0xa2 cbm_Slow
    WRITE_LONG 0x12e cbm_state_HASTE_IMMUNITY
  COPY ~chriz-bg-magic/res/wolfgr.itm~ ~override/wolfgr.itm~
  ACTION_IF NOT FILE_EXISTS_IN_GAME ~M___EEex.lua~ BEGIN
  COPY ~chriz-bg-magic/res/without-eeex/sppr312a.spl~ ~override/sppr312a.spl~
    WRITE_LONG 0x162 cbm_state_BUFF_ENHANCEMENT
  END
END

// A scroll shows its spell's description: every scroll of this game that casts or teaches a spell
// whose text this mod writes, also one this mod does not ship.
DEFINE_ACTION_FUNCTION cbmagic_scroll_texts
