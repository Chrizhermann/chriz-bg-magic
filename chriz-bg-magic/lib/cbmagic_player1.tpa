// The main character as a statue or imprisoned (lua/M_CBMP1.lua). Petrification and imprisonment no
// longer end the game at once: he becomes a statue or vanishes into a prison, the party takes him
// along, and only Stone to Flesh or Freedom (where he vanished) bring him back. Needs EEex; without
// it nothing here is installed and the game ends as before.
// What can cure him: every spell and item of this game that turns stone to flesh (opcode 43) or
// frees a prisoner (opcode 212), by itself or through a spell it casts (opcodes 146, 148, 326),
// whatever mod brought it. Nothing is changed; the lists go into lua/M_CBMP1.lua for the dead-end
// rule. A file that cannot be read is left out.
DEFINE_ACTION_FUNCTION cbmagic_cure_list
  RET stone_spells stone_items free_spells free_items
BEGIN
  ACTION_FOR_EACH kind IN ~spl~ ~itm~ BEGIN
    COPY_EXISTING_REGEXP GLOB ~^.+\.%kind%$~ ~override~
      SPRINT me ~%SOURCE_RES%~
      TO_UPPER me
      PATCH_TRY
        PATCH_IF (~%kind%~ STRING_EQUAL ~spl~) BEGIN
          GET_OFFSET_ARRAY cbm_heads SPL_V10_HEADERS
        END ELSE BEGIN
          GET_OFFSET_ARRAY cbm_heads ITM_V10_HEADERS
        END
        PHP_EACH cbm_heads AS index => head BEGIN
          PATCH_IF (~%kind%~ STRING_EQUAL ~spl~) BEGIN
            GET_OFFSET_ARRAY2 cbm_effects head SPL_V10_HEAD_EFFECTS
          END ELSE BEGIN
            GET_OFFSET_ARRAY2 cbm_effects head ITM_V10_HEAD_EFFECTS
          END
          PHP_EACH cbm_effects AS number => effect BEGIN
            READ_SHORT effect opcode
            PATCH_IF (opcode = 43) BEGIN SET $cbm_stone(~%me%~ ~%kind%~) = 1 END
            PATCH_IF (opcode = 212) BEGIN SET $cbm_free(~%me%~ ~%kind%~) = 1 END
            PATCH_IF (opcode = 146) OR (opcode = 148) OR (opcode = 326) BEGIN
              READ_ASCII (effect + 0x14) cast (8) NULL
              TO_UPPER cast
              PATCH_IF (~%cast%~ STR_CMP ~~) BEGIN SET $cbm_casts(~%me%~ ~%kind%~ ~%cast%~) = 1 END
            END
          END
        END
      WITH DEFAULT
      END
    BUT_ONLY
  END
  // A caster of a cure is a cure, two steps deep.
  OUTER_FOR (round = 0; round < 2; ++round) BEGIN
    ACTION_PHP_EACH cbm_casts AS key => on BEGIN
      ACTION_IF VARIABLE_IS_SET $cbm_stone(~%key_2%~ ~spl~) BEGIN OUTER_SET $cbm_stone(~%key_0%~ ~%key_1%~) = 1 END
      ACTION_IF VARIABLE_IS_SET $cbm_free(~%key_2%~ ~spl~) BEGIN OUTER_SET $cbm_free(~%key_0%~ ~%key_1%~) = 1 END
    END
  END
  OUTER_SPRINT stone_spells ~~
  OUTER_SPRINT stone_items ~~
  OUTER_SPRINT free_spells ~~
  OUTER_SPRINT free_items ~~
  ACTION_PHP_EACH cbm_stone AS key => on BEGIN
    ACTION_IF (~%key_1%~ STRING_EQUAL ~spl~) BEGIN
      OUTER_SPRINT stone_spells ~%stone_spells%["%key_0%"] = true, ~
    END ELSE BEGIN
      OUTER_SPRINT stone_items ~%stone_items%["%key_0%"] = true, ~
    END
  END
  ACTION_PHP_EACH cbm_free AS key => on BEGIN
    ACTION_IF (~%key_1%~ STRING_EQUAL ~spl~) BEGIN
      OUTER_SPRINT free_spells ~%free_spells%["%key_0%"] = true, ~
    END ELSE BEGIN
      OUTER_SPRINT free_items ~%free_items%["%key_0%"] = true, ~
    END
  END
END

DEFINE_ACTION_FUNCTION cbmagic_main_character
BEGIN
  OUTER_SET ready = 0
  ACTION_IF FILE_EXISTS_IN_GAME ~M___EEex.lua~ BEGIN
    ACTION_IF RESOURCE_CONTAINS ~trigger.ids~ ~EEex_LuaTrigger~ BEGIN
      OUTER_SET ready = 1
    END
  END
  ACTION_IF ready BEGIN
    LAF cbmagic_state_value STR_VAR symbol = ~CBM_P1_NET~ RET CBM_P1_NET_STATE = state END
    LAF cbmagic_state_value STR_VAR symbol = ~CBM_P1_OUT~ RET CBM_P1_OUT_STATE = state END
    LAF cbmagic_state_value STR_VAR symbol = ~CBM_P1_STATUE~ RET CBM_P1_STATUE_STATE = state END
    LAF cbmagic_state_value STR_VAR symbol = ~CBM_P1_PRISON~ RET CBM_P1_PRISON_STATE = state END
    LAF cbmagic_cure_list RET CBM_P1_STONE_SPELLS = stone_spells CBM_P1_STONE_ITEMS = stone_items
      CBM_P1_FREE_SPELLS = free_spells CBM_P1_FREE_ITEMS = free_items END
    COPY ~chriz-bg-magic/lua/M_CBMP1.lua~ ~override/M_CBMP1.lua~
      EVALUATE_BUFFER
    // The travel hook's patterns (Baldur.exe 2.7.3.0). Without them the party cannot leave while he
    // is out, as in the base game's gather check.
    ACTION_IF DIRECTORY_EXISTS ~EEex_scripts/extra_pattern_dbs~ BEGIN
      COPY ~chriz-bg-magic/eeex/CBMP1.db~ ~EEex_scripts/extra_pattern_dbs/CBMP1.db~
    END
    // The tick, on top of every campaign's world script.
    OUTER_SET scripts = 0
    ACTION_IF FILE_EXISTS_IN_GAME ~campaign.2da~ BEGIN
      // WORLDSCRIPT is the first column after the campaign's name. The heading line has no name
      // in front, so its first column reads DESCRIPTION, which is no script. BG2:EE's table has
      // only the heading: then the game's own world scripts below.
      COPY_EXISTING ~campaign.2da~ ~override~
        READ_2DA_ENTRIES_NOW cbm_campaigns 3
        FOR (r = 0; r < cbm_campaigns; ++r) BEGIN
          READ_2DA_ENTRY_FORMER cbm_campaigns r 1 world
          PATCH_IF FILE_EXISTS_IN_GAME ~%world%.bcs~ BEGIN
            PATCH_IF NOT VARIABLE_IS_SET $cbm_world(~%world%~) BEGIN
              SET $cbm_world(~%world%~) = 1
              SET scripts += 1
            END
          END
        END
      BUT_ONLY
    END
    ACTION_IF (scripts = 0) BEGIN
      ACTION_FOR_EACH world IN ~BALDUR~ ~BALDUR25~ ~BDBALDUR~ BEGIN
        OUTER_SET $cbm_world(~%world%~) = 1
      END
    END
    ACTION_PHP_EACH cbm_world AS world => wanted BEGIN
      ACTION_IF FILE_EXISTS_IN_GAME ~%world%.bcs~ BEGIN
        EXTEND_TOP ~%world%.bcs~ ~chriz-bg-magic/baf/cbmp1.baf~
      END
    END
    // Dreams wait while he is out: his own dream script, every companion's dream script of the
    // campaigns' dialog tables (DREAM_SCRIPT_FILE is the third column, 25DREAM_SCRIPT_FILE the sixth
    // in PDIALOG; the heading line yields column names, which are no scripts) and the Solar's calls
    // after a rest in Throne of Bhaal.
    OUTER_SET $cbm_dream(~PLAYER1D~) = 1
    ACTION_FOR_EACH table IN ~pdialog~ ~25dialog~ ~bgdialog~ ~bddialog~ BEGIN
      ACTION_IF FILE_EXISTS_IN_GAME ~%table%.2da~ BEGIN
        COPY_EXISTING ~%table%.2da~ ~override~
          READ_2DA_ENTRIES_NOW cbm_rows 4
          FOR (r = 0; r < cbm_rows; ++r) BEGIN
            READ_2DA_ENTRY_FORMER cbm_rows r 3 dream
            SET $cbm_dream(~%dream%~) = 1
          END
          READ_2DA_ENTRIES_NOW cbm_long 7
          FOR (r = 0; r < cbm_long; ++r) BEGIN
            READ_2DA_ENTRY_FORMER cbm_long r 6 dream
            SET $cbm_dream(~%dream%~) = 1
          END
        BUT_ONLY
      END
    END
    ACTION_PHP_EACH cbm_dream AS dream => wanted BEGIN
      ACTION_IF FILE_EXISTS_IN_GAME ~%dream%.bcs~ BEGIN
        EXTEND_TOP ~%dream%.bcs~ ~chriz-bg-magic/baf/cbmp1_dream.baf~
      END
    END
    ACTION_IF FILE_EXISTS_IN_GAME ~ar4000.bcs~ BEGIN
      COPY_EXISTING ~ar4000.bcs~ ~override~
        DECOMPILE_AND_PATCH BEGIN
          REPLACE_TEXTUALLY ~^\([ %TAB%]*\)PartyRested()~ ~\1PartyRested()%LNL%\1!Global("CBM_P1_OUT","GLOBAL",1)~
        END
      BUT_ONLY
    END
  END ELSE BEGIN
    PRINT ~chriz-bg-magic: without EEex the main character's petrification and imprisonment stay as in the base game.~
  END
END
