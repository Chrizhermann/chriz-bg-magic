END

// ======================================================================================
// Divine spells
// ======================================================================================

// Checks whether a priest spell added via ADD_SPELL with `symbol` in SPELL.IDS (or with
// header icon `marker` and druid-only `0x4000` in SPPR<level>01..99) is already in the game.
DEFINE_ACTION_FUNCTION cbmagic_find_added_priest_spell
  INT_VAR level = 1
  STR_VAR symbol = ~~ marker = ~~
  RET found_res
BEGIN
  OUTER_SPRINT found_res ~~
  LAF cbmagic_spell_resref STR_VAR symbol RET resref found END
  ACTION_IF found BEGIN
    OUTER_SPRINT found_res ~%resref%~
  END ELSE BEGIN
    OUTER_FOR (num = 1; (num <= 99) AND (~%found_res%~ STRING_EQUAL ~~); ++num) BEGIN
      ACTION_IF (num < 10) BEGIN
        OUTER_SPRINT cand ~SPPR%level%0%num%~
      END ELSE BEGIN
        OUTER_SPRINT cand ~SPPR%level%%num%~
      END
      ACTION_IF (FILE_EXISTS_IN_GAME ~%cand%.spl~) BEGIN
        COPY_EXISTING - ~%cand%.spl~ ~override~
          PATCH_IF (BUFFER_LENGTH >= 0x72) BEGIN
            READ_SHORT 0x20 p_excl
            READ_ASCII 0x3a hdr_icon (8) NULL
            PATCH_IF (p_excl = 0x4000) AND (~%hdr_icon%~ STRING_EQUAL_CASE ~%marker%~) BEGIN
              SPRINT found_res ~%cand%~
            END
          END
      END
    END
  END
END

// --- Bless (row divine.bless) ---------------------------------------------------------
// Casting time 5 (from 9), duration 30 seconds + 1 round per caster level across 20
// abilities (levels 1-20, 36-150s), usable by clerics and druids as in vanilla.
// Preserves existing abilities and adds missing breakpoints.
DEFINE_ACTION_FUNCTION cbmagic_kept_bless
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_BLESS~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Bless (CLERIC_BLESS) is not in this game; left out.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: Bless (%spell%) left as it is: %reason%.~
      END ELSE BEGIN
        READ_LONG 0x64 ab_off
        READ_SHORT 0x68 ab_cnt
        READ_LONG 0x6a fx_off
        PATCH_IF (ab_cnt < 1) BEGIN
          PATCH_WARN ~chriz-bg-magic: Bless (%spell%) left as it is: it has no abilities.~
        END ELSE BEGIN
          SET has_130 = 0
          FOR (a = 0; a < ab_cnt; ++a) BEGIN
            READ_SHORT (ab_off + a * 0x28 + 0x1e) na
            READ_SHORT (ab_off + a * 0x28 + 0x20) fa
            FOR (i = 0; i < na; ++i) BEGIN
              SET fx = fx_off + (fa + i) * 0x30
              READ_SHORT fx op
              READ_ASCII (fx + 0x14) resource (8) NULL
              // The final bonus pass replaces op130 with our tagged plain rows.
              PATCH_IF (op = 130 || ((op = 54 || op = 73) && ~%resource%~ STRING_EQUAL ~CBTFAVOR~)) BEGIN SET has_130 = 1 END
            END
          END
          PATCH_IF !has_130 BEGIN
            PATCH_WARN ~chriz-bg-magic: Bless (%spell%) left as it is: no Bless effect (opcode 130).~
          END ELSE BEGIN
            READ_SHORT 0x20 p_excl
            SET new_excl = (p_excl BAND 0x3fff)
            PATCH_IF (new_excl != p_excl) BEGIN
              WRITE_SHORT 0x20 new_excl
              SET changed += 1
            END
            FOR (lvl = 1; lvl <= 20; ++lvl) BEGIN
              LPF cbmagic_ensure_ability_min_level INT_VAR min_level = lvl RET ability_index ins = inserted END
              SET changed += ins
            END
            READ_LONG 0x64 ab_off
            READ_SHORT 0x68 ab_cnt
            READ_LONG 0x6a fx_off
            FOR (a = 0; a < ab_cnt; ++a) BEGIN
              READ_SHORT (ab_off + a * 0x28 + 0x10) ml
              READ_SHORT (ab_off + a * 0x28 + 0x12) ct
              READ_SHORT (ab_off + a * 0x28 + 0x1e) na
              READ_SHORT (ab_off + a * 0x28 + 0x20) fa
              PATCH_IF (ct != 5) BEGIN
                WRITE_SHORT (ab_off + a * 0x28 + 0x12) 5
                SET changed += 1
              END
              SET eff_lvl = (ml < 1) ? 1 : ((ml > 20) ? 20 : ml)
              SET target_dur = 30 + eff_lvl * 6
              FOR (i = 0; i < na; ++i) BEGIN
                SET fx = fx_off + (fa + i) * 0x30
                READ_SHORT fx op
                READ_SLONG (fx + 0x08) p2
                READ_BYTE (fx + 0x0c) timing
                READ_LONG (fx + 0x0e) dur
                PATCH_IF ((op = 130) AND (timing = 0))
                      OR ((op = 142) AND (p2 = 17) AND (timing = 0))
                      OR ((op = 174) AND (timing = 4)) BEGIN
                  PATCH_IF (dur != target_dur) BEGIN
                    WRITE_LONG (fx + 0x0e) target_dur
                    SET changed += 1
                  END
                END
              END
            END
            PATCH_IF (changed > 0) BEGIN
              PATCH_PRINT ~chriz-bg-magic: Bless (%spell%): casting time 5 and 30s + 1 round/level scaling across 20 abilities.~
            END ELSE BEGIN
              PATCH_PRINT ~chriz-bg-magic: Bless (%spell%): casting time 5 and 30s + 1 round/level scaling present already.~
            END
          END
        END
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Bless~ END
      OUTER_SPRINT f1 @40004
      OUTER_SPRINT r1 @40025
      OUTER_SPRINT f2 @40065
      OUTER_SPRINT r2 @40066
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f1%~ replace = EVAL ~%r1%~ label = ~Bless~ END
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%f2%~ replace = EVAL ~%r2%~ label = ~Bless~ END
    END
  END
END

// --- Aid (row divine.aid) -------------------------------------------------------------
// Replaces the opcode-129 Aid payload with a hit-point-only bonus (opcode 18, min(L,10) +
// 1d8 with L = max(ability level, 3)), lasting 1 turn per level (60*L seconds), refreshing
// on recast, and displaying its own portrait icon (STATDESC row with SPPR150D).
DEFINE_ACTION_FUNCTION cbmagic_kept_aid
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_AID~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Aid (CLERIC_AID) is not in this game; left out.~
  END ELSE BEGIN
    OUTER_SET aid_desc_ref = RESOLVE_STR_REF (@40064)
    LAF cbmagic_statdesc_row INT_VAR desc_ref = aid_desc_ref STR_VAR bam = ~SPPR150D~ RET icon_row END
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: Aid (%spell%) left as it is: %reason%.~
      END ELSE BEGIN
        READ_LONG 0x64 ab_off
        READ_SHORT 0x68 ab_cnt
        READ_LONG 0x6a fx_off
        SET has_aid = 0
        FOR (a = 0; a < ab_cnt; ++a) BEGIN
          READ_SHORT (ab_off + a * 0x28 + 0x1e) n
          READ_SHORT (ab_off + a * 0x28 + 0x20) first
          FOR (i = 0; i < n; ++i) BEGIN
            SET fx = fx_off + (first + i) * 0x30
            READ_SHORT fx op
            PATCH_IF (op = 129) OR (op = 18) BEGIN SET has_aid = 1 END
          END
        END
        PATCH_IF !has_aid BEGIN
          PATCH_WARN ~chriz-bg-magic: Aid (%spell%) left as it is: no Aid or HP bonus effect (opcode 129/18).~
        END ELSE BEGIN
          LPF cbmagic_add_self_refresh RET ref_added = added ref_present = present misplaced END
          SET changed += ref_added
          READ_SHORT 0x68 ab_cnt
          FOR (a = 0; a < ab_cnt; ++a) BEGIN
            READ_LONG 0x64 ab_off
            READ_LONG 0x6a fx_off
            READ_SHORT (ab_off + a * 0x28 + 0x10) ml
            SET eff_lvl = (ml < 3) ? 3 : ml
            SET hp_flat = (eff_lvl > 10) ? 10 : eff_lvl
            SET target_dur = 60 * eff_lvl
            READ_SHORT (ab_off + a * 0x28 + 0x1e) n
            READ_SHORT (ab_off + a * 0x28 + 0x20) first
            SET old_dur = 0 - 1
            SET payload_seen = 0
            FOR (i = 0; i < n; ++i) BEGIN
              SET fx = fx_off + (first + i) * 0x30
              READ_SHORT fx op
              READ_SLONG (fx + 0x04) p1
              READ_SLONG (fx + 0x08) p2
              READ_BYTE (fx + 0x0c) timing
              READ_LONG (fx + 0x0e) dur
              READ_LONG (fx + 0x1c) dn
              READ_LONG (fx + 0x20) ds
              PATCH_IF ((op = 129) OR (op = 18)) AND (timing = 0) AND !payload_seen BEGIN
                SET payload_seen = 1
                SET old_dur = dur
                PATCH_IF (op != 18) OR (p1 != hp_flat) OR (p2 != 0) OR (dur != target_dur) OR (dn != 1) OR (ds != 8) BEGIN
                  WRITE_SHORT fx 18
                  WRITE_LONG (fx + 0x04) hp_flat
                  WRITE_LONG (fx + 0x08) 0
                  WRITE_BYTE (fx + 0x0c) 0
                  WRITE_LONG (fx + 0x0e) target_dur
                  WRITE_LONG (fx + 0x1c) 1
                  WRITE_LONG (fx + 0x20) 8
                  SET changed += 1
                END
              END
            END
            // Remove any duplicate opcode 129 effects in this ability.
            SET scanning = 1
            WHILE scanning BEGIN
              SET scanning = 0
              READ_LONG 0x64 ab_off
              READ_LONG 0x6a fx_off
              READ_SHORT (ab_off + a * 0x28 + 0x1e) n
              READ_SHORT (ab_off + a * 0x28 + 0x20) first
              FOR (i = 0; (i < n) AND !scanning; ++i) BEGIN
                SET fx = fx_off + (first + i) * 0x30
                READ_SHORT fx op
                PATCH_IF (op = 129) BEGIN
                  LPF cbmagic_delete_effect INT_VAR index = (first + i) END
                  SET changed += 1
                  SET scanning = 1
                END
              END
            END
            // Stretch timed companion effects (glow, expiry sound, portrait icon) that shared old_dur.
            READ_LONG 0x64 ab_off
            READ_LONG 0x6a fx_off
            READ_SHORT (ab_off + a * 0x28 + 0x1e) n
            READ_SHORT (ab_off + a * 0x28 + 0x20) first
            SET has_icon = 0
            FOR (i = 0; i < n; ++i) BEGIN
              SET fx = fx_off + (first + i) * 0x30
              READ_SHORT fx op
              READ_SLONG (fx + 0x08) p2
              READ_BYTE (fx + 0x0c) timing
              READ_LONG (fx + 0x0e) dur
              PATCH_IF ((timing = 0) OR (timing = 3) OR (timing = 4))
                    AND (old_dur > 0) AND (dur = old_dur) AND (dur != target_dur)
                    AND !((op = 215) AND (dur <= 6)) BEGIN
                WRITE_LONG (fx + 0x0e) target_dur
                SET changed += 1
              END
              PATCH_IF (op = 142) AND (p2 = icon_row) BEGIN
                SET has_icon = 1
                PATCH_IF (dur != target_dur) BEGIN
                  WRITE_LONG (fx + 0x0e) target_dur
                  SET changed += 1
                END
              END
            END
            PATCH_IF !has_icon BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 142 target = 2 power = 2
                parameter2 = icon_row timing = 0 resist_dispel = 3 duration = target_dur END
              SET changed += 1
            END
          END
          PATCH_IF (changed > 0) BEGIN
            PATCH_PRINT ~chriz-bg-magic: Aid (%spell%): hit-point-only bonus, 1 turn/level, self-refreshing, icon row %icon_row%.~
          END ELSE BEGIN
            PATCH_PRINT ~chriz-bg-magic: Aid (%spell%): hit-point-only bonus, 1 turn/level, self-refreshing, and icon present already.~
          END
        END
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Aid~ END
      OUTER_SPRINT f1 @40067
      OUTER_SPRINT r1 @40035
      OUTER_SPRINT f2 @40068
      OUTER_SPRINT r2 @40069
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f1%~ replace = EVAL ~%r1%~ label = ~Aid~ END
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%f2%~ replace = EVAL ~%r2%~ label = ~Aid~ END
    END
  END
END

// --- Shillelagh (row divine.shillelagh) -----------------------------------------------
// Vanilla mechanics, restricted to druids (cleric/paladin excluded at 0x20).
DEFINE_ACTION_FUNCTION cbmagic_kept_shillelagh
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_SHILLELAGH~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Shillelagh (CLERIC_SHILLELAGH) is not in this game; left out.~
  END ELSE BEGIN
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: Shillelagh (%spell%) left as it is: %reason%.~
      END ELSE BEGIN
        READ_SHORT 0x20 p_excl
        SET target_excl = ((p_excl BAND (BNOT 0xc000)) BOR 0x4000)
        PATCH_IF (p_excl != target_excl) BEGIN
          WRITE_SHORT 0x20 target_excl
          PATCH_PRINT ~chriz-bg-magic: Shillelagh (%spell%): restricted to druids.~
        END ELSE BEGIN
          PATCH_PRINT ~chriz-bg-magic: Shillelagh (%spell%): restricted to druids already.~
        END
      END
    BUT_ONLY
  END
END

// --- Doom (row divine.doom) -----------------------------------------------------------
// Casting time 1, -2 to THAC0, damage rolls (opcode 73) and all saves (no AC penalty),
// Save vs. Spell negates with penalty scaling from 0 at level 1 to -4 at level 9 (steps
// at 1, 3, 5, 7, 9). Preserves existing abilities and adds op 73 after leading op 321s.
DEFINE_ACTION_FUNCTION cbmagic_kept_doom
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_DOOM~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Doom (CLERIC_DOOM) is not in this game; left out.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: Doom (%spell%) left as it is: %reason%.~
      END ELSE BEGIN
        READ_LONG 0x64 ab_off
        READ_SHORT 0x68 ab_cnt
        READ_LONG 0x6a fx_off
        PATCH_IF (ab_cnt < 1) BEGIN
          PATCH_WARN ~chriz-bg-magic: Doom (%spell%) left as it is: it has no abilities.~
        END ELSE BEGIN
          SET has_doom = 0
          FOR (a = 0; a < ab_cnt; ++a) BEGIN
            READ_SHORT (ab_off + a * 0x28 + 0x1e) na
            READ_SHORT (ab_off + a * 0x28 + 0x20) fa
            FOR (i = 0; i < na; ++i) BEGIN
              SET fx = fx_off + (fa + i) * 0x30
              READ_SHORT fx op
              PATCH_IF (op = 54) OR ((op >= 33) AND (op <= 37)) BEGIN
                SET has_doom = 1
              END
            END
          END
          PATCH_IF !has_doom BEGIN
            PATCH_WARN ~chriz-bg-magic: Doom (%spell%) left as it is: no THAC0 or save penalty found.~
          END ELSE BEGIN
            FOR (step = 0; step <= 4; ++step) BEGIN
              SET ml = 1 + step * 2
              LPF cbmagic_ensure_ability_min_level INT_VAR min_level = ml RET ability_index ins = inserted END
              SET changed += ins
            END
            READ_SHORT 0x68 ab_cnt
            FOR (a = 0; a < ab_cnt; ++a) BEGIN
              READ_LONG 0x64 ab_off
              READ_SHORT (ab_off + a * 0x28 + 0x10) ml
              READ_SHORT (ab_off + a * 0x28 + 0x12) ct
              PATCH_IF (ct != 1) BEGIN
                WRITE_SHORT (ab_off + a * 0x28 + 0x12) 1
                SET changed += 1
              END
              SET sb = (ml >= 9) ? (0 - 4) : ((ml >= 7) ? (0 - 3) : ((ml >= 5) ? (0 - 2) : ((ml >= 3) ? (0 - 1) : 0)))
              // Remove any AC penalty (op 0) or misplaced op 73 (before a leading op 321).
              SET scanning = 1
              WHILE scanning BEGIN
                SET scanning = 0
                READ_LONG 0x64 ab_off
                READ_LONG 0x6a fx_off
                READ_SHORT (ab_off + a * 0x28 + 0x1e) na
                READ_SHORT (ab_off + a * 0x28 + 0x20) fa
                SET last_321 = 0 - 1
                FOR (i = 0; i < na; ++i) BEGIN
                  SET fx = fx_off + (fa + i) * 0x30
                  READ_SHORT fx op
                  PATCH_IF (op = 321) BEGIN SET last_321 = i END
                END
                FOR (i = 0; (i < na) AND !scanning; ++i) BEGIN
                  SET fx = fx_off + (fa + i) * 0x30
                  READ_SHORT fx op
                  PATCH_IF (op = 0) OR ((op = 73) AND (i <= last_321)) BEGIN
                    LPF cbmagic_delete_effect INT_VAR index = (fa + i) END
                    SET changed += 1
                    SET scanning = 1
                  END
                END
              END
              READ_LONG 0x64 ab_off
              READ_LONG 0x6a fx_off
              READ_SHORT (ab_off + a * 0x28 + 0x1e) na
              READ_SHORT (ab_off + a * 0x28 + 0x20) fa
              SET has_73 = 0
              SET pos_insert = na
              SET dur0 = 60
              FOR (i = 0; i < na; ++i) BEGIN
                SET fx = fx_off + (fa + i) * 0x30
                READ_SHORT fx op
                READ_SLONG (fx + 0x04) p1
                READ_LONG (fx + 0x0e) d
                PATCH_IF (op = 73) AND (p1 = (0 - 2)) BEGIN SET has_73 = 1 END
                PATCH_IF (op = 54) BEGIN
                  SET pos_insert = i + 1
                  PATCH_IF (d > 0) BEGIN SET dur0 = d END
                END ELSE PATCH_IF ((op >= 33) AND (op <= 37)) AND (pos_insert = na) BEGIN
                  SET pos_insert = i
                  PATCH_IF (d > 0) BEGIN SET dur0 = d END
                END
              END
              PATCH_IF !has_73 BEGIN
                LPF cbmagic_insert_effect INT_VAR ability = a position = pos_insert opcode = 73 target = 2 power = 1
                  parameter1 = (0 - 2) parameter2 = 0 timing = 0 resist_dispel = 1 duration = dur0
                  savingthrow = 1 savebonus = sb END
                SET changed += 1
              END
              READ_LONG 0x64 ab_off
              READ_LONG 0x6a fx_off
              READ_SHORT (ab_off + a * 0x28 + 0x1e) na
              READ_SHORT (ab_off + a * 0x28 + 0x20) fa
              FOR (i = 0; i < na; ++i) BEGIN
                SET fx = fx_off + (fa + i) * 0x30
                READ_SHORT fx op
                READ_LONG (fx + 0x24) cur_sv
                READ_SLONG (fx + 0x28) cur_sb
                PATCH_IF (op != 321) AND ((cur_sv != 1) OR (cur_sb != sb)) BEGIN
                  WRITE_LONG (fx + 0x24) 1
                  WRITE_LONG (fx + 0x28) sb
                  SET changed += 1
                END
              END
            END
            PATCH_IF (changed > 0) BEGIN
              PATCH_PRINT ~chriz-bg-magic: Doom (%spell%): casting time 1, -2 damage, Save vs. Spell scaling to -4.~
            END ELSE BEGIN
              PATCH_PRINT ~chriz-bg-magic: Doom (%spell%): damage penalty, casting time 1, and scaling save present already.~
            END
          END
        END
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Doom~ END
      OUTER_SPRINT f1 @40004
      OUTER_SPRINT r1 @40005
      OUTER_SPRINT f2 @40015
      OUTER_SPRINT r2 @40016
      OUTER_SPRINT f3 @40030
      OUTER_SPRINT r3 @40031
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f1%~ replace = EVAL ~%r1%~ label = ~Doom~ END
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f2%~ replace = EVAL ~%r2%~ label = ~Doom~ END
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%f3%~ replace = EVAL ~%r3%~ label = ~Doom~ END
    END
  END
END

// --- Faerie Fire (row divine.faerie_fire) ---------------------------------------------
// New level-1 druid-only spell added via ADD_SPELL (symbol CLERIC_CBMAGIC_FAERIE_FIRE).
// 5-ft (radius 75) enemy-only area projectile (cbmffir.pro via ADD_PROJECTILE), casting
// time 1, range 20, duration 4 rounds (24s), Save vs. Spell negates: -2 AC penalty, cures
// and prevents invisibility, purple glow. Uses base-game icons SPPR309C / SPPR309B.
DEFINE_ACTION_FUNCTION cbmagic_kept_faerie_fire
BEGIN
  LAF cbmagic_find_added_priest_spell INT_VAR level = 1
    STR_VAR symbol = ~CLERIC_CBMAGIC_FAERIE_FIRE~ marker = ~SPPR309C~
    RET found_res
  END
  ACTION_IF !(~%found_res%~ STRING_EQUAL ~~) BEGIN
    PRINT ~chriz-bg-magic: Faerie Fire (%found_res%) is in this game already.~
  END ELSE BEGIN
    LAF cbmagic_warn_text_language STR_VAR label = ~Faerie Fire~ END
    OUTER_SET proj_id = IDS_OF_SYMBOL (~projectl~ ~cbmffir~)
    ACTION_IF (proj_id >= 0) BEGIN
      OUTER_SET proj_id += 1
    END ELSE BEGIN
      OUTER_SET can_add_proj = 0
      ACTION_IF (FILE_EXISTS_IN_GAME ~projectl.ids~) BEGIN
        COPY_EXISTING - ~projectl.ids~ ~override~
          PATCH_IF (INDEX_BUFFER (~[0-9]~ 8) >= 0) BEGIN
            SET can_add_proj = 1
          END
      END
      ACTION_IF can_add_proj BEGIN
        COPY - ~chriz-bg-magic/lib/cbmagic_shared.tpa~ ~weidu_external/cbmffir.pro~
          DELETE_BYTES 0 BUFFER_LENGTH
          INSERT_BYTES 0 0x300
          WRITE_ASCII 0 ~PRO V1.0~ (8)
          WRITE_SHORT 0x08 3
          WRITE_SHORT 0x0a 20
          WRITE_LONG 0x0c 3
          WRITE_ASCII 0x10 ~TRA_04A~ (8)
          WRITE_ASCII 0x18 ~CAS_M08~ (8)
          WRITE_SHORT 0x28 2
          WRITE_LONG 0x100 0x80
          WRITE_ASCII 0x104 ~TRAVEL~ (8)
          WRITE_ASCII 0x11c ~STTRAVL1~ (8)
          WRITE_SHORT 0x132 256
          WRITE_SHORT 0x200 0x50
          WRITE_SHORT 0x202 0
          WRITE_SHORT 0x204 75
          WRITE_SHORT 0x206 75
          WRITE_SHORT 0x210 100
          WRITE_SHORT 0x214 197
          WRITE_BYTE 0x216 1
          WRITE_BYTE 0x217 255
          WRITE_SHORT 0x218 67
          WRITE_SHORT 0x21a 48
        ADD_PROJECTILE ~weidu_external/cbmffir.pro~
        OUTER_SET proj_id = cbmffir
      END ELSE BEGIN
        OUTER_SET proj_id = 190
      END
    END
    OUTER_SET name_ref = RESOLVE_STR_REF (@40032)
    OUTER_SET desc_ref = RESOLVE_STR_REF (@40033)
    // Build a clean SPL V1 in weidu_external and hand it to ADD_SPELL.
    COPY - ~chriz-bg-magic/lib/cbmagic_shared.tpa~ ~weidu_external/cbmffir.spl~
      DELETE_BYTES 0 BUFFER_LENGTH
      INSERT_BYTES 0 (0x72 + 0x28)
      WRITE_ASCII 0 ~SPL V1  ~ (8)
      WRITE_LONG 0x08 name_ref
      WRITE_LONG 0x0c (0 - 1)
      WRITE_LONG 0x18 0x04000400
      WRITE_SHORT 0x1c 2
      WRITE_SHORT 0x20 0x4000
      WRITE_ASCII 0x10 ~CAS_P06N~ #8
      WRITE_SHORT 0x22 15
      WRITE_BYTE 0x25 6
      WRITE_BYTE 0x27 0
      WRITE_LONG 0x34 1
      WRITE_ASCII 0x3a ~SPPR309C~ (8)
      WRITE_LONG 0x50 desc_ref
      WRITE_LONG 0x54 (0 - 1)
      WRITE_LONG 0x64 0x72
      WRITE_SHORT 0x68 1
      WRITE_LONG 0x6a (0x72 + 0x28)
      WRITE_SHORT 0x6e 0
      WRITE_SHORT 0x70 0
      WRITE_BYTE 0x72 1
      WRITE_SHORT (0x72 + 0x02) 2
      WRITE_ASCII (0x72 + 0x04) ~SPPR309B~ (8)
      WRITE_BYTE (0x72 + 0x0c) 4
      WRITE_SHORT (0x72 + 0x0e) 20
      WRITE_SHORT (0x72 + 0x10) 1
      WRITE_SHORT (0x72 + 0x12) 1
      WRITE_SHORT (0x72 + 0x14) 1
      WRITE_SHORT (0x72 + 0x1e) 0
      WRITE_SHORT (0x72 + 0x20) 0
      WRITE_SHORT (0x72 + 0x22) 1
      WRITE_SHORT (0x72 + 0x26) proj_id
      LPF cbmagic_insert_effect INT_VAR ability = 0 position = 999 opcode = 136 target = 2 power = 1
        timing = 1 resist_dispel = 2 duration = 0 savingthrow = 0 savebonus = 0 END
      LPF cbmagic_insert_effect INT_VAR ability = 0 position = 999 opcode = 321 target = 2 power = 1
        timing = 1 resist_dispel = 3 duration = 0 savingthrow = 1 savebonus = 0 STR_VAR resource = ~CBMFFIR~ END
      LPF cbmagic_insert_effect INT_VAR ability = 0 position = 999 opcode = 47 target = 2 power = 1
        timing = 1 resist_dispel = 1 duration = 0 savingthrow = 1 savebonus = 0 END
      LPF cbmagic_insert_effect INT_VAR ability = 0 position = 999 opcode = 0 target = 2 power = 1
        parameter1 = (0 - 2) parameter2 = 0 timing = 0 resist_dispel = 1 duration = 24 savingthrow = 1 savebonus = 0 END
      LPF cbmagic_insert_effect INT_VAR ability = 0 position = 999 opcode = 101 target = 2 power = 1
        parameter2 = 20 timing = 0 resist_dispel = 1 duration = 24 savingthrow = 1 savebonus = 0 END
      FOR (loc = 0; loc <= 6; ++loc) BEGIN
        LPF cbmagic_insert_effect INT_VAR ability = 0 position = 999 opcode = 8 target = 2 power = 1
          parameter1 = 1687590400 parameter2 = loc timing = 0 resist_dispel = 1 duration = 24
          savingthrow = 1 savebonus = 0 END
      END
      LPF cbmagic_insert_effect INT_VAR ability = 0 position = 999 opcode = 174 target = 2 power = 1
        timing = 1 resist_dispel = 1 duration = 0 savingthrow = 1 savebonus = 0 STR_VAR resource = ~EFF_P86~ END
    COPY - ~weidu_external/cbmffir.spl~ ~weidu_external/cbmffir.spl~
    ADD_SPELL ~weidu_external/cbmffir.spl~ 1 1 ~CLERIC_CBMAGIC_FAERIE_FIRE~
    LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_CBMAGIC_FAERIE_FIRE~ RET added_res = resref found END
    ACTION_IF found BEGIN
      COPY_EXISTING ~%added_res%.spl~ ~override~
        READ_LONG 0x64 ab_off
        READ_LONG 0x6a fx_off
        READ_SHORT (ab_off + 0x1e) n0
        READ_SHORT (ab_off + 0x20) first0
        FOR (i = 0; i < n0; ++i) BEGIN
          SET fx = fx_off + (first0 + i) * 0x30
          READ_SHORT fx op
          PATCH_IF (op = 321) BEGIN
            WRITE_ASCIIE (fx + 0x14) ~%added_res%~ #8
          END
        END
      BUT_ONLY
      PRINT ~chriz-bg-magic: Faerie Fire added as %added_res% (CLERIC_CBMAGIC_FAERIE_FIRE) with projectile %proj_id%.~
    END
  END
  // Patch a new spell and an older already-added one by the AC penalty, not by effect order.
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_CBMAGIC_FAERIE_FIRE~ RET ff_res = resref ff_found = found END
  ACTION_IF ff_found BEGIN
    OUTER_SET faerie_fire_icon_ref = RESOLVE_STR_REF (@40082)
    LAF cbmagic_state_icon INT_VAR row = 128 STR_VAR resref = ~CBMIFAF~ END
    LAF cbmagic_statdesc_row INT_VAR desc_ref = faerie_fire_icon_ref STR_VAR bam = ~CBMIFAF~ RET faerie_fire_icon = icon_row END
    COPY_EXISTING ~%ff_res%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: Faerie Fire (%ff_res%) left as it is: %reason%.~
      END ELSE BEGIN
        READ_LONG 0x64 ab_off
        READ_SHORT 0x68 ab_cnt
        READ_LONG 0x6a fx_off
        FOR (a = 0; a < ab_cnt; ++a) BEGIN
          READ_SHORT (ab_off + a * 0x28 + 0x1e) n
          READ_SHORT (ab_off + a * 0x28 + 0x20) first
          SET has_penalty = 0
          SET has_icon = 0
          SET penalty_target = 2
          SET penalty_power = 1
          SET penalty_timing = 0
          SET penalty_dispel = 1
          SET penalty_duration = 24
          SET penalty_save = 1
          SET penalty_bonus = 0
          SET penalty_special = 0
          FOR (i = 0; i < n; ++i) BEGIN
            SET fx = fx_off + (first + i) * 0x30
            READ_SHORT fx op
            READ_SLONG (fx + 0x04) p1
            READ_LONG (fx + 0x08) p2
            PATCH_IF (op = 0) AND (p1 < 0) AND (p2 = 0) BEGIN
              SET has_penalty = 1
              READ_BYTE (fx + 0x02) penalty_target
              READ_BYTE (fx + 0x03) penalty_power
              READ_BYTE (fx + 0x0c) penalty_timing
              READ_BYTE (fx + 0x0d) penalty_dispel
              READ_LONG (fx + 0x0e) penalty_duration
              READ_LONG (fx + 0x24) penalty_save
              READ_SLONG (fx + 0x28) penalty_bonus
              READ_LONG (fx + 0x2c) penalty_special
            END
          END
          PATCH_IF has_penalty BEGIN
            FOR (i = 0; i < n; ++i) BEGIN
              SET fx = fx_off + (first + i) * 0x30
              READ_SHORT fx op
              READ_BYTE (fx + 0x02) tgt
              READ_LONG (fx + 0x08) p2
              READ_BYTE (fx + 0x0c) timing
              READ_BYTE (fx + 0x0d) dispel
              READ_LONG (fx + 0x0e) duration
              READ_LONG (fx + 0x24) save
              READ_SLONG (fx + 0x28) bonus
              PATCH_IF (op = 142) AND (tgt = penalty_target) AND (p2 = faerie_fire_icon)
                       AND (timing = penalty_timing) AND (duration = penalty_duration)
                       AND (save = penalty_save) AND (bonus = penalty_bonus) AND (dispel = penalty_dispel) BEGIN
                SET has_icon = 1
              END
            END
            PATCH_IF !has_icon BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 142 target = penalty_target power = penalty_power
                parameter2 = faerie_fire_icon timing = penalty_timing resist_dispel = penalty_dispel duration = penalty_duration
                savingthrow = penalty_save savebonus = penalty_bonus special = penalty_special END
            END
          END
        END
      END
    BUT_ONLY
  END
END

// --- Silence 15' Radius (row divine.silence) ------------------------------------------
// Affects enemies only (projectile SPARBLNP instead of all-creatures SPKLARBL).
DEFINE_ACTION_FUNCTION cbmagic_kept_silence
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_SILENCE_15_FOOT~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Silence 15' Radius (CLERIC_SILENCE_15_FOOT) is not in this game; left out.~
  END ELSE BEGIN
    OUTER_SET proj_id = IDS_OF_SYMBOL (~projectl~ ~sparblnp~)
    ACTION_IF (proj_id >= 0) BEGIN
      OUTER_SET proj_id += 1
    END ELSE BEGIN
      OUTER_SET proj_id = 169
    END
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: Silence 15' Radius (%spell%) left as it is: %reason%.~
      END ELSE BEGIN
        READ_LONG 0x64 ab_off
        READ_SHORT 0x68 ab_cnt
        PATCH_IF (ab_cnt < 1) BEGIN
          PATCH_WARN ~chriz-bg-magic: Silence 15' Radius (%spell%) left as it is: it has no abilities.~
        END ELSE BEGIN
          FOR (a = 0; a < ab_cnt; ++a) BEGIN
            READ_SHORT (ab_off + a * 0x28 + 0x26) proj
            PATCH_IF (proj != proj_id) BEGIN
              WRITE_SHORT (ab_off + a * 0x28 + 0x26) proj_id
              SET changed += 1
            END
          END
          PATCH_IF (changed > 0) BEGIN
            PATCH_PRINT ~chriz-bg-magic: Silence 15' Radius (%spell%): enemy-only projectile (%proj_id%) set in %changed% abilities.~
          END ELSE BEGIN
            PATCH_PRINT ~chriz-bg-magic: Silence 15' Radius (%spell%): uses enemy-only projectile (%proj_id%) already.~
          END
        END
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Silence 15' Radius~ END
      OUTER_SPRINT cbm_find @40050
      OUTER_SPRINT cbm_replace @40051
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%cbm_find%~ replace = EVAL ~%cbm_replace%~ label = ~Silence 15' Radius~ END
    END
  END
END

// --- Free Action (row divine.free_action) ---------------------------------------------
// Usable by druids and rangers as well as clerics, duration 1 turn/level (60s/level),
// adds Stun immunity, and no longer blocks Haste or movement bonuses.
DEFINE_ACTION_FUNCTION cbmagic_kept_free_action
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_FREE_ACTION~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Free Action (CLERIC_FREE_ACTION) is not in this game; left out.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: Free Action (%spell%) left as it is: %reason%.~
      END ELSE BEGIN
        READ_LONG 0x64 ab_off
        READ_SHORT 0x68 ab_cnt
        READ_LONG 0x6a fx_off
        SET has_fa = 0
        FOR (a = 0; a < ab_cnt; ++a) BEGIN
          READ_SHORT (ab_off + a * 0x28 + 0x1e) n
          READ_SHORT (ab_off + a * 0x28 + 0x20) first
          FOR (i = 0; i < n; ++i) BEGIN
            SET fx = fx_off + (first + i) * 0x30
            READ_SHORT fx op
            READ_LONG (fx + 0x08) p2
            PATCH_IF (op = 101) AND ((p2 = 109) OR (p2 = 154) OR (p2 = 157) OR (p2 = 175)) BEGIN
              SET has_fa = 1
            END
          END
        END
        PATCH_IF !has_fa BEGIN
          PATCH_WARN ~chriz-bg-magic: Free Action (%spell%) left as it is: no movement/hold immunity effects found.~
        END ELSE BEGIN
          READ_SHORT 0x20 p_excl
          SET new_excl = (p_excl BAND (BNOT 0xc000))
          PATCH_IF (new_excl != p_excl) BEGIN
            WRITE_SHORT 0x20 new_excl
            SET changed += 1
          END
          // Remove Haste-blocking effects across all abilities.
          SET scanning = 1
          WHILE scanning BEGIN
            SET scanning = 0
            READ_LONG 0x64 ab_off
            READ_SHORT 0x68 ab_cnt
            READ_LONG 0x6a fx_off
            FOR (a = 0; (a < ab_cnt) AND !scanning; ++a) BEGIN
              READ_SHORT (ab_off + a * 0x28 + 0x1e) n
              READ_SHORT (ab_off + a * 0x28 + 0x20) first
              FOR (i = 0; (i < n) AND !scanning; ++i) BEGIN
                SET fx = fx_off + (first + i) * 0x30
                READ_SHORT fx op
                READ_SLONG (fx + 0x04) p1
                READ_SLONG (fx + 0x08) p2
                READ_ASCII (fx + 0x14) res (8) NULL
                PATCH_IF ((op = 101) AND (p2 = 16))
                      OR ((op = 206) AND ((p2 = 16) OR (~%res%~ STRING_EQUAL_CASE ~SPWI305~)
                          OR (~%res%~ STRING_EQUAL_CASE ~SPRA301~) OR (~%res%~ STRING_EQUAL_CASE ~SPIN828~)
                          OR (~%res%~ STRING_EQUAL_CASE ~SPIN572~)))
                      OR ((op = 267) AND ((p1 = 14023) OR (p2 = 16)))
                      OR ((op = 169) AND (p2 = 38))
                      OR ((op = 240) AND (p2 = 38))
                      OR ((op = 126) AND (p1 = 100) AND (p2 = 2)) BEGIN
                  LPF cbmagic_delete_effect INT_VAR index = (first + i) END
                  SET changed += 1
                  SET scanning = 1
                END
              END
            END
          END
          // Update duration on the owned Free Action effects and ensure Stun immunities are present.
          READ_SHORT 0x68 ab_cnt
          FOR (a = 0; a < ab_cnt; ++a) BEGIN
            READ_LONG 0x64 ab_off
            READ_LONG 0x6a fx_off
            READ_SHORT (ab_off + a * 0x28 + 0x10) ml
            SET eff_lvl = (ml < 7) ? 7 : ml
            SET target_dur = 60 * eff_lvl
            READ_SHORT (ab_off + a * 0x28 + 0x1e) n
            READ_SHORT (ab_off + a * 0x28 + 0x20) first
            SET old_dur = 0 - 1
            FOR (i = 0; i < n; ++i) BEGIN
              SET fx = fx_off + (first + i) * 0x30
              READ_SHORT fx op
              READ_SLONG (fx + 0x08) p2
              READ_LONG (fx + 0x0e) dur
              PATCH_IF (op = 101) AND ((p2 = 109) OR (p2 = 154) OR (p2 = 157) OR (p2 = 175)) AND (old_dur < 0) BEGIN
                SET old_dur = dur
              END
            END
            SET has_45 = 0
            SET has_210 = 0
            SET has_169_55 = 0
            SET has_267_1280 = 0
            SET has_267_14043 = 0
            FOR (i = 0; i < n; ++i) BEGIN
              SET fx = fx_off + (first + i) * 0x30
              READ_SHORT fx op
              READ_SLONG (fx + 0x04) p1
              READ_SLONG (fx + 0x08) p2
              READ_BYTE (fx + 0x0c) timing
              READ_LONG (fx + 0x0e) dur
              PATCH_IF (old_dur > 0) AND (dur = old_dur) AND (dur != target_dur)
                    AND ((timing = 0) OR (timing = 4)) BEGIN
                WRITE_LONG (fx + 0x0e) target_dur
                SET changed += 1
              END
              PATCH_IF (op = 101) AND (p2 = 45) BEGIN SET has_45 = 1 END
              PATCH_IF (op = 101) AND (p2 = 210) BEGIN SET has_210 = 1 END
              PATCH_IF (op = 169) AND (p2 = 55) BEGIN SET has_169_55 = 1 END
              PATCH_IF (op = 267) AND (p1 = 1280) BEGIN SET has_267_1280 = 1 END
              PATCH_IF (op = 267) AND (p1 = 14043) BEGIN SET has_267_14043 = 1 END
            END
            PATCH_IF !has_45 BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 101 target = 2 power = 4
                parameter2 = 45 timing = 0 resist_dispel = 3 duration = target_dur END
              SET changed += 1
            END
            PATCH_IF !has_210 BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 101 target = 2 power = 4
                parameter2 = 210 timing = 0 resist_dispel = 3 duration = target_dur END
              SET changed += 1
            END
            PATCH_IF !has_169_55 BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 169 target = 2 power = 4
                parameter2 = 55 timing = 0 resist_dispel = 3 duration = target_dur END
              SET changed += 1
            END
            PATCH_IF !has_267_1280 BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 267 target = 2 power = 4
                parameter1 = 1280 timing = 0 resist_dispel = 3 duration = target_dur END
              SET changed += 1
            END
            PATCH_IF !has_267_14043 BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 267 target = 2 power = 4
                parameter1 = 14043 timing = 0 resist_dispel = 3 duration = target_dur END
              SET changed += 1
            END
          END
          PATCH_IF (changed > 0) BEGIN
            PATCH_PRINT ~chriz-bg-magic: Free Action (%spell%): druid/cleric usability, 1 turn/level, Stun protection added, Haste allowed.~
          END ELSE BEGIN
            PATCH_PRINT ~chriz-bg-magic: Free Action (%spell%): already updated.~
          END
        END
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Free Action~ END
      OUTER_SPRINT f1 @40034
      OUTER_SPRINT r1 @40035
      OUTER_SPRINT f2 @40036
      OUTER_SPRINT r2 @40037
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f1%~ replace = EVAL ~%r1%~ label = ~Free Action~ END
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%f2%~ replace = EVAL ~%r2%~ label = ~Free Action~ END
    END
  END
END

// --- Neutralize Poison (row divine.neutralize_poison) ---------------------------------
// Cures poison and grants immunity to poison for 1 turn/level (levels 7-20, 420-1200s);
// does not heal 10 HP or cure disease, blindness, or deafness.
DEFINE_ACTION_FUNCTION cbmagic_kept_neutralize_poison
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_NEUTRALIZE_POISON~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Neutralize Poison (CLERIC_NEUTRALIZE_POISON) is not in this game; left out.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: Neutralize Poison (%spell%) left as it is: %reason%.~
      END ELSE BEGIN
        READ_LONG 0x64 ab_off
        READ_SHORT 0x68 ab_cnt
        READ_LONG 0x6a fx_off
        PATCH_IF (ab_cnt < 1) BEGIN
          PATCH_WARN ~chriz-bg-magic: Neutralize Poison (%spell%) left as it is: it has no abilities.~
        END ELSE BEGIN
          SET has_11 = 0
          FOR (a = 0; a < ab_cnt; ++a) BEGIN
            READ_SHORT (ab_off + a * 0x28 + 0x1e) na
            READ_SHORT (ab_off + a * 0x28 + 0x20) fa
            FOR (i = 0; i < na; ++i) BEGIN
              SET fx = fx_off + (fa + i) * 0x30
              READ_SHORT fx op
              READ_ASCII (fx + 0x14) res (8) NULL
              // EE Fixpack moves the cure into a sub-spell of its own.
              PATCH_IF (op = 11) OR ((op = 146) AND (~%res%~ STRING_EQUAL_CASE ~#curepsn~)) BEGIN SET has_11 = 1 END
            END
          END
          PATCH_IF !has_11 BEGIN
            PATCH_WARN ~chriz-bg-magic: Neutralize Poison (%spell%) left as it is: no cure poison effect (opcode 11).~
          END ELSE BEGIN
            // Remove only the non-poison cure/heal effects that our design drops from Neutralize Poison,
            // preserving any unrelated effects in existing abilities.
            READ_SHORT 0x68 ab_cnt
            FOR (a = 0; a < ab_cnt; ++a) BEGIN
              SET scanning = 1
              WHILE scanning BEGIN
                SET scanning = 0
                READ_LONG 0x64 ab_off
                READ_LONG 0x6a fx_off
                READ_SHORT (ab_off + a * 0x28 + 0x1e) na
                READ_SHORT (ab_off + a * 0x28 + 0x20) fa
                FOR (i = 0; (i < na) AND !scanning; ++i) BEGIN
                  SET fx = fx_off + (fa + i) * 0x30
                  READ_SHORT fx op
                  READ_SLONG (fx + 0x08) p2
                  READ_ASCII (fx + 0x14) res (8) NULL
                  PATCH_IF (op = 17) OR (op = 79) OR (op = 75) OR (op = 81)
                        OR ((op = 240) AND ((p2 = 7) OR (p2 = 8) OR (p2 = 112)))
                        OR ((op = 146) AND ((~%res%~ STRING_EQUAL_CASE ~#curedis~) OR (~%res%~ STRING_EQUAL_CASE ~#curedef~) OR (~%res%~ STRING_EQUAL_CASE ~#curebld~)))
                        OR ((op = 321) AND !(~%res%~ STRING_EQUAL_CASE ~%spell%~)) BEGIN
                    LPF cbmagic_delete_effect INT_VAR index = (fa + i) END
                    SET changed += 1
                    SET scanning = 1
                  END
                END
              END
            END
            // Ensure breakpoints 1, 8..20 while preserving all existing abilities.
            LPF cbmagic_ensure_ability_min_level INT_VAR min_level = 1 RET ability_index ins = inserted END
            SET changed += ins
            FOR (lvl = 8; lvl <= 20; ++lvl) BEGIN
              LPF cbmagic_ensure_ability_min_level INT_VAR min_level = lvl RET ability_index ins = inserted END
              SET changed += ins
            END
            // Ensure self-refresh (321) and 1 turn/level poison-immunity effects in every ability.
            READ_SHORT 0x68 ab_cnt
            FOR (a = 0; a < ab_cnt; ++a) BEGIN
              READ_LONG 0x64 ab_off
              READ_LONG 0x6a fx_off
              READ_SHORT (ab_off + a * 0x28 + 0x10) ml
              SET eff_lvl = (ml < 7) ? 7 : ((ml > 20) ? 20 : ml)
              SET target_dur = 60 * eff_lvl
              READ_SHORT (ab_off + a * 0x28 + 0x1e) na
              READ_SHORT (ab_off + a * 0x28 + 0x20) fa
              SET has_self_321 = 0
              SET has_101_25 = 0
              SET has_173 = 0
              SET has_169_6 = 0
              SET has_267_14662 = 0
              SET has_142_30 = 0
              SET has_174_e07 = 0
              SET has_206_411 = 0
              SET has_206_502 = 0
              SET has_206_979 = 0
              FOR (i = 0; i < na; ++i) BEGIN
                SET fx = fx_off + (fa + i) * 0x30
                READ_SHORT fx op
                READ_SLONG (fx + 0x04) p1
                READ_SLONG (fx + 0x08) p2
                READ_BYTE (fx + 0x0c) tm
                READ_LONG (fx + 0x0e) dur
                READ_ASCII (fx + 0x14) res (8) NULL
                PATCH_IF (op = 321) AND (~%res%~ STRING_EQUAL_CASE ~%spell%~) BEGIN
                  SET has_self_321 = 1
                END
                PATCH_IF (op = 101) AND (p2 = 25) BEGIN
                  SET has_101_25 = 1
                  PATCH_IF (dur != target_dur) BEGIN WRITE_LONG (fx + 0x0e) target_dur SET changed += 1 END
                END
                PATCH_IF (op = 173) AND (p1 = 100) AND (p2 = 1) BEGIN
                  SET has_173 = 1
                  PATCH_IF (dur != target_dur) BEGIN WRITE_LONG (fx + 0x0e) target_dur SET changed += 1 END
                END
                PATCH_IF (op = 169) AND (p2 = 6) BEGIN
                  SET has_169_6 = 1
                  PATCH_IF (dur != target_dur) BEGIN WRITE_LONG (fx + 0x0e) target_dur SET changed += 1 END
                END
                PATCH_IF (op = 267) AND (p1 = 14662) BEGIN
                  SET has_267_14662 = 1
                  PATCH_IF (dur != target_dur) BEGIN WRITE_LONG (fx + 0x0e) target_dur SET changed += 1 END
                END
                PATCH_IF (op = 142) AND (p2 = 30) BEGIN
                  SET has_142_30 = 1
                  PATCH_IF (dur != target_dur) BEGIN WRITE_LONG (fx + 0x0e) target_dur SET changed += 1 END
                END
                PATCH_IF (op = 174) AND (tm = 4) AND (~%res%~ STRING_EQUAL_CASE ~EFF_E07~) BEGIN
                  SET has_174_e07 = 1
                  PATCH_IF (dur != target_dur) BEGIN WRITE_LONG (fx + 0x0e) target_dur SET changed += 1 END
                END
                PATCH_IF (op = 206) AND (~%res%~ STRING_EQUAL_CASE ~SPPR411~) BEGIN
                  SET has_206_411 = 1
                  PATCH_IF (dur != target_dur) BEGIN WRITE_LONG (fx + 0x0e) target_dur SET changed += 1 END
                END
                PATCH_IF (op = 206) AND (~%res%~ STRING_EQUAL_CASE ~SPWI502~) BEGIN
                  SET has_206_502 = 1
                  PATCH_IF (dur != target_dur) BEGIN WRITE_LONG (fx + 0x0e) target_dur SET changed += 1 END
                END
                PATCH_IF (op = 206) AND (~%res%~ STRING_EQUAL_CASE ~SPIN979~) BEGIN
                  SET has_206_979 = 1
                  PATCH_IF (dur != target_dur) BEGIN WRITE_LONG (fx + 0x0e) target_dur SET changed += 1 END
                END
              END
              PATCH_IF !has_self_321 BEGIN
                LPF cbmagic_insert_effect INT_VAR ability = a position = 0 opcode = 321 target = 2 power = 4
                  timing = 1 resist_dispel = 3 STR_VAR resource = EVAL ~%spell%~ END
                SET changed += 1
              END
              PATCH_IF !has_101_25 BEGIN
                LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 101 target = 2 power = 4
                  parameter2 = 25 timing = 0 resist_dispel = 3 duration = target_dur END
                SET changed += 1
              END
              PATCH_IF !has_173 BEGIN
                LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 173 target = 2 power = 4
                  parameter1 = 100 parameter2 = 1 timing = 0 resist_dispel = 3 duration = target_dur END
                SET changed += 1
              END
              PATCH_IF !has_169_6 BEGIN
                LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 169 target = 2 power = 4
                  parameter2 = 6 timing = 0 resist_dispel = 3 duration = target_dur END
                SET changed += 1
              END
              PATCH_IF !has_267_14662 BEGIN
                LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 267 target = 2 power = 4
                  parameter1 = 14662 timing = 0 resist_dispel = 3 duration = target_dur END
                SET changed += 1
              END
              PATCH_IF !has_142_30 BEGIN
                LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 142 target = 2 power = 4
                  parameter2 = 30 timing = 0 resist_dispel = 3 duration = target_dur END
                SET changed += 1
              END
              PATCH_IF !has_174_e07 BEGIN
                LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 174 target = 2 power = 4
                  timing = 4 resist_dispel = 3 duration = target_dur STR_VAR resource = ~EFF_E07~ END
                SET changed += 1
              END
              PATCH_IF !has_206_411 BEGIN
                LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 206 target = 2 power = 4
                  timing = 0 resist_dispel = 3 duration = target_dur STR_VAR resource = ~SPPR411~ END
                SET changed += 1
              END
              PATCH_IF !has_206_502 BEGIN
                LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 206 target = 2 power = 4
                  timing = 0 resist_dispel = 3 duration = target_dur STR_VAR resource = ~SPWI502~ END
                SET changed += 1
              END
              PATCH_IF !has_206_979 BEGIN
                LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 206 target = 2 power = 4
                  timing = 0 resist_dispel = 3 duration = target_dur STR_VAR resource = ~SPIN979~ END
                SET changed += 1
              END
            END
            PATCH_IF (changed > 0) BEGIN
              PATCH_PRINT ~chriz-bg-magic: Neutralize Poison (%spell%): cures poison and grants immunity for 1 turn/level.~
            END ELSE BEGIN
              PATCH_PRINT ~chriz-bg-magic: Neutralize Poison (%spell%): poison cure and 1 turn/level immunity present already.~
            END
          END
        END
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Neutralize Poison~ END
      OUTER_SPRINT f1 @40040
      OUTER_SPRINT r1 @40035
      OUTER_SPRINT f2 @40041
      OUTER_SPRINT r2 @40042
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f1%~ replace = EVAL ~%r1%~ label = ~Neutralize Poison~ END
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%f2%~ replace = EVAL ~%r2%~ label = ~Neutralize Poison~ END
    END
  END
END

// --- Divine Power / Holy Power (row divine.divine_power) ------------------------------
// Renamed Divine Power in name and description, casting time 4 (from 6), and grants
// single/multi-class non-fighter clerics (CLASS.IDS 3, 15, 14) fighter bonus attacks per
// round (+1/2 APR at levels 7-12 via CBM412A.EFF, +1 APR at level 13+ via CBM412B.EFF).
DEFINE_ACTION_FUNCTION cbmagic_kept_divine_power
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_HOLY_POWER~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Holy Power (CLERIC_HOLY_POWER) is not in this game; left out.~
  END ELSE BEGIN
    LAF cbmagic_game_language RET lang END
    OUTER_SET new_name_ref = RESOLVE_STR_REF (@40070)
    OUTER_SET divine_power_icon_ref = RESOLVE_STR_REF (@40081)
    LAF cbmagic_state_icon INT_VAR row = 60 STR_VAR resref = ~CBMIDVP~ END
    LAF cbmagic_statdesc_row INT_VAR desc_ref = divine_power_icon_ref STR_VAR bam = ~CBMIDVP~ RET divine_power_icon = icon_row END
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: Holy Power (%spell%) left as it is: %reason%.~
      END ELSE BEGIN
        READ_LONG 0x64 ab_off
        READ_SHORT 0x68 ab_cnt
        READ_LONG 0x6a fx_off
        SET has_hp = 0
        FOR (a = 0; a < ab_cnt; ++a) BEGIN
          READ_SHORT (ab_off + a * 0x28 + 0x1e) n
          READ_SHORT (ab_off + a * 0x28 + 0x20) first
          FOR (i = 0; i < n; ++i) BEGIN
            SET fx = fx_off + (first + i) * 0x30
            READ_SHORT fx op
            PATCH_IF (op = 54) OR (op = 44) OR (op = 18) BEGIN SET has_hp = 1 END
          END
        END
        PATCH_IF !has_hp BEGIN
          PATCH_WARN ~chriz-bg-magic: Holy Power (%spell%) left as it is: no Holy Power effects found.~
        END ELSE BEGIN
          PATCH_IF (~%lang%~ STRING_EQUAL ~en_us~) BEGIN
            READ_SLONG 0x08 cur_name
            PATCH_IF (cur_name != new_name_ref) BEGIN
              WRITE_LONG 0x08 new_name_ref
              SET changed += 1
            END
          END
          FOR (a = 0; a < ab_cnt; ++a) BEGIN
            READ_LONG 0x64 ab_off
            READ_LONG 0x6a fx_off
            READ_SHORT (ab_off + a * 0x28 + 0x10) ml
            READ_SHORT (ab_off + a * 0x28 + 0x12) ct
            PATCH_IF (ct != 4) BEGIN
              WRITE_SHORT (ab_off + a * 0x28 + 0x12) 4
              SET changed += 1
            END
            READ_SHORT (ab_off + a * 0x28 + 0x1e) n
            READ_SHORT (ab_off + a * 0x28 + 0x20) first
            SET eff_lvl = (ml < 7) ? 7 : ml
            SET ab_dur = 6 * eff_lvl
            SPRINT eff_res ~CBM412A~
            PATCH_IF (ml >= 13) BEGIN
              SPRINT eff_res ~CBM412B~
            END
            SET has_c3 = 0
            SET has_c15 = 0
            SET has_c14 = 0
            FOR (i = 0; i < n; ++i) BEGIN
              SET fx = fx_off + (first + i) * 0x30
              READ_SHORT fx op
              READ_SLONG (fx + 0x04) p1
              READ_SLONG (fx + 0x08) p2
              READ_BYTE (fx + 0x0d) rd
              READ_LONG (fx + 0x0e) dur
              READ_ASCII (fx + 0x14) res (8) NULL
              PATCH_IF ((op = 54) OR (op = 44) OR (op = 142)) AND (dur > 0) BEGIN
                SET ab_dur = dur
              END
              PATCH_IF (op = 142) AND (p2 = 60) BEGIN
                WRITE_LONG (fx + 0x08) divine_power_icon
                SET changed += 1
              END
              PATCH_IF (op = 177) AND (p2 = 5) AND (~%res%~ STRING_EQUAL_CASE ~%eff_res%~) BEGIN
                PATCH_IF (rd != 3) BEGIN
                  WRITE_BYTE (fx + 0x0d) 3
                  SET changed += 1
                END
                PATCH_IF (p1 = 3) BEGIN SET has_c3 = 1 END
                PATCH_IF (p1 = 15) BEGIN SET has_c15 = 1 END
                PATCH_IF (p1 = 14) BEGIN SET has_c14 = 1 END
              END
            END
            PATCH_IF !has_c3 BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 177 target = 1 power = 4
                parameter1 = 3 parameter2 = 5 timing = 0 resist_dispel = 3 duration = ab_dur
                STR_VAR resource = EVAL ~%eff_res%~ END
              SET changed += 1
            END
            PATCH_IF !has_c15 BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 177 target = 1 power = 4
                parameter1 = 15 parameter2 = 5 timing = 0 resist_dispel = 3 duration = ab_dur
                STR_VAR resource = EVAL ~%eff_res%~ END
              SET changed += 1
            END
            PATCH_IF !has_c14 BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 177 target = 1 power = 4
                parameter1 = 14 parameter2 = 5 timing = 0 resist_dispel = 3 duration = ab_dur
                STR_VAR resource = EVAL ~%eff_res%~ END
              SET changed += 1
            END
          END
          PATCH_IF (changed > 0) BEGIN
            PATCH_PRINT ~chriz-bg-magic: Holy Power (%spell%): renamed Divine Power, casting time 4, and fighter APR progression added.~
          END ELSE BEGIN
            PATCH_PRINT ~chriz-bg-magic: Holy Power (%spell%): Divine Power name, casting time 4, and fighter APR progression present already.~
          END
        END
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      ACTION_FOR_EACH pair IN ~CBM412A:6~ ~CBM412B:1~ BEGIN
        OUTER_PATCH_SAVE eff_name ~%pair%~ BEGIN REPLACE_TEXTUALLY ~:.*$~ ~~ END
        OUTER_PATCH_SAVE apr_val ~%pair%~ BEGIN REPLACE_TEXTUALLY ~^.*:~ ~~ END
        COPY ~chriz-bg-magic/lib/cbmagic_shared.tpa~ ~override/%eff_name%.eff~
          DELETE_BYTES 0 BUFFER_LENGTH
          INSERT_BYTES 0 0x110
          WRITE_ASCII 0 ~EFF V2.0~ (8)
          WRITE_ASCII 0x08 ~EFF V2.0~ (8)
          WRITE_LONG 0x10 1
          WRITE_LONG 0x14 1
          WRITE_LONG 0x18 4
          WRITE_LONG 0x1c apr_val
          WRITE_LONG 0x20 0
          WRITE_SHORT 0x24 0
          WRITE_LONG 0x28 120
          WRITE_SHORT 0x2c 100
      END
      LAF cbmagic_warn_text_language STR_VAR label = ~Divine Power~ END
      OUTER_SPRINT f0 @40071
      OUTER_SPRINT r0 @40070
      OUTER_SPRINT f1 @40026
      OUTER_SPRINT r1 @40027
      OUTER_SPRINT f2 @40028
      OUTER_SPRINT r2 @40029
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f0%~ replace = EVAL ~%r0%~ label = ~Divine Power~ END
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f1%~ replace = EVAL ~%r1%~ label = ~Divine Power~ END
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%f2%~ replace = EVAL ~%r2%~ label = ~Divine Power~ END
    END
  END
END

// --- Negative Plane Protection (row divine.negative_plane_protection) -----------------
// Duration 1 turn/level (60s/level across abilities at min_level 1, 8..20 for caster
// levels 7..20, 420..1200s), usable by both clerics and druids, otherwise vanilla.
DEFINE_ACTION_FUNCTION cbmagic_kept_negative_plane_protection
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_NEGATIVE_PLANE_PROTECTION~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Negative Plane Protection (CLERIC_NEGATIVE_PLANE_PROTECTION) is not in this game; left out.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: Negative Plane Protection (%spell%) left as it is: %reason%.~
      END ELSE BEGIN
        READ_LONG 0x64 ab_off
        READ_SHORT 0x68 ab_cnt
        READ_LONG 0x6a fx_off
        PATCH_IF (ab_cnt < 1) BEGIN
          PATCH_WARN ~chriz-bg-magic: Negative Plane Protection (%spell%) left as it is: it has no abilities.~
        END ELSE BEGIN
          SET has_216 = 0
          FOR (a = 0; a < ab_cnt; ++a) BEGIN
            READ_SHORT (ab_off + a * 0x28 + 0x1e) na
            READ_SHORT (ab_off + a * 0x28 + 0x20) fa
            FOR (i = 0; i < na; ++i) BEGIN
              SET fx = fx_off + (fa + i) * 0x30
              READ_SHORT fx op
              READ_SLONG (fx + 0x08) p2
              PATCH_IF (op = 101) AND (p2 = 216) BEGIN SET has_216 = 1 END
            END
          END
          PATCH_IF !has_216 BEGIN
            PATCH_WARN ~chriz-bg-magic: Negative Plane Protection (%spell%) left as it is: no level-drain immunity (opcode 101 p2=216).~
          END ELSE BEGIN
            READ_SHORT 0x20 p_excl
            PATCH_IF ((p_excl BAND 0xc000) != 0) BEGIN
              WRITE_SHORT 0x20 (p_excl BAND 0x3fff)
              SET changed += 1
            END
            // Ensure breakpoints 1, 8..20 while preserving all existing abilities.
            LPF cbmagic_ensure_ability_min_level INT_VAR min_level = 1 RET ability_index ins = inserted END
            SET changed += ins
            FOR (lvl = 8; lvl <= 20; ++lvl) BEGIN
              LPF cbmagic_ensure_ability_min_level INT_VAR min_level = lvl RET ability_index ins = inserted END
              SET changed += ins
            END
            READ_LONG 0x64 ab_off
            READ_SHORT 0x68 ab_cnt
            READ_LONG 0x6a fx_off
            FOR (a = 0; a < ab_cnt; ++a) BEGIN
              READ_SHORT (ab_off + a * 0x28 + 0x10) ml
              SET eff_lvl = (ml < 7) ? 7 : ((ml > 20) ? 20 : ml)
              SET target_dur = 60 * eff_lvl
              READ_SHORT (ab_off + a * 0x28 + 0x1e) na
              READ_SHORT (ab_off + a * 0x28 + 0x20) fa
              SET old_dur = 0 - 1
              FOR (i = 0; i < na; ++i) BEGIN
                SET fx = fx_off + (fa + i) * 0x30
                READ_SHORT fx op
                READ_SLONG (fx + 0x08) p2
                READ_LONG (fx + 0x0e) dur
                PATCH_IF (op = 101) AND (p2 = 216) AND (old_dur < 0) BEGIN
                  SET old_dur = dur
                END
              END
              PATCH_IF (old_dur > 0) AND (old_dur != target_dur) BEGIN
                FOR (i = 0; i < na; ++i) BEGIN
                  SET fx = fx_off + (fa + i) * 0x30
                  READ_SHORT fx op
                  READ_BYTE (fx + 0x0c) tm
                  READ_LONG (fx + 0x0e) dur
                  PATCH_IF (dur = old_dur) AND (
                    (((op = 101) OR (op = 267) OR (op = 142) OR (op = 169)) AND (tm = 0))
                    OR ((op = 174) AND (tm = 4))
                  ) BEGIN
                    WRITE_LONG (fx + 0x0e) target_dur
                    SET changed += 1
                  END
                END
              END
            END
            PATCH_IF (changed > 0) BEGIN
              PATCH_PRINT ~chriz-bg-magic: Negative Plane Protection (%spell%): duration set to 1 turn/level (levels 7-20) for clerics and druids.~
            END ELSE BEGIN
              PATCH_PRINT ~chriz-bg-magic: Negative Plane Protection (%spell%): 1 turn/level duration and cleric/druid usability present already.~
            END
          END
        END
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Negative Plane Protection~ END
      OUTER_SPRINT cbm_find @40074
      OUTER_SPRINT cbm_replace @40035
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%cbm_find%~ replace = EVAL ~%cbm_replace%~ label = ~Negative Plane Protection~ END
    END
  END
END

// --- Iron Skins -> Stoneskin (row divine.stoneskin) -----------------------------------
// Named Stoneskin, casting time 1 (from 9), skins and duration as vanilla.
DEFINE_ACTION_FUNCTION cbmagic_kept_iron_skins
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_IRONSKIN~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Iron Skins (CLERIC_IRONSKIN) is not in this game; left out.~
  END ELSE BEGIN
    LAF cbmagic_game_language RET lang END
    OUTER_SET new_name_ref = RESOLVE_STR_REF (@40052)
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: Iron Skins (%spell%) left as it is: %reason%.~
      END ELSE BEGIN
        READ_LONG 0x64 ab_off
        READ_SHORT 0x68 ab_cnt
        READ_LONG 0x6a fx_off
        SET has_218 = 0
        FOR (a = 0; a < ab_cnt; ++a) BEGIN
          READ_SHORT (ab_off + a * 0x28 + 0x1e) n
          READ_SHORT (ab_off + a * 0x28 + 0x20) first
          FOR (i = 0; i < n; ++i) BEGIN
            SET fx = fx_off + (first + i) * 0x30
            READ_SHORT fx op
            PATCH_IF (op = 218) BEGIN SET has_218 = 1 END
          END
        END
        PATCH_IF !has_218 BEGIN
          PATCH_WARN ~chriz-bg-magic: Iron Skins (%spell%) left as it is: no stoneskin effect (opcode 218).~
        END ELSE BEGIN
          FOR (a = 0; a < ab_cnt; ++a) BEGIN
            READ_SHORT (ab_off + a * 0x28 + 0x12) ct
            PATCH_IF (ct != 1) BEGIN
              WRITE_SHORT (ab_off + a * 0x28 + 0x12) 1
              SET changed += 1
            END
          END
          PATCH_IF (~%lang%~ STRING_EQUAL ~en_us~) BEGIN
            READ_SLONG 0x08 cur_name
            PATCH_IF (cur_name != new_name_ref) BEGIN
              WRITE_LONG 0x08 new_name_ref
              SET changed += 1
            END
          END
          PATCH_IF (changed > 0) BEGIN
            PATCH_PRINT ~chriz-bg-magic: Iron Skins (%spell%): renamed Stoneskin and casting time set to 1.~
          END ELSE BEGIN
            PATCH_PRINT ~chriz-bg-magic: Iron Skins (%spell%): Stoneskin name and casting time 1 present already.~
          END
        END
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Iron Skins~ END
      OUTER_SPRINT f1 @40053
      OUTER_SPRINT r1 @40052
      OUTER_SPRINT f2 @40004
      OUTER_SPRINT r2 @40005
      OUTER_SPRINT f3 @40054
      OUTER_SPRINT r3 @40055
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f1%~ replace = EVAL ~%r1%~ label = ~Iron Skins~ END
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f2%~ replace = EVAL ~%r2%~ label = ~Iron Skins~ END
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%f3%~ replace = EVAL ~%r3%~ label = ~Iron Skins~ END
    END
  END
END

// --- Mass Regenerate (row divine.mass_regenerate) -------------------------------------
// New level-5 druid-only spell added via ADD_SPELL (symbol CLERIC_CBMAGIC_MASS_REGENERATE).
// Sight-range party-only area (cbmmreg.pro via ADD_PROJECTILE, radius 452), casting time 5,
// regenerates 2 HP per round (1 HP per 3 seconds) for 1 turn + 2 rounds/level (72s at
// level 1 up to 180s at level 10), not stackable with itself.
// Uses existing base-game Regeneration icons: SPPR711C (spellbook) and SPPR711B (ability bar).
DEFINE_ACTION_FUNCTION cbmagic_kept_mass_regenerate
BEGIN
  LAF cbmagic_find_added_priest_spell INT_VAR level = 5
    STR_VAR symbol = ~CLERIC_CBMAGIC_MASS_REGENERATE~ marker = ~SPPR711C~
    RET found_res
  END
  ACTION_IF !(~%found_res%~ STRING_EQUAL ~~) BEGIN
    PRINT ~chriz-bg-magic: Mass Regenerate (%found_res%) is in this game already.~
  END ELSE BEGIN
    LAF cbmagic_warn_text_language STR_VAR label = ~Mass Regenerate~ END
    OUTER_SET proj_id = IDS_OF_SYMBOL (~projectl~ ~cbmmreg~)
    ACTION_IF (proj_id >= 0) BEGIN
      OUTER_SET proj_id += 1
    END ELSE BEGIN
      OUTER_SET can_add_proj = 0
      ACTION_IF (FILE_EXISTS_IN_GAME ~projectl.ids~) BEGIN
        COPY_EXISTING - ~projectl.ids~ ~override~
          PATCH_IF (INDEX_BUFFER (~[0-9]~ 8) >= 0) BEGIN
            SET can_add_proj = 1
          END
      END
      ACTION_IF can_add_proj BEGIN
        COPY ~chriz-bg-magic/lib/cbmagic_shared.tpa~ ~weidu_external/cbmmreg.pro~
          DELETE_BYTES 0 BUFFER_LENGTH
          INSERT_BYTES 0 0x300
          WRITE_ASCII 0 ~PRO V1.0~ (8)
          WRITE_SHORT 0x08 3
          WRITE_SHORT 0x0a 20
          WRITE_LONG 0x0c 3
          WRITE_ASCII 0x10 ~TRA_04A~ (8)
          WRITE_ASCII 0x18 ~CAS_M08~ (8)
          WRITE_SHORT 0x28 2
          WRITE_SHORT 0x100 0x80
          WRITE_ASCII 0x104 ~TRAVEL~ (8)
          WRITE_ASCII 0x11c ~STTRAVL1~ (8)
          WRITE_SHORT 0x132 256
          WRITE_SHORT 0x200 0xd0
          WRITE_SHORT 0x202 0
          WRITE_SHORT 0x204 452
          WRITE_SHORT 0x206 452
          WRITE_SHORT 0x210 100
          WRITE_SHORT 0x214 196
          WRITE_BYTE 0x216 1
          WRITE_BYTE 0x217 255
          WRITE_BYTE 0x218 67
          WRITE_SHORT 0x21a 47
        ADD_PROJECTILE ~weidu_external/cbmmreg.pro~
        OUTER_SET proj_id = cbmmreg
      END ELSE BEGIN
        OUTER_SET proj_id = 337
      END
    END
    OUTER_SET name_ref = RESOLVE_STR_REF (@40038)
    OUTER_SET desc_ref = RESOLVE_STR_REF (@40039)
    COPY - ~chriz-bg-magic/lib/cbmagic_shared.tpa~ ~weidu_external/cbmmreg.spl~
      DELETE_BYTES 0 BUFFER_LENGTH
      INSERT_BYTES 0 (0x72 + 0x28)
      WRITE_ASCII 0 ~SPL V1  ~ (8)
      WRITE_LONG 0x08 name_ref
      WRITE_LONG 0x0c (0 - 1)
      WRITE_LONG 0x18 0
      WRITE_SHORT 0x1c 2
      WRITE_SHORT 0x20 0x4000
      WRITE_ASCII 0x10 ~CAS_P07~ #8
      WRITE_SHORT 0x22 9
      WRITE_BYTE 0x25 8
      WRITE_BYTE 0x27 0
      WRITE_LONG 0x34 5
      WRITE_ASCII 0x3a ~SPPR711C~ (8)
      WRITE_LONG 0x50 desc_ref
      WRITE_LONG 0x54 (0 - 1)
      WRITE_LONG 0x64 0x72
      WRITE_SHORT 0x68 1
      WRITE_LONG 0x6a (0x72 + 0x28)
      WRITE_SHORT 0x6e 0
      WRITE_SHORT 0x70 0
      WRITE_BYTE 0x72 1
      WRITE_SHORT (0x72 + 0x02) 2
      WRITE_ASCII (0x72 + 0x04) ~SPPR711B~ (8)
      WRITE_BYTE (0x72 + 0x0c) 5
      WRITE_SHORT (0x72 + 0x0e) 1
      WRITE_SHORT (0x72 + 0x10) 1
      WRITE_SHORT (0x72 + 0x12) 5
      WRITE_SHORT (0x72 + 0x14) 1
      WRITE_SHORT (0x72 + 0x1e) 0
      WRITE_SHORT (0x72 + 0x20) 0
      WRITE_SHORT (0x72 + 0x22) 1
      WRITE_SHORT (0x72 + 0x26) proj_id
      LPF cbmagic_insert_effect INT_VAR ability = 0 position = 999 opcode = 321 target = 2 power = 5
        timing = 1 resist_dispel = 3 duration = 0 STR_VAR resource = ~CBMMREG~ END
      LPF cbmagic_insert_effect INT_VAR ability = 0 position = 999 opcode = 98 target = 2 power = 5
        parameter1 = 3 parameter2 = 3 timing = 0 resist_dispel = 3 duration = 72 END
      LPF cbmagic_insert_effect INT_VAR ability = 0 position = 999 opcode = 142 target = 2 power = 5
        parameter2 = 87 timing = 0 resist_dispel = 3 duration = 72 END
      LPF cbmagic_insert_effect INT_VAR ability = 0 position = 999 opcode = 139 target = 2 power = 5
        parameter1 = 11006 timing = 1 resist_dispel = 3 duration = 0 END
      LPF cbmagic_insert_effect INT_VAR ability = 0 position = 999 opcode = 174 target = 2 power = 5
        timing = 4 resist_dispel = 3 duration = 72 STR_VAR resource = ~EFF_E03~ END
      LPF cbmagic_insert_effect INT_VAR ability = 0 position = 999 opcode = 215 target = 2 power = 5
        parameter2 = 1 timing = 0 resist_dispel = 3 duration = 3 STR_VAR resource = ~ICWRATI~ END
      FOR (lvl = 2; lvl <= 10; ++lvl) BEGIN
        SET dur = 60 + lvl * 12
        LPF cbmagic_clone_first_ability INT_VAR min_level = lvl base_dur = 72 new_dur = dur RET new_ability END
      END
    COPY - ~weidu_external/cbmmreg.spl~ ~weidu_external/cbmmreg.spl~
    ADD_SPELL ~weidu_external/cbmmreg.spl~ 1 5 ~CLERIC_CBMAGIC_MASS_REGENERATE~
    LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_CBMAGIC_MASS_REGENERATE~ RET added_res = resref found END
    ACTION_IF found BEGIN
      COPY_EXISTING ~%added_res%.spl~ ~override~
        READ_LONG 0x64 ab_off
        READ_SHORT 0x68 ab_cnt
        READ_LONG 0x6a fx_off
        FOR (a = 0; a < ab_cnt; ++a) BEGIN
          READ_SHORT (ab_off + a * 0x28 + 0x1e) na
          READ_SHORT (ab_off + a * 0x28 + 0x20) fa
          FOR (i = 0; i < na; ++i) BEGIN
            SET fx = fx_off + (fa + i) * 0x30
            READ_SHORT fx op
            PATCH_IF (op = 321) BEGIN
              WRITE_ASCIIE (fx + 0x14) ~%added_res%~ #8
            END
          END
        END
      BUT_ONLY
      PRINT ~chriz-bg-magic: Mass Regenerate added as %added_res% (CLERIC_CBMAGIC_MASS_REGENERATE) with projectile %proj_id%.~
    END
  END
END

// --- Regenerate (row divine.regeneration) ---------------------------------------------
// Druid-only (0x20), stays level 7, heals 2 HP per second (from 3) for 1 round per level
// (from 1 round per 2 levels), not stackable with itself (opcode 321 self-refresh).
DEFINE_ACTION_FUNCTION cbmagic_kept_regeneration
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_REGENERATE~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Regenerate (CLERIC_REGENERATE) is not in this game; left out.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: Regenerate (%spell%) left as it is: %reason%.~
      END ELSE BEGIN
        READ_LONG 0x64 ab_off
        READ_SHORT 0x68 ab_cnt
        READ_LONG 0x6a fx_off
        SET has_98 = 0
        FOR (a = 0; a < ab_cnt; ++a) BEGIN
          READ_SHORT (ab_off + a * 0x28 + 0x1e) n
          READ_SHORT (ab_off + a * 0x28 + 0x20) first
          FOR (i = 0; i < n; ++i) BEGIN
            SET fx = fx_off + (first + i) * 0x30
            READ_SHORT fx op
            PATCH_IF (op = 98) BEGIN SET has_98 = 1 END
          END
        END
        PATCH_IF !has_98 BEGIN
          PATCH_WARN ~chriz-bg-magic: Regenerate (%spell%) left as it is: no regeneration effect (opcode 98).~
        END ELSE BEGIN
          READ_SHORT 0x20 p_excl
          SET target_excl = ((p_excl BAND (BNOT 0xc000)) BOR 0x4000)
          PATCH_IF (p_excl != target_excl) BEGIN
            WRITE_SHORT 0x20 target_excl
            SET changed += 1
          END
          LPF cbmagic_add_self_refresh RET ref_added = added ref_present = present misplaced END
          SET changed += ref_added
          READ_LONG 0x64 ab_off
          READ_SHORT 0x68 ab_cnt
          READ_LONG 0x6a fx_off
          FOR (a = 0; a < ab_cnt; ++a) BEGIN
            READ_SHORT (ab_off + a * 0x28 + 0x10) ml
            SET eff_lvl = (ml < 14) ? 14 : ml
            SET target_dur = 6 * eff_lvl
            READ_SHORT (ab_off + a * 0x28 + 0x1e) n
            READ_SHORT (ab_off + a * 0x28 + 0x20) first
            SET old_dur = 0 - 1
            FOR (i = 0; i < n; ++i) BEGIN
              SET fx = fx_off + (first + i) * 0x30
              READ_SHORT fx op
              READ_SLONG (fx + 0x04) p1
              READ_LONG (fx + 0x0e) dur
              PATCH_IF (op = 98) BEGIN
                SET old_dur = dur
                PATCH_IF (p1 != 2) BEGIN
                  WRITE_LONG (fx + 0x04) 2
                  SET changed += 1
                END
              END
            END
            PATCH_IF (old_dur > 0) AND (old_dur != target_dur) BEGIN
              FOR (i = 0; i < n; ++i) BEGIN
                SET fx = fx_off + (first + i) * 0x30
                READ_LONG (fx + 0x0e) dur
                PATCH_IF (dur = old_dur) BEGIN
                  WRITE_LONG (fx + 0x0e) target_dur
                  SET changed += 1
                END
              END
            END
          END
          PATCH_IF (changed > 0) BEGIN
            PATCH_PRINT ~chriz-bg-magic: Regenerate (%spell%): druid-only, 2 HP/s, 1 round/level, self-refreshing.~
          END ELSE BEGIN
            PATCH_PRINT ~chriz-bg-magic: Regenerate (%spell%): druid-only, 2 HP/s, 1 round/level, self-refreshing already.~
          END
        END
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Regenerate~ END
      OUTER_SPRINT f1 @40056
      OUTER_SPRINT r1 @40057
      OUTER_SPRINT f2 @40058
      OUTER_SPRINT r2 @40059
      OUTER_SPRINT f3 @40060
      OUTER_SPRINT r3 @40061
      OUTER_SPRINT f4 @40062
      OUTER_SPRINT r4 @40063
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f1%~ replace = EVAL ~%r1%~ label = ~Regenerate~ END
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f2%~ replace = EVAL ~%r2%~ label = ~Regenerate~ END
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f3%~ replace = EVAL ~%r3%~ label = ~Regenerate~ END
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%f4%~ replace = EVAL ~%r4%~ label = ~Regenerate~ END
    END
  END
END

// --- Greater Restoration (row divine.greater_restoration) -----------------------------
// Keeps vanilla cures, casting time (3), and caster fatigue drawback, and adds cures for
// Hold, Stun, Sleep, Petrification (opcode 43 placed before opcode 17 heal), Polymorph,
// curses, Blindness, and Deafness.
DEFINE_ACTION_FUNCTION cbmagic_kept_greater_restoration
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_RESTORATION~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Greater Restoration (CLERIC_RESTORATION) is not in this game; left out.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: Greater Restoration (%spell%) left as it is: %reason%.~
      END ELSE BEGIN
        READ_LONG 0x64 ab_off
        READ_SHORT 0x68 ab_cnt
        READ_LONG 0x6a fx_off
        SET has_rest = 0
        FOR (a = 0; a < ab_cnt; ++a) BEGIN
          READ_SHORT (ab_off + a * 0x28 + 0x1e) n
          READ_SHORT (ab_off + a * 0x28 + 0x20) first
          FOR (i = 0; i < n; ++i) BEGIN
            SET fx = fx_off + (first + i) * 0x30
            READ_SHORT fx op
            PATCH_IF (op = 224) OR (op = 17) BEGIN SET has_rest = 1 END
          END
        END
        PATCH_IF !has_rest BEGIN
          PATCH_WARN ~chriz-bg-magic: Greater Restoration (%spell%) left as it is: no restoration/healing effect (opcode 224/17).~
        END ELSE BEGIN
          FOR (a = 0; a < ab_cnt; ++a) BEGIN
            READ_LONG 0x64 ab_off
            READ_LONG 0x6a fx_off
            READ_SHORT (ab_off + a * 0x28 + 0x1e) n
            READ_SHORT (ab_off + a * 0x28 + 0x20) first
            SET has_162 = 0
            SET has_46 = 0
            SET has_2 = 0
            SET has_43 = 0
            SET pos_43 = 0 - 1
            SET pos_17 = 0 - 1
            SET has_112_squirp = 0
            SET has_321_spwi415 = 0
            SET has_26 = 0
            SET has_75 = 0
            SET has_81 = 0
            SET has_i13 = 0
            SET has_i55 = 0
            SET has_i14 = 0
            SET has_i124 = 0
            SET has_i35 = 0
            SET has_i8 = 0
            SET has_i112 = 0
            FOR (i = 0; i < n; ++i) BEGIN
              SET fx = fx_off + (first + i) * 0x30
              READ_SHORT fx op
              READ_SLONG (fx + 0x08) p2
              READ_ASCII (fx + 0x14) res (8) NULL
              PATCH_IF (op = 17) AND (pos_17 < 0) BEGIN SET pos_17 = i END
              PATCH_IF (op = 162) BEGIN SET has_162 = 1 END
              PATCH_IF (op = 46) BEGIN SET has_46 = 1 END
              PATCH_IF (op = 2) BEGIN SET has_2 = 1 END
              PATCH_IF (op = 43) BEGIN
                SET has_43 = 1
                PATCH_IF (pos_43 < 0) BEGIN SET pos_43 = i END
              END
              PATCH_IF (op = 112) AND (~%res%~ STRING_EQUAL_CASE ~SQUIRP~) BEGIN SET has_112_squirp = 1 END
              PATCH_IF (op = 321) AND (~%res%~ STRING_EQUAL_CASE ~SPWI415~) BEGIN SET has_321_spwi415 = 1 END
              PATCH_IF (op = 26) BEGIN SET has_26 = 1 END
              PATCH_IF (op = 75) BEGIN SET has_75 = 1 END
              PATCH_IF (op = 81) BEGIN SET has_81 = 1 END
              PATCH_IF (op = 240) BEGIN
                PATCH_IF (p2 = 13) BEGIN SET has_i13 = 1 END
                PATCH_IF (p2 = 55) BEGIN SET has_i55 = 1 END
                PATCH_IF (p2 = 14) BEGIN SET has_i14 = 1 END
                PATCH_IF (p2 = 124) BEGIN SET has_i124 = 1 END
                PATCH_IF (p2 = 35) BEGIN SET has_i35 = 1 END
                PATCH_IF (p2 = 8) BEGIN SET has_i8 = 1 END
                PATCH_IF (p2 = 112) BEGIN SET has_i112 = 1 END
              END
            END
            // Cure Stone to Flesh (opcode 43) must precede Current HP bonus (opcode 17).
            PATCH_IF has_43 AND (pos_17 >= 0) AND (pos_43 > pos_17) BEGIN
              LPF cbmagic_delete_effect INT_VAR index = (first + pos_43) END
              SET has_43 = 0
              SET changed += 1
            END
            PATCH_IF !has_43 BEGIN
              READ_LONG 0x64 ab_off
              READ_LONG 0x6a fx_off
              READ_SHORT (ab_off + a * 0x28 + 0x1e) n
              READ_SHORT (ab_off + a * 0x28 + 0x20) first
              SET ins_43 = 999
              FOR (i = 0; i < n; ++i) BEGIN
                READ_SHORT (fx_off + (first + i) * 0x30) op
                PATCH_IF (op = 17) AND (ins_43 = 999) BEGIN SET ins_43 = i END
              END
              LPF cbmagic_insert_effect INT_VAR ability = a position = ins_43 opcode = 43 target = 2 power = 7
                timing = 1 resist_dispel = 2 duration = 0 END
              SET changed += 1
            END
            PATCH_IF !has_162 BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 162 target = 2 power = 7
                timing = 1 resist_dispel = 2 duration = 0 END
              SET changed += 1
            END
            PATCH_IF !has_46 BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 46 target = 2 power = 7
                timing = 1 resist_dispel = 2 duration = 0 END
              SET changed += 1
            END
            PATCH_IF !has_2 BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 2 target = 2 power = 7
                timing = 1 resist_dispel = 2 duration = 0 END
              SET changed += 1
            END
            PATCH_IF !has_112_squirp BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 112 target = 2 power = 7
                timing = 1 resist_dispel = 2 duration = 0 STR_VAR resource = ~SQUIRP~ END
              SET changed += 1
            END
            PATCH_IF !has_321_spwi415 BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 321 target = 2 power = 7
                timing = 1 resist_dispel = 2 duration = 0 STR_VAR resource = ~SPWI415~ END
              SET changed += 1
            END
            PATCH_IF !has_26 BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 26 target = 2 power = 7
                timing = 1 resist_dispel = 2 duration = 0 END
              SET changed += 1
            END
            PATCH_IF !has_75 BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 75 target = 2 power = 7
                timing = 1 resist_dispel = 2 duration = 0 END
              SET changed += 1
            END
            PATCH_IF !has_81 BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 81 target = 2 power = 7
                timing = 1 resist_dispel = 2 duration = 0 END
              SET changed += 1
            END
            PATCH_IF !has_i13 BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 240 target = 2 power = 7
                parameter2 = 13 timing = 1 resist_dispel = 2 duration = 0 END
              SET changed += 1
            END
            PATCH_IF !has_i55 BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 240 target = 2 power = 7
                parameter2 = 55 timing = 1 resist_dispel = 2 duration = 0 END
              SET changed += 1
            END
            PATCH_IF !has_i14 BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 240 target = 2 power = 7
                parameter2 = 14 timing = 1 resist_dispel = 2 duration = 0 END
              SET changed += 1
            END
            PATCH_IF !has_i124 BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 240 target = 2 power = 7
                parameter2 = 124 timing = 1 resist_dispel = 2 duration = 0 END
              SET changed += 1
            END
            PATCH_IF !has_i35 BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 240 target = 2 power = 7
                parameter2 = 35 timing = 1 resist_dispel = 2 duration = 0 END
              SET changed += 1
            END
            PATCH_IF !has_i8 BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 240 target = 2 power = 7
                parameter2 = 8 timing = 1 resist_dispel = 2 duration = 0 END
              SET changed += 1
            END
            PATCH_IF !has_i112 BEGIN
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 240 target = 2 power = 7
                parameter2 = 112 timing = 1 resist_dispel = 2 duration = 0 END
              SET changed += 1
            END
            // The cures above end these states, but a separate opcode 142 stays on the record:
            // Feebleminded for good, the others until their time runs out. Measured in the lab.
            PATCH_FOR_EACH stale_row IN 2 3 6 7 44 47 48 101 126 BEGIN
              SET has_row = 0
              READ_LONG 0x64 ab_off
              READ_LONG 0x6a fx_off
              READ_SHORT (ab_off + a * 0x28 + 0x1e) n
              READ_SHORT (ab_off + a * 0x28 + 0x20) first
              FOR (i = 0; i < n; ++i) BEGIN
                SET fx = fx_off + (first + i) * 0x30
                READ_SHORT fx op
                READ_SLONG (fx + 0x08) p2
                PATCH_IF (op = 240) AND (p2 = stale_row) BEGIN SET has_row = 1 END
              END
              PATCH_IF !has_row BEGIN
                LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 240 target = 2 power = 7
                  parameter2 = stale_row timing = 1 resist_dispel = 2 duration = 0 END
                SET changed += 1
              END
            END
          END
          PATCH_IF (changed > 0) BEGIN
            PATCH_PRINT ~chriz-bg-magic: Greater Restoration (%spell%): added cures for Hold, Stun, Sleep, Petrification, Polymorph, curses, Blindness, and Deafness.~
          END ELSE BEGIN
            PATCH_PRINT ~chriz-bg-magic: Greater Restoration (%spell%): additional condition cures present already.~
          END
        END
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Greater Restoration~ END
      OUTER_SPRINT cbm_find @40072
      OUTER_SPRINT cbm_replace @40073
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%cbm_find%~ replace = EVAL ~%cbm_replace%~ label = ~Greater Restoration~ END
    END
  END
END
