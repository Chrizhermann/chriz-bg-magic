// Kept and adjusted Spell Revisions changes for chriz-bg-magic, one action function per
// decided spell. docs/components.md describes what each one does; docs/build-specs-sr.json
// summarizes the decisions.

// Ensures an ability with `min_level` exists without discarding any existing abilities.
// When `min_level` is not present, clones the nearest preceding ability (`ml <= min_level`,
// or ability 0 if all existing abilities have `ml > min_level`) and inserts it in sorted
// `min_level` order, shifting subsequent ability effect indices and casting effect indices.
DEFINE_PATCH_FUNCTION cbmagic_ensure_ability_min_level
  INT_VAR min_level = 1
  RET ability_index inserted
BEGIN
  SET ability_index = 0 - 1
  SET inserted = 0
  READ_LONG 0x64 ab_off
  READ_SHORT 0x68 ab_cnt
  READ_LONG 0x6a fx_off
  SET src_ab = 0
  SET ins_ab = ab_cnt
  FOR (a = 0; a < ab_cnt; ++a) BEGIN
    READ_SHORT (ab_off + a * 0x28 + 0x10) ml
    PATCH_IF (ml = min_level) AND (ability_index < 0) BEGIN
      SET ability_index = a
    END
    PATCH_IF (ml <= min_level) BEGIN
      SET src_ab = a
    END
    PATCH_IF (ml > min_level) AND (ins_ab = ab_cnt) BEGIN
      SET ins_ab = a
    END
  END
  PATCH_IF (ability_index < 0) AND (ab_cnt > 0) BEGIN
    READ_ASCII (ab_off + src_ab * 0x28) src_ab_bytes (0x28)
    READ_SHORT (ab_off + src_ab * 0x28 + 0x1e) src_n
    READ_SHORT (ab_off + src_ab * 0x28 + 0x20) src_first
    READ_ASCII (fx_off + src_first * 0x30) src_fx_bytes (src_n * 0x30)
    PATCH_IF (ins_ab < ab_cnt) BEGIN
      READ_SHORT (ab_off + ins_ab * 0x28 + 0x20) ins_first
    END ELSE BEGIN
      READ_SHORT (ab_off + (ab_cnt - 1) * 0x28 + 0x1e) prev_n
      READ_SHORT (ab_off + (ab_cnt - 1) * 0x28 + 0x20) prev_first
      SET ins_first = prev_first + prev_n
    END
    SET where_ab = ab_off + ins_ab * 0x28
    INSERT_BYTES where_ab 0x28
    WRITE_ASCIIE where_ab ~%src_ab_bytes%~ (0x28)
    WRITE_SHORT (where_ab + 0x10) min_level
    WRITE_SHORT (where_ab + 0x1e) src_n
    WRITE_SHORT (where_ab + 0x20) ins_first
    PATCH_IF (fx_off >= where_ab) BEGIN
      SET fx_off += 0x28
      WRITE_LONG 0x6a fx_off
    END
    SET ab_cnt += 1
    WRITE_SHORT 0x68 ab_cnt
    PATCH_IF (src_n > 0) BEGIN
      SET where_fx = fx_off + ins_first * 0x30
      INSERT_BYTES where_fx (src_n * 0x30)
      WRITE_ASCIIE where_fx ~%src_fx_bytes%~ (src_n * 0x30)
      PATCH_IF (ab_off >= where_fx) BEGIN
        SET ab_off += (src_n * 0x30)
        WRITE_LONG 0x64 ab_off
      END
      FOR (b = ins_ab + 1; b < ab_cnt; ++b) BEGIN
        READ_SHORT (ab_off + b * 0x28 + 0x20) f2
        WRITE_SHORT (ab_off + b * 0x28 + 0x20) (f2 + src_n)
      END
      READ_SHORT 0x6e cast_first
      READ_SHORT 0x70 cast_cnt
      PATCH_IF (cast_first >= ins_first) AND ((cast_cnt > 0) OR (cast_first > ins_first)) BEGIN
        WRITE_SHORT 0x6e (cast_first + src_n)
      END
    END
    SET ability_index = ins_ab
    SET inserted = 1
  END
END

// Appends a clone of ability 0 at the end of the ability table with `min_level` and scales
// any effect whose duration equals `base_dur` (when base_dur > 0) to `new_dur`.
DEFINE_PATCH_FUNCTION cbmagic_clone_first_ability
  INT_VAR min_level = 1 base_dur = 0 new_dur = 0
  RET new_ability
BEGIN
  READ_LONG 0x64 ab_off
  READ_SHORT 0x68 ab_cnt
  READ_LONG 0x6a fx_off
  READ_ASCII ab_off ab0_bytes (0x28)
  READ_SHORT (ab_off + 0x1e) n0
  READ_SHORT (ab_off + (ab_cnt - 1) * 0x28 + 0x1e) prev_n
  READ_SHORT (ab_off + (ab_cnt - 1) * 0x28 + 0x20) prev_first
  SET new_ability = ab_cnt
  SET where_ab = ab_off + ab_cnt * 0x28
  INSERT_BYTES where_ab 0x28
  WRITE_ASCIIE where_ab ~%ab0_bytes%~ (0x28)
  WRITE_SHORT (where_ab + 0x10) min_level
  WRITE_SHORT (where_ab + 0x1e) 0
  WRITE_SHORT (where_ab + 0x20) (prev_first + prev_n)
  PATCH_IF (fx_off >= where_ab) BEGIN
    SET fx_off += 0x28
    WRITE_LONG 0x6a fx_off
  END
  WRITE_SHORT 0x68 (ab_cnt + 1)
  FOR (i = 0; i < n0; ++i) BEGIN
    READ_LONG 0x64 ab_off
    READ_LONG 0x6a fx_off
    READ_SHORT (ab_off + 0x20) first0
    SET src = fx_off + (first0 + i) * 0x30
    READ_SHORT src op
    READ_BYTE (src + 0x02) target
    READ_BYTE (src + 0x03) power
    READ_SLONG (src + 0x04) p1
    READ_SLONG (src + 0x08) p2
    READ_BYTE (src + 0x0c) timing
    READ_BYTE (src + 0x0d) resist_dispel
    READ_LONG (src + 0x0e) dur
    READ_BYTE (src + 0x12) prob1
    READ_BYTE (src + 0x13) prob2
    READ_ASCII (src + 0x14) res (8) NULL
    READ_LONG (src + 0x1c) dicenumber
    READ_LONG (src + 0x20) dicesize
    READ_LONG (src + 0x24) savingthrow
    READ_SLONG (src + 0x28) savebonus
    READ_LONG (src + 0x2c) special
    PATCH_IF (base_dur > 0) AND (dur = base_dur) BEGIN
      SET dur = new_dur
    END
    LPF cbmagic_insert_effect
      INT_VAR ability = new_ability position = i opcode = op target power parameter1 = p1 parameter2 = p2
              timing resist_dispel duration = dur probability1 = prob1 probability2 = prob2
              dicenumber dicesize savingthrow savebonus special
      STR_VAR resource = EVAL ~%res%~
    END
  END
END

// Sets the duration of the owned `anchor_opcode` payload (timing = 0) and its actual
// companion effects in the same ability (portrait icon op 142, expiry sound op 174 with
// timing = 4, duration visual op 215 with timing = 0, and Luck's save/skill bonus opcodes
// when anchor_opcode = 133) that share the anchor's duration to `new_dur`.
DEFINE_PATCH_FUNCTION cbmagic_set_anchored_duration
  INT_VAR anchor_opcode = 0 new_dur = 0
  RET changed already
BEGIN
  SET changed = 0
  SET already = 0
  READ_LONG 0x64 ab_off
  READ_SHORT 0x68 ab_cnt
  READ_LONG 0x6a fx_off
  FOR (a = 0; a < ab_cnt; ++a) BEGIN
    READ_SHORT (ab_off + a * 0x28 + 0x1e) n
    READ_SHORT (ab_off + a * 0x28 + 0x20) first
    SET old_dur = 0 - 1
    FOR (i = 0; i < n; ++i) BEGIN
      SET fx = fx_off + (first + i) * 0x30
      READ_SHORT fx op
      READ_ASCII (fx + 0x14) resource (8) NULL
      READ_BYTE (fx + 0x0c) timing
      READ_LONG (fx + 0x0e) dur
      SET is_anchor = (op = anchor_opcode)
      PATCH_IF (anchor_opcode = 133 && op = 22 && ~%resource%~ STRING_EQUAL ~CBTLUCK~) BEGIN SET is_anchor = 1 END
      PATCH_IF is_anchor AND (timing = 0) AND (old_dur < 0) BEGIN
        SET old_dur = dur
      END
    END
    PATCH_IF (old_dur >= 0) BEGIN
      SET ab_changed = 0
      FOR (i = 0; i < n; ++i) BEGIN
        SET fx = fx_off + (first + i) * 0x30
        READ_SHORT fx op
        READ_ASCII (fx + 0x14) resource (8) NULL
        READ_BYTE (fx + 0x0c) timing
        READ_LONG (fx + 0x0e) dur
        SET is_owned = 0
        PATCH_IF (op = anchor_opcode) AND (timing = 0) BEGIN
          SET is_owned = 1
        END ELSE PATCH_IF (anchor_opcode = 133 && timing = 0
          && ((op = 22 && ~%resource%~ STRING_EQUAL ~CBTLUCK~)
            || (op = 328 && ~%resource%~ STRING_EQUAL ~CBTSTATE~))) BEGIN
          SET is_owned = 1
        END ELSE PATCH_IF ((op = 142) AND (timing = 0))
                       OR ((op = 174) AND (timing = 4))
                       OR ((op = 215) AND (timing = 0)) BEGIN
          SET is_owned = 1
        END ELSE PATCH_IF (anchor_opcode = 133) AND (timing = 0)
                      AND (((op >= 33) AND (op <= 37)) OR (op = 59)
                           OR ((op >= 90) AND (op <= 92))
                           OR ((op >= 275) AND (op <= 277))) BEGIN
          SET is_owned = 1
        END
        PATCH_IF is_owned AND (dur = old_dur) AND (dur != new_dur) BEGIN
          WRITE_LONG (fx + 0x0e) new_dur
          SET ab_changed = 1
        END
      END
      PATCH_IF ab_changed BEGIN
        SET changed += 1
      END ELSE PATCH_IF (old_dur = new_dur) BEGIN
        SET already += 1
      END
    END
  END
END

// Finds or appends a STATDESC.2DA portrait icon row with `desc_ref` and `bam`, returning
// its row number in `icon_row` (defaults to 207 when STATDESC.2DA is absent in minimal
// test fixtures).
DEFINE_ACTION_FUNCTION cbmagic_statdesc_row
  INT_VAR desc_ref = 0
  STR_VAR bam = ~SPPR150D~
  RET icon_row
BEGIN
  OUTER_SET icon_row = 207
  ACTION_IF (FILE_EXISTS_IN_GAME ~statdesc.2da~) BEGIN
    COPY_EXISTING ~statdesc.2da~ ~override~
      COUNT_2DA_COLS cols
      PATCH_IF (cols >= 3) BEGIN
        COUNT_2DA_ROWS 3 rows
        SET found_row = 0 - 1
        SET max_id = 0
        FOR (r = 0; r < rows; ++r) BEGIN
          READ_2DA_ENTRY r 0 3 row_id
          READ_2DA_ENTRY r 1 3 row_str
          READ_2DA_ENTRY r 2 3 row_bam
          PATCH_IF IS_AN_INT row_id BEGIN
            PATCH_IF (row_id > max_id) BEGIN
              SET max_id = row_id
            END
            PATCH_IF (~%row_bam%~ STRING_EQUAL_CASE ~%bam%~) AND (IS_AN_INT row_str) AND (row_str = desc_ref) BEGIN
              SET found_row = row_id
            END
          END
        END
        PATCH_IF (found_row >= 0) BEGIN
          SET icon_row = found_row
        END ELSE BEGIN
          SET icon_row = max_id + 1
          INSERT_2DA_ROW rows 3 ~%icon_row% %desc_ref% %bam%~
        END
      END
    BUT_ONLY
  END
END

// Copies the requested STATES.BAM cycle into cycle 0 of a private BAM for a custom
// STATDESC row. The character-record UI only renders cycle 0 of a named BAM, while
// the built-in STATES.BAM uses cycle row + 65. A malformed, unavailable, or too-short
// source remains a harmless unmodified private copy (or no copy when the resource is
// absent), and is named in the install log instead of risking a corrupt BAM.
DEFINE_ACTION_FUNCTION cbmagic_state_icon
  INT_VAR row = 0
  STR_VAR resref = ~~
BEGIN
  ACTION_IF (row < 0) OR (~%resref%~ STRING_EQUAL ~~) BEGIN
    PRINT ~chriz-bg-magic: cannot make a state icon with row %row% and BAM %resref%; left out.~
  END ELSE ACTION_IF !(FILE_EXISTS_IN_GAME ~states.bam~) BEGIN
    PRINT ~chriz-bg-magic: STATES.BAM is unavailable; %resref%.BAM was not made.~
  END ELSE BEGIN
    COPY_EXISTING ~states.bam~ ~override/%resref%.bam~
      PATCH_IF (BUFFER_LENGTH < 4) BEGIN
        PATCH_PRINT ~chriz-bg-magic: STATES.BAM is too short; %resref%.BAM keeps its safe fallback cycle 0.~
      END ELSE BEGIN
        // WeiDU expands BAMC in-place; ordinary BAM V1 files do not need conversion.
        READ_ASCII 0 compressed_signature (4)
        PATCH_IF (~%compressed_signature%~ STRING_EQUAL ~BAMC~) BEGIN
          PATCH_IF (BUFFER_LENGTH < 0x0c) BEGIN
            PATCH_PRINT ~chriz-bg-magic: compressed STATES.BAM is too short; %resref%.BAM keeps its safe fallback cycle 0.~
          END ELSE BEGIN
            READ_LONG 0x08 uncompressed_size
            DECOMPRESS_REPLACE_FILE 0x0c (SOURCE_SIZE - 0x0c) uncompressed_size
          END
        END
        PATCH_IF (BUFFER_LENGTH < 0x10) BEGIN
          PATCH_PRINT ~chriz-bg-magic: STATES.BAM is too short after decompression; %resref%.BAM keeps its safe fallback cycle 0.~
        END ELSE BEGIN
          READ_ASCII 0 signature (8)
          PATCH_IF !(~%signature%~ STRING_EQUAL ~BAM V1  ~) BEGIN
            PATCH_PRINT ~chriz-bg-magic: STATES.BAM is not a usable BAM V1 after decompression; %resref%.BAM keeps its safe fallback cycle 0.~
          END ELSE BEGIN
            READ_SHORT 0x08 frames
            READ_BYTE  0x0a cycles
            READ_LONG  0x0c frame_off
            SET source_cycle = row + 65
            SET cycle_off = frame_off + frames * 12
            PATCH_IF (source_cycle >= cycles) OR (cycle_off < 0) OR (cycle_off + cycles * 4 > BUFFER_LENGTH) BEGIN
              PATCH_PRINT ~chriz-bg-magic: STATES.BAM has no safe cycle %source_cycle% for row %row%; %resref%.BAM keeps its fallback cycle 0.~
            END ELSE BEGIN
              READ_SHORT (cycle_off + source_cycle * 4) frame_count
              READ_SHORT (cycle_off + source_cycle * 4 + 2) first_frame
              WRITE_SHORT cycle_off frame_count
              WRITE_SHORT (cycle_off + 2) first_frame
            END
          END
        END
      END
    BUT_ONLY
  END
END

// Makes a wizard spell and its scrolls belong to the Universal school (school 0, no
// specialist mage exclusion bits).
DEFINE_ACTION_FUNCTION cbmagic_make_universal_school
  STR_VAR symbol = ~~ label = ~~
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: %label% (%symbol%) is not in this game; left out.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    OUTER_SET valid_spl = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: %label% (%spell%) left as it is: %reason%.~
      END ELSE BEGIN
        SET valid_spl = 1
        READ_SHORT 0x1e excl
        READ_BYTE 0x25 school
        SET new_excl = (excl BAND (BNOT 0x3fc0))
        PATCH_IF (school != 0) OR (new_excl != excl) BEGIN
          WRITE_SHORT 0x1e new_excl
          WRITE_BYTE 0x25 0
          SET changed = 1
        END
      END
    BUT_ONLY
    ACTION_IF valid_spl BEGIN
      LAF cbmagic_scrolls_of STR_VAR spell RET scrolls END
      OUTER_PATCH_SAVE list ~%scrolls%~ BEGIN REPLACE_TEXTUALLY ~^ +~ ~~ END
      OUTER_WHILE !(~%list%~ STRING_EQUAL ~~) BEGIN
        OUTER_PATCH_SAVE scroll ~%list%~ BEGIN REPLACE_TEXTUALLY ~ .*$~ ~~ END
        OUTER_PATCH_SAVE list ~%list%~ BEGIN REPLACE_TEXTUALLY ~^[^ ]+ ?~ ~~ END
        COPY_EXISTING ~%scroll%.itm~ ~override~
          PATCH_IF (BUFFER_LENGTH >= 0x72) BEGIN
            READ_BYTE 0x2d u1
            READ_BYTE 0x2f u3
            SET nu1 = (u1 BAND (BNOT 0x3f))
            SET nu3 = (u3 BAND (BNOT 0xc0))
            PATCH_IF (nu1 != u1) OR (nu3 != u3) BEGIN
              WRITE_BYTE 0x2d nu1
              WRITE_BYTE 0x2f nu3
              SET changed = 1
            END
          END
        BUT_ONLY
      END
      ACTION_IF changed BEGIN
        PRINT ~chriz-bg-magic: %label% (%spell%): school set to Universal for all specialist mages.~
        LAF cbmagic_warn_text_language STR_VAR label END
        OUTER_SPRINT f1 @40012
        OUTER_SPRINT f2 @40013
        OUTER_SPRINT rep @40014
        LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f1%~ replace = EVAL ~%rep%~ label END
        LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f2%~ replace = EVAL ~%rep%~ label END
      END ELSE BEGIN
        PRINT ~chriz-bg-magic: %label% (%spell%): already Universal.~
      END
    END
  END
END

// --- Invisibility (row arcane.level2.invisibility) ------------------------------------
// Duration is 8 hours (2400 seconds) instead of 24 hours (7200 seconds).
DEFINE_ACTION_FUNCTION cbmagic_kept_invisibility
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~WIZARD_INVISIBILITY~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Invisibility (WIZARD_INVISIBILITY) is not in this game; left out.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: Invisibility (%spell%) left as it is: %reason%.~
      END ELSE BEGIN
        LPF cbmagic_set_anchored_duration INT_VAR anchor_opcode = 20 new_dur = 2400 RET changed already END
        PATCH_IF (changed > 0) BEGIN
          PATCH_PRINT ~chriz-bg-magic: Invisibility (%spell%): duration set to 2400s in %changed% abilities.~
        END ELSE PATCH_IF (already > 0) BEGIN
          PATCH_PRINT ~chriz-bg-magic: Invisibility (%spell%): duration is 2400s already.~
        END ELSE BEGIN
          PATCH_WARN ~chriz-bg-magic: Invisibility (%spell%) left as it is: no timed invisibility effect (opcode 20).~
        END
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Invisibility~ END
      OUTER_SPRINT cbm_find @40000
      OUTER_SPRINT cbm_replace @40001
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%cbm_find%~ replace = EVAL ~%cbm_replace%~ label = ~Invisibility~ END
    END
  END
END

// --- Luck (row arcane.level2.luck) ----------------------------------------------------
// Vanilla effect (+1 to luck and skill checks), duration 15 rounds (90 seconds), and a
// new casting replaces the old one.
DEFINE_ACTION_FUNCTION cbmagic_kept_luck
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~WIZARD_LUCK~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Luck (WIZARD_LUCK) is not in this game; left out.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: Luck (%spell%) left as it is: %reason%.~
      END ELSE BEGIN
        LPF cbmagic_set_anchored_duration INT_VAR anchor_opcode = 133 new_dur = 90 RET dur_changed = changed already END
        PATCH_IF (dur_changed = 0) AND (already = 0) BEGIN
          PATCH_WARN ~chriz-bg-magic: Luck (%spell%) left as it is: no timed luck effect (opcode 133).~
        END ELSE BEGIN
          LPF cbmagic_add_self_refresh RET ref_added = added ref_present = present misplaced END
          SET changed = dur_changed + ref_added
          PATCH_IF (changed > 0) BEGIN
            PATCH_PRINT ~chriz-bg-magic: Luck (%spell%): duration set to 90s in %dur_changed% abilities; self-refresh added in %ref_added%.~
          END ELSE BEGIN
            PATCH_PRINT ~chriz-bg-magic: Luck (%spell%): duration 90s and self-refresh present already.~
          END
        END
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Luck~ END
      OUTER_SPRINT cbm_find @40002
      OUTER_SPRINT cbm_replace @40003
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%cbm_find%~ replace = EVAL ~%cbm_replace%~ label = ~Luck~ END
    END
  END
END

// --- Clairvoyance (row arcane.level3.clairvoyance) ------------------------------------
// Usable indoors and outdoors; grants the caster dispellable immunity to backstab (opcode
// 292) for 3 rounds + 1 round/2 levels (up to 10 rounds at level 19) instead of revealing
// the outdoor map. Preserves any existing ability headers and adds missing breakpoints.
DEFINE_ACTION_FUNCTION cbmagic_kept_clairvoyance
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~WIZARD_CLAIRVOYANCE~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Clairvoyance (WIZARD_CLAIRVOYANCE) is not in this game; left out.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: Clairvoyance (%spell%) left as it is: %reason%.~
      END ELSE BEGIN
        READ_LONG 0x18 flags
        READ_SHORT 0x68 ab_cnt
        READ_LONG 0x64 ab_off
        READ_LONG 0x6a fx_off
        PATCH_IF (ab_cnt < 1) BEGIN
          PATCH_WARN ~chriz-bg-magic: Clairvoyance (%spell%) left as it is: it has no abilities.~
        END ELSE BEGIN
          SET has_117 = 0
          SET has_292_any = 0
          FOR (a = 0; a < ab_cnt; ++a) BEGIN
            READ_SHORT (ab_off + a * 0x28 + 0x1e) na
            READ_SHORT (ab_off + a * 0x28 + 0x20) fa
            FOR (i = 0; i < na; ++i) BEGIN
              SET fx = fx_off + (fa + i) * 0x30
              READ_SHORT fx op
              PATCH_IF (op = 117) BEGIN SET has_117 = 1 END
              PATCH_IF (op = 292) BEGIN SET has_292_any = 1 END
            END
          END
          PATCH_IF (has_117 = 0) AND (has_292_any = 0) BEGIN
            PATCH_WARN ~chriz-bg-magic: Clairvoyance (%spell%) left as it is: neither map reveal (opcode 117) nor backstab immunity (opcode 292) found.~
          END ELSE BEGIN
            SET new_flags = (flags BAND (BNOT 0x2000))
            PATCH_IF (new_flags != flags) BEGIN
              WRITE_LONG 0x18 new_flags
              SET changed += 1
            END
            READ_BYTE 0x27 sectype
            PATCH_IF (sectype = 0) BEGIN
              WRITE_BYTE 0x27 2
              SET changed += 1
            END
            // Ensure breakpoints 1, 7, 9, 11, 13, 15, 17, 19 exist without discarding existing abilities.
            LPF cbmagic_ensure_ability_min_level INT_VAR min_level = 1 RET ability_index ins = inserted END
            SET changed += ins
            FOR (step = 1; step <= 7; ++step) BEGIN
              SET min_lvl = 5 + step * 2
              LPF cbmagic_ensure_ability_min_level INT_VAR min_level = min_lvl RET ability_index ins = inserted END
              SET changed += ins
            END
            READ_SHORT 0x68 ab_cnt
            FOR (a = 0; a < ab_cnt; ++a) BEGIN
              READ_LONG 0x64 ab_off
              SET ab = ab_off + a * 0x28
              READ_BYTE (ab + 0x0c) ab_t
              READ_SHORT (ab + 0x0e) ab_rng
              READ_SHORT (ab + 0x10) ml
              READ_SHORT (ab + 0x26) ab_proj
              PATCH_IF (ab_t != 5) BEGIN WRITE_BYTE (ab + 0x0c) 5 SET changed += 1 END
              PATCH_IF (ab_rng != 0) BEGIN WRITE_SHORT (ab + 0x0e) 0 SET changed += 1 END
              PATCH_IF (ab_proj != 1) BEGIN WRITE_SHORT (ab + 0x26) 1 SET changed += 1 END
              SET eff_lvl = (ml < 5) ? 5 : ((ml > 19) ? 19 : ml)
              SET steps = (eff_lvl - 5) / 2
              SET target_dur = 18 + steps * 6
              // Delete map reveal (opcode 117) if present.
              SET scanning = 1
              WHILE scanning BEGIN
                SET scanning = 0
                READ_LONG 0x64 ab_off
                READ_LONG 0x6a fx_off
                READ_SHORT (ab_off + a * 0x28 + 0x1e) na
                READ_SHORT (ab_off + a * 0x28 + 0x20) fa
                FOR (i = 0; (i < na) AND !scanning; ++i) BEGIN
                  SET fx = fx_off + (fa + i) * 0x30
                  READ_SHORT fx op
                  PATCH_IF (op = 117) BEGIN
                    LPF cbmagic_delete_effect INT_VAR index = (fa + i) END
                    SET changed += 1
                    SET scanning = 1
                  END
                END
              END
              READ_LONG 0x64 ab_off
              READ_LONG 0x6a fx_off
              READ_SHORT (ab_off + a * 0x28 + 0x1e) na
              READ_SHORT (ab_off + a * 0x28 + 0x20) fa
              SET has_321 = 0
              SET has_292 = 0
              SET has_142 = 0
              FOR (i = 0; i < na; ++i) BEGIN
                SET fx = fx_off + (fa + i) * 0x30
                READ_SHORT fx op
                READ_BYTE (fx + 0x02) t
                READ_BYTE (fx + 0x03) pwr
                READ_SLONG (fx + 0x08) p2
                READ_BYTE (fx + 0x0d) rd
                READ_LONG (fx + 0x0e) dur
                READ_ASCII (fx + 0x14) res (8) NULL
                PATCH_IF (op = 215) OR (op = 141) OR (op = 61) OR (op = 174) BEGIN
                  PATCH_IF (t != 1) OR (pwr != 3) OR (rd != 3) BEGIN
                    WRITE_BYTE (fx + 0x02) 1
                    WRITE_BYTE (fx + 0x03) 3
                    WRITE_BYTE (fx + 0x0d) 3
                    SET changed += 1
                  END
                END
                PATCH_IF (op = 321) AND (~%res%~ STRING_EQUAL_CASE ~%spell%~) AND (i = 0) BEGIN
                  SET has_321 = 1
                END
                PATCH_IF (op = 292) BEGIN
                  SET has_292 = 1
                  PATCH_IF (t != 1) OR (pwr != 3) OR (p2 != 1) OR (rd != 3) OR (dur != target_dur) BEGIN
                    WRITE_BYTE (fx + 0x02) 1
                    WRITE_BYTE (fx + 0x03) 3
                    WRITE_LONG (fx + 0x08) 1
                    WRITE_BYTE (fx + 0x0c) 0
                    WRITE_BYTE (fx + 0x0d) 3
                    WRITE_LONG (fx + 0x0e) target_dur
                    SET changed += 1
                  END
                END
                PATCH_IF (op = 142) AND (p2 = 57) BEGIN
                  SET has_142 = 1
                  PATCH_IF (t != 1) OR (pwr != 3) OR (rd != 3) OR (dur != target_dur) BEGIN
                    WRITE_BYTE (fx + 0x02) 1
                    WRITE_BYTE (fx + 0x03) 3
                    WRITE_BYTE (fx + 0x0c) 0
                    WRITE_BYTE (fx + 0x0d) 3
                    WRITE_LONG (fx + 0x0e) target_dur
                    SET changed += 1
                  END
                END
              END
              PATCH_IF !has_142 BEGIN
                LPF cbmagic_insert_effect INT_VAR ability = a position = 0 opcode = 142 target = 1 power = 3
                  parameter2 = 57 timing = 0 resist_dispel = 3 duration = target_dur END
                SET changed += 1
              END
              PATCH_IF !has_292 BEGIN
                LPF cbmagic_insert_effect INT_VAR ability = a position = 0 opcode = 292 target = 1 power = 3
                  parameter2 = 1 timing = 0 resist_dispel = 3 duration = target_dur END
                SET changed += 1
              END
              PATCH_IF !has_321 BEGIN
                LPF cbmagic_insert_effect INT_VAR ability = a position = 0 opcode = 321 target = 1 power = 3
                  timing = 1 resist_dispel = 3 STR_VAR resource = EVAL ~%spell%~ END
                SET changed += 1
              END
            END
            PATCH_IF (changed > 0) BEGIN
              PATCH_PRINT ~chriz-bg-magic: Clairvoyance (%spell%): indoor/outdoor backstab immunity for 3-10 rounds.~
            END ELSE BEGIN
              PATCH_PRINT ~chriz-bg-magic: Clairvoyance (%spell%): backstab immunity progression present already.~
            END
          END
        END
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Clairvoyance~ END
      OUTER_SPRINT f1 @40043
      OUTER_SPRINT r1 @40044
      OUTER_SPRINT f2 @40040
      OUTER_SPRINT r2 @40045
      OUTER_SPRINT f3 @40046
      OUTER_SPRINT r3 @40047
      OUTER_SPRINT f4 @40048
      OUTER_SPRINT r4 @40049
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f1%~ replace = EVAL ~%r1%~ label = ~Clairvoyance~ END
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f2%~ replace = EVAL ~%r2%~ label = ~Clairvoyance~ END
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f3%~ replace = EVAL ~%r3%~ label = ~Clairvoyance~ END
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%f4%~ replace = EVAL ~%r4%~ label = ~Clairvoyance~ END
    END
  END
END

// --- Invisibility Sphere (row arcane.level3.invisibility_sphere) ----------------------
// Renamed Invisibility Sphere in spell and scroll names/descriptions, casting time 1
// (from 9), duration 1 turn (60 seconds, from 24 hours), and uses an ally-only radius-110
// projectile of our own (cbminv10.pro via ADD_PROJECTILE).
DEFINE_ACTION_FUNCTION cbmagic_kept_invisibility_sphere
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~WIZARD_INVISIBILITY_10_FOOT~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Invisibility Sphere (WIZARD_INVISIBILITY_10_FOOT) is not in this game; left out.~
  END ELSE BEGIN
    LAF cbmagic_game_language RET lang END
    OUTER_SET new_name_ref = RESOLVE_STR_REF (@40075)
    OUTER_SET proj_id = IDS_OF_SYMBOL (~projectl~ ~cbminv10~)
    ACTION_IF (proj_id >= 0) BEGIN
      OUTER_SET proj_id += 1
    END ELSE BEGIN
      OUTER_SET can_add_proj = 0
      ACTION_IF (FILE_EXISTS_IN_GAME ~projectl.ids~) BEGIN
        COPY_EXISTING - ~projectl.ids~ ~override~
          PATCH_IF (INDEX_BUFFER (~[0-9]~ 8) >= 0) BEGIN
            SET can_add_proj = 1
          END
      END
      ACTION_IF can_add_proj BEGIN
        ACTION_IF (FILE_EXISTS_IN_GAME ~invis10.pro~) BEGIN
          COPY_EXISTING - ~invis10.pro~ ~weidu_external/cbminv10.pro~
            WRITE_SHORT 0x204 110
            WRITE_SHORT 0x206 110
        END ELSE BEGIN
          COPY - ~chriz-bg-magic/lib/cbmagic_shared.tpa~ ~weidu_external/cbminv10.pro~
            DELETE_BYTES 0 BUFFER_LENGTH
            INSERT_BYTES 0 0x300
            WRITE_ASCII 0 ~PRO V1.0~ (8)
            WRITE_SHORT 0x08 3
            WRITE_SHORT 0x0a 20
            WRITE_LONG 0x100 0x280
            WRITE_ASCII 0x104 ~TRAVEL~ (8)
            WRITE_ASCII 0x11c ~STTRAVL2~ (8)
            WRITE_SHORT 0x132 256
            WRITE_SHORT 0x200 0xc0
            WRITE_SHORT 0x202 0
            WRITE_SHORT 0x204 110
            WRITE_SHORT 0x206 110
            WRITE_SHORT 0x210 100
            WRITE_SHORT 0x214 0
            WRITE_BYTE 0x216 1
            WRITE_BYTE 0x217 255
            WRITE_SHORT 0x218 8
            WRITE_SHORT 0x21a 79
        END
        ADD_PROJECTILE ~weidu_external/cbminv10.pro~
        OUTER_SET proj_id = cbminv10
      END ELSE BEGIN
        OUTER_SET proj_id = 159
      END
    END
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: Invisibility Sphere (%spell%) left as it is: %reason%.~
      END ELSE BEGIN
        LPF cbmagic_set_anchored_duration INT_VAR anchor_opcode = 20 new_dur = 60 RET dur_changed = changed already END
        PATCH_IF (dur_changed = 0) AND (already = 0) BEGIN
          PATCH_WARN ~chriz-bg-magic: Invisibility Sphere (%spell%) left as it is: no timed invisibility effect (opcode 20).~
        END ELSE BEGIN
          PATCH_IF (~%lang%~ STRING_EQUAL ~en_us~) BEGIN
            READ_SLONG 0x08 cur_name
            PATCH_IF (cur_name != new_name_ref) BEGIN
              WRITE_LONG 0x08 new_name_ref
              SET changed += 1
            END
          END
          READ_LONG 0x64 ab_off
          READ_SHORT 0x68 ab_cnt
          FOR (a = 0; a < ab_cnt; ++a) BEGIN
            READ_SHORT (ab_off + a * 0x28 + 0x12) ct
            READ_SHORT (ab_off + a * 0x28 + 0x26) proj
            PATCH_IF (ct != 1) BEGIN
              WRITE_SHORT (ab_off + a * 0x28 + 0x12) 1
              SET changed += 1
            END
            PATCH_IF (proj != proj_id) BEGIN
              WRITE_SHORT (ab_off + a * 0x28 + 0x26) proj_id
              SET changed += 1
            END
          END
          SET changed += dur_changed
          PATCH_IF (changed > 0) BEGIN
            PATCH_PRINT ~chriz-bg-magic: Invisibility Sphere (%spell%): renamed, casting time 1, duration 60s, radius-110 ally projectile %proj_id%.~
          END ELSE BEGIN
            PATCH_PRINT ~chriz-bg-magic: Invisibility Sphere (%spell%): renamed, casting time 1, duration 60s, and projectile %proj_id% present already.~
          END
        END
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      ACTION_IF (~%lang%~ STRING_EQUAL ~en_us~) BEGIN
        LAF cbmagic_scrolls_of STR_VAR spell RET scrolls END
        OUTER_PATCH_SAVE list ~%scrolls%~ BEGIN REPLACE_TEXTUALLY ~^ +~ ~~ END
        OUTER_WHILE !(~%list%~ STRING_EQUAL ~~) BEGIN
          OUTER_PATCH_SAVE scroll ~%list%~ BEGIN REPLACE_TEXTUALLY ~ .*$~ ~~ END
          OUTER_PATCH_SAVE list ~%list%~ BEGIN REPLACE_TEXTUALLY ~^[^ ]+ ?~ ~~ END
          COPY_EXISTING ~%scroll%.itm~ ~override~
            PATCH_IF (BUFFER_LENGTH >= 0x72) BEGIN
              READ_SLONG 0x0c s_name
              PATCH_IF (s_name != new_name_ref) BEGIN
                WRITE_LONG 0x0c new_name_ref
              END
            END
          BUT_ONLY
        END
      END
      LAF cbmagic_warn_text_language STR_VAR label = ~Invisibility Sphere~ END
      OUTER_SPRINT f0 @40076
      OUTER_SPRINT r0 @40075
      OUTER_SPRINT f1 @40004
      OUTER_SPRINT r1 @40005
      OUTER_SPRINT f2 @40000
      OUTER_SPRINT r2 @40007
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f0%~ replace = EVAL ~%r0%~ label = ~Invisibility Sphere~ END
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f1%~ replace = EVAL ~%r1%~ label = ~Invisibility Sphere~ END
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%f2%~ replace = EVAL ~%r2%~ label = ~Invisibility Sphere~ END
    END
  END
END

// --- Confusion (row arcane.level4.confusion) ------------------------------------------
// Duration is 4 rounds (24s) at levels 1-14, 5 rounds (30s) at levels 15-19, and 6
// rounds (36s) at level 20+. Preserves existing ability headers (e.g. 1, 6, 12, 18) and
// adds missing breakpoints (15, 20) around them.
DEFINE_ACTION_FUNCTION cbmagic_kept_confusion
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~WIZARD_CONFUSION~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Confusion (WIZARD_CONFUSION) is not in this game; left out.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: Confusion (%spell%) left as it is: %reason%.~
      END ELSE BEGIN
        READ_LONG 0x64 ab_off
        READ_SHORT 0x68 ab_cnt
        READ_LONG 0x6a fx_off
        PATCH_IF (ab_cnt < 1) BEGIN
          PATCH_WARN ~chriz-bg-magic: Confusion (%spell%) left as it is: it has no abilities.~
        END ELSE BEGIN
          SET has_128 = 0
          FOR (a = 0; a < ab_cnt; ++a) BEGIN
            READ_SHORT (ab_off + a * 0x28 + 0x1e) na
            READ_SHORT (ab_off + a * 0x28 + 0x20) fa
            FOR (i = 0; i < na; ++i) BEGIN
              SET fx = fx_off + (fa + i) * 0x30
              READ_SHORT fx op
              READ_BYTE (fx + 0x0c) timing
              PATCH_IF (op = 128) AND (timing = 0) BEGIN SET has_128 = 1 END
            END
          END
          PATCH_IF !has_128 BEGIN
            PATCH_WARN ~chriz-bg-magic: Confusion (%spell%) left as it is: no timed confusion effect (opcode 128).~
          END ELSE BEGIN
            LPF cbmagic_ensure_ability_min_level INT_VAR min_level = 1 RET ability_index ins1 = inserted END
            LPF cbmagic_ensure_ability_min_level INT_VAR min_level = 15 RET ability_index ins15 = inserted END
            LPF cbmagic_ensure_ability_min_level INT_VAR min_level = 20 RET ability_index ins20 = inserted END
            SET changed += (ins1 + ins15 + ins20)
            READ_LONG 0x64 ab_off
            READ_SHORT 0x68 ab_cnt
            READ_LONG 0x6a fx_off
            FOR (a = 0; a < ab_cnt; ++a) BEGIN
              READ_SHORT (ab_off + a * 0x28 + 0x10) ml
              READ_SHORT (ab_off + a * 0x28 + 0x1e) na
              READ_SHORT (ab_off + a * 0x28 + 0x20) fa
              SET target_dur = (ml >= 20) ? 36 : ((ml >= 15) ? 30 : 24)
              SET old_dur = 0 - 1
              FOR (i = 0; i < na; ++i) BEGIN
                SET fx = fx_off + (fa + i) * 0x30
                READ_SHORT fx op
                READ_BYTE (fx + 0x0c) timing
                READ_LONG (fx + 0x0e) dur
                PATCH_IF (op = 128) AND (timing = 0) AND (old_dur < 0) BEGIN
                  SET old_dur = dur
                END
              END
              PATCH_IF (old_dur >= 0) BEGIN
                FOR (i = 0; i < na; ++i) BEGIN
                  SET fx = fx_off + (fa + i) * 0x30
                  READ_SHORT fx op
                  READ_SLONG (fx + 0x08) p2
                  READ_BYTE (fx + 0x0c) timing
                  READ_LONG (fx + 0x0e) dur
                  READ_ASCII (fx + 0x14) res (8) NULL
                  PATCH_IF ((op = 128) AND (timing = 0))
                        OR ((op = 142) AND (p2 = 3) AND (timing = 0))
                        OR ((op = 215) AND (timing = 0) AND (~%res%~ STRING_EQUAL_CASE ~SPCONFUS~))
                        OR ((op = 174) AND (timing = 4)) BEGIN
                    PATCH_IF (dur != target_dur) BEGIN
                      WRITE_LONG (fx + 0x0e) target_dur
                      SET changed += 1
                    END
                  END
                END
              END
            END
            PATCH_IF (changed > 0) BEGIN
              PATCH_PRINT ~chriz-bg-magic: Confusion (%spell%): duration set to 4 rounds (5 at level 15, 6 at level 20).~
            END ELSE BEGIN
              PATCH_PRINT ~chriz-bg-magic: Confusion (%spell%): 4/5/6 round progression present already.~
            END
          END
        END
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Confusion~ END
      OUTER_SPRINT f1 @40008
      OUTER_SPRINT r1 @40009
      OUTER_SPRINT f2 @40010
      OUTER_SPRINT r2 @40011
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f1%~ replace = EVAL ~%r1%~ label = ~Confusion~ END
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%f2%~ replace = EVAL ~%r2%~ label = ~Confusion~ END
    END
  END
END

// --- Minor Sequencer (row arcane.level4.simbuls_spell_matrix) -------------------------
DEFINE_ACTION_FUNCTION cbmagic_kept_minor_sequencer
BEGIN
  LAF cbmagic_make_universal_school STR_VAR symbol = ~WIZARD_MINOR_SEQUENCER~ label = ~Minor Sequencer~ END
END

// --- Teleport Field (row arcane.level4.teleport_field) --------------------------------
// Range 30 ft (from 40 ft) and Save vs. Spell at -4 instead of no save.
DEFINE_ACTION_FUNCTION cbmagic_kept_teleport_field
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~WIZARD_TELEPORT_FIELD~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Teleport Field (WIZARD_TELEPORT_FIELD) is not in this game; left out.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: Teleport Field (%spell%) left as it is: %reason%.~
      END ELSE BEGIN
        READ_LONG 0x64 ab_off
        READ_SHORT 0x68 ab_cnt
        READ_LONG 0x6a fx_off
        SET has_222 = 0
        FOR (a = 0; a < ab_cnt; ++a) BEGIN
          READ_SHORT (ab_off + a * 0x28 + 0x1e) n
          READ_SHORT (ab_off + a * 0x28 + 0x20) first
          FOR (i = 0; i < n; ++i) BEGIN
            SET fx = fx_off + (first + i) * 0x30
            READ_SHORT fx op
            PATCH_IF (op = 222) BEGIN SET has_222 = 1 END
          END
        END
        PATCH_IF !has_222 BEGIN
          PATCH_WARN ~chriz-bg-magic: Teleport Field (%spell%) left as it is: no teleport field effect (opcode 222).~
        END ELSE BEGIN
          FOR (a = 0; a < ab_cnt; ++a) BEGIN
            READ_SHORT (ab_off + a * 0x28 + 0x0e) rng
            PATCH_IF (rng != 30) BEGIN
              WRITE_SHORT (ab_off + a * 0x28 + 0x0e) 30
              SET changed += 1
            END
            READ_SHORT (ab_off + a * 0x28 + 0x1e) n
            READ_SHORT (ab_off + a * 0x28 + 0x20) first
            FOR (i = 0; i < n; ++i) BEGIN
              SET fx = fx_off + (first + i) * 0x30
              READ_BYTE (fx + 0x02) target
              READ_LONG (fx + 0x24) save
              READ_SLONG (fx + 0x28) bonus
              PATCH_IF (target = 2) BEGIN
                PATCH_IF ((save BAND 1) = 0) OR (bonus != (0 - 4)) BEGIN
                  WRITE_LONG (fx + 0x24) ((save BAND (BNOT 0x1f)) BOR 1)
                  WRITE_LONG (fx + 0x28) (0 - 4)
                  SET changed += 1
                END
              END
            END
          END
          PATCH_IF (changed > 0) BEGIN
            PATCH_PRINT ~chriz-bg-magic: Teleport Field (%spell%): range 30 and Save vs. Spell at -4.~
          END ELSE BEGIN
            PATCH_PRINT ~chriz-bg-magic: Teleport Field (%spell%): range 30 and Save vs. Spell at -4 already.~
          END
        END
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Teleport Field~ END
      OUTER_SPRINT f0 @40077
      OUTER_SPRINT r0 @40078
      OUTER_SPRINT f1 @40015
      OUTER_SPRINT r1 @40016
      OUTER_SPRINT f2 @40017
      OUTER_SPRINT r2 @40018
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f0%~ replace = EVAL ~%r0%~ label = ~Teleport Field~ END
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f1%~ replace = EVAL ~%r1%~ label = ~Teleport Field~ END
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%f2%~ replace = EVAL ~%r2%~ label = ~Teleport Field~ END
    END
  END
END

// --- Oracle (row arcane.level5.oracle) ------------------------------------------------
// Dispels illusion spells up to 9th level (from 5th), range 1, 30-ft (radius 450)
// enemy-only area projectile of our own (cbmoracl.pro via ADD_PROJECTILE).
DEFINE_ACTION_FUNCTION cbmagic_kept_oracle
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~WIZARD_ORACLE~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Oracle (WIZARD_ORACLE) is not in this game; left out.~
  END ELSE BEGIN
    OUTER_SET proj_id = IDS_OF_SYMBOL (~projectl~ ~cbmoracl~)
    ACTION_IF (proj_id >= 0) BEGIN
      OUTER_SET proj_id += 1
    END ELSE BEGIN
      OUTER_SET can_add_proj = 0
      ACTION_IF (FILE_EXISTS_IN_GAME ~projectl.ids~) BEGIN
        COPY_EXISTING - ~projectl.ids~ ~override~
          PATCH_IF (INDEX_BUFFER (~[0-9]~ 8) >= 0) BEGIN
            SET can_add_proj = 1
          END
      END
      ACTION_IF can_add_proj BEGIN
        ACTION_IF (FILE_EXISTS_IN_GAME ~bignarea.pro~) BEGIN
          COPY_EXISTING - ~bignarea.pro~ ~weidu_external/cbmoracl.pro~
            WRITE_SHORT 0x200 0x40
            WRITE_SHORT 0x204 450
            WRITE_SHORT 0x206 450
        END ELSE BEGIN
          COPY - ~chriz-bg-magic/lib/cbmagic_shared.tpa~ ~weidu_external/cbmoracl.pro~
            DELETE_BYTES 0 BUFFER_LENGTH
            INSERT_BYTES 0 0x300
            WRITE_ASCII 0 ~PRO V1.0~ (8)
            WRITE_SHORT 0x08 3
            WRITE_SHORT 0x0a 40
            WRITE_LONG 0x0c 2
            WRITE_SHORT 0x28 2
            WRITE_SHORT 0x200 0x40
            WRITE_SHORT 0x202 0
            WRITE_SHORT 0x204 450
            WRITE_SHORT 0x206 450
            WRITE_SHORT 0x210 100
            WRITE_SHORT 0x214 0
            WRITE_BYTE 0x216 1
            WRITE_BYTE 0x217 255
            WRITE_SHORT 0x218 67
            WRITE_SHORT 0x21a 1
        END
        ADD_PROJECTILE ~weidu_external/cbmoracl.pro~
        OUTER_SET proj_id = cbmoracl
      END ELSE BEGIN
        OUTER_SET proj_id = 338
      END
    END
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: Oracle (%spell%) left as it is: %reason%.~
      END ELSE BEGIN
        READ_LONG 0x64 ab_off
        READ_SHORT 0x68 ab_cnt
        READ_LONG 0x6a fx_off
        SET has_disp = 0
        FOR (a = 0; a < ab_cnt; ++a) BEGIN
          READ_SHORT (ab_off + a * 0x28 + 0x1e) n
          READ_SHORT (ab_off + a * 0x28 + 0x20) first
          FOR (i = 0; i < n; ++i) BEGIN
            SET fx = fx_off + (first + i) * 0x30
            READ_SHORT fx op
            PATCH_IF (op = 220) OR (op = 221) BEGIN SET has_disp = 1 END
          END
        END
        PATCH_IF !has_disp BEGIN
          PATCH_WARN ~chriz-bg-magic: Oracle (%spell%) left as it is: no school/secondary-type removal effect (opcode 220 or 221).~
        END ELSE BEGIN
          FOR (a = 0; a < ab_cnt; ++a) BEGIN
            READ_SHORT (ab_off + a * 0x28 + 0x0e) rng
            READ_SHORT (ab_off + a * 0x28 + 0x26) proj
            PATCH_IF (rng != 1) BEGIN
              WRITE_SHORT (ab_off + a * 0x28 + 0x0e) 1
              SET changed += 1
            END
            PATCH_IF (proj != proj_id) BEGIN
              WRITE_SHORT (ab_off + a * 0x28 + 0x26) proj_id
              SET changed += 1
            END
            READ_SHORT (ab_off + a * 0x28 + 0x1e) n
            READ_SHORT (ab_off + a * 0x28 + 0x20) first
            FOR (i = 0; i < n; ++i) BEGIN
              SET fx = fx_off + (first + i) * 0x30
              READ_SHORT fx op
              READ_LONG (fx + 0x04) p1
              READ_LONG (fx + 0x08) p2
              PATCH_IF ((op = 220) AND (p2 = 5)) OR ((op = 221) AND (p2 = 3)) BEGIN
                PATCH_IF (p1 != 9) BEGIN
                  WRITE_LONG (fx + 0x04) 9
                  SET changed += 1
                END
              END
            END
          END
          PATCH_IF (changed > 0) BEGIN
            PATCH_PRINT ~chriz-bg-magic: Oracle (%spell%): dispels up to level 9, range 1, enemy-only 30-ft projectile %proj_id%.~
          END ELSE BEGIN
            PATCH_PRINT ~chriz-bg-magic: Oracle (%spell%): dispels up to level 9 in a 30-ft radius already.~
          END
        END
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Oracle~ END
      OUTER_SPRINT f1 @40019
      OUTER_SPRINT r1 @40020
      OUTER_SPRINT f2 @40021
      OUTER_SPRINT r2 @40022
      OUTER_SPRINT f3 @40079
      OUTER_SPRINT r3 @40080
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f1%~ replace = EVAL ~%r1%~ label = ~Oracle~ END
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f3%~ replace = EVAL ~%r3%~ label = ~Oracle~ END
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%f2%~ replace = EVAL ~%r2%~ label = ~Oracle~ END
    END
  END
END

// --- Contingency (row arcane.level6.contingency) --------------------------------------
DEFINE_ACTION_FUNCTION cbmagic_kept_contingency
BEGIN
  LAF cbmagic_make_universal_school STR_VAR symbol = ~WIZARD_CONTINGENCY~ label = ~Contingency~ END
END

// --- Sphere of Chaos (row arcane.level7.chaos) ----------------------------------------
// Keeps vanilla's name, level 7, and 10-round enemy-only aura projectile (PFIELD). Each
// round, enemies in the area save vs. Spell at -4 or suffer one of 5 random effects for
// 1 round (6s): feeblemind (20%), confusion (20%), panic (20%), sleep waking on damage
// (20%), or hold (20%).
DEFINE_ACTION_FUNCTION cbmagic_kept_sphere_of_chaos
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~WIZARD_SPHERE_OF_CHAOS~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Sphere of Chaos (WIZARD_SPHERE_OF_CHAOS) is not in this game; left out.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: Sphere of Chaos (%spell%) left as it is: %reason%.~
      END ELSE BEGIN
        READ_LONG 0x64 ab_off
        READ_SHORT 0x68 ab_cnt
        READ_LONG 0x6a fx_off
        PATCH_IF (ab_cnt < 1) BEGIN
          PATCH_WARN ~chriz-bg-magic: Sphere of Chaos (%spell%) left as it is: it has no abilities.~
        END ELSE BEGIN
          SET recognizable = 0
          SET all_already = 1
          FOR (a = 0; a < ab_cnt; ++a) BEGIN
            READ_SHORT (ab_off + a * 0x28 + 0x1e) n
            READ_SHORT (ab_off + a * 0x28 + 0x20) first
            SET c_76 = 0
            SET c_128 = 0
            SET c_24 = 0
            SET c_39 = 0
            SET c_175 = 0
            SET c_sleep_icon = 0
            SET c_old = 0
            FOR (i = 0; i < n; ++i) BEGIN
              SET fx = fx_off + (first + i) * 0x30
              READ_SHORT fx op
              READ_LONG (fx + 0x08) p2
              READ_LONG (fx + 0x0e) dur
              READ_BYTE (fx + 0x12) p1_prob
              READ_BYTE (fx + 0x13) p2_prob
              READ_LONG (fx + 0x24) save
              READ_SLONG (fx + 0x28) bonus
              PATCH_IF (p1_prob < 100) OR (p2_prob > 0) OR (op = 128) OR (op = 39) OR (op = 13) OR (op = 76) BEGIN
                SET recognizable = 1
              END
              PATCH_IF (op = 13) OR (op = 16) OR (op = 17) OR (op = 111) OR (op = 12)
                    OR (op = 109) OR (op = 238) OR (op = 222) OR (op = 172) BEGIN
                SET c_old = 1
              END
              PATCH_IF (op = 76) AND (dur = 6) AND (p1_prob = 20) AND (p2_prob = 0) AND ((save BAND 1) != 0) AND (bonus = (0 - 4)) BEGIN
                SET c_76 = 1
              END
              PATCH_IF (op = 128) AND (dur = 6) AND (p1_prob = 40) AND (p2_prob = 21) AND ((save BAND 1) != 0) AND (bonus = (0 - 4)) BEGIN
                SET c_128 = 1
              END
              PATCH_IF (op = 24) AND (dur = 6) AND (p1_prob = 60) AND (p2_prob = 41) AND ((save BAND 1) != 0) AND (bonus = (0 - 4)) BEGIN
                SET c_24 = 1
              END
              PATCH_IF (op = 39) AND (p2 = 0) AND (dur = 6) AND (p1_prob = 80) AND (p2_prob = 61) AND ((save BAND 1) != 0) AND (bonus = (0 - 4)) BEGIN
                SET c_39 = 1
              END
              PATCH_IF (op = 142) AND (p2 = 14) AND (p1_prob = 80) AND (p2_prob = 61) BEGIN
                SET c_sleep_icon = 1
              END
              PATCH_IF (op = 175) AND (dur = 6) AND (p1_prob = 100) AND (p2_prob = 81) AND ((save BAND 1) != 0) AND (bonus = (0 - 4)) BEGIN
                SET c_175 = 1
              END
            END
            PATCH_IF !(c_76 AND c_128 AND c_24 AND c_39 AND c_175 AND !c_sleep_icon AND !c_old) BEGIN
              SET all_already = 0
            END
          END
          PATCH_IF !recognizable BEGIN
            PATCH_WARN ~chriz-bg-magic: Sphere of Chaos (%spell%) left as it is: no random chaos effects found.~
          END ELSE PATCH_IF all_already BEGIN
            PATCH_PRINT ~chriz-bg-magic: Sphere of Chaos (%spell%): 5-outcome table present already.~
          END ELSE BEGIN
            FOR (a = 0; a < ab_cnt; ++a) BEGIN
              // Delete only the old random-outcome effects (prob1 < 100 or prob2 > 0) and old
              // outcome opcodes (111, 128, 12, 109, 238, 17, 39, 222, 16, 13, 172, 76, 24, 175),
              // preserving shared hit visuals/sounds (op 141, 61, 174) and any unrelated 100..0 effects.
              SET scanning = 1
              WHILE scanning BEGIN
                SET scanning = 0
                READ_LONG 0x64 ab_off
                READ_LONG 0x6a fx_off
                READ_SHORT (ab_off + a * 0x28 + 0x1e) n
                READ_SHORT (ab_off + a * 0x28 + 0x20) first
                FOR (i = 0; (i < n) AND !scanning; ++i) BEGIN
                  SET fx = fx_off + (first + i) * 0x30
                  READ_SHORT fx op
                  READ_BYTE (fx + 0x12) p1_prob
                  READ_BYTE (fx + 0x13) p2_prob
                  PATCH_IF (p1_prob < 100) OR (p2_prob > 0)
                        OR (op = 111) OR (op = 128) OR (op = 12) OR (op = 109)
                        OR (op = 238) OR (op = 17) OR (op = 39) OR (op = 222)
                        OR (op = 16) OR (op = 13) OR (op = 172)
                        OR (op = 76) OR (op = 24) OR (op = 175) BEGIN
                    LPF cbmagic_delete_effect INT_VAR index = (first + i) END
                    SET scanning = 1
                  END
                END
              END
              // Update shared hit visual/sound companions (op 141, 61, 174) in ability a to Save vs. Spell at -4.
              READ_LONG 0x64 ab_off
              READ_LONG 0x6a fx_off
              READ_SHORT (ab_off + a * 0x28 + 0x1e) n
              READ_SHORT (ab_off + a * 0x28 + 0x20) first
              FOR (i = 0; i < n; ++i) BEGIN
                SET fx = fx_off + (first + i) * 0x30
                READ_SHORT fx op
                PATCH_IF (op = 141) OR (op = 61) OR (op = 174) BEGIN
                  WRITE_LONG (fx + 0x24) 1
                  WRITE_LONG (fx + 0x28) (0 - 4)
                END
              END
              // Append the 5 random outcomes (20% each, Save vs. Spell at -4, 6s duration).
              // 1. 0..20: Feeblemind (op 76 + icon 48)
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 76 target = 2 power = 7
                timing = 0 resist_dispel = 1 duration = 6 probability1 = 20 probability2 = 0
                savingthrow = 1 savebonus = (0 - 4) END
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 142 target = 2 power = 7
                parameter2 = 48 timing = 0 resist_dispel = 1 duration = 6 probability1 = 20 probability2 = 0
                savingthrow = 1 savebonus = (0 - 4) END
              // 2. 21..40: Confusion (op 128 + string 14782 + icon 3 + SPCONFUS)
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 128 target = 2 power = 7
                timing = 0 resist_dispel = 1 duration = 6 probability1 = 40 probability2 = 21
                savingthrow = 1 savebonus = (0 - 4) END
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 139 target = 2 power = 7
                parameter1 = 14782 timing = 1 resist_dispel = 1 duration = 0 probability1 = 40 probability2 = 21
                savingthrow = 1 savebonus = (0 - 4) END
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 142 target = 2 power = 7
                parameter2 = 3 timing = 0 resist_dispel = 1 duration = 6 probability1 = 40 probability2 = 21
                savingthrow = 1 savebonus = (0 - 4) END
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 215 target = 2 power = 7
                parameter2 = 1 timing = 0 resist_dispel = 1 duration = 6 probability1 = 40 probability2 = 21
                savingthrow = 1 savebonus = (0 - 4) STR_VAR resource = ~SPCONFUS~ END
              // 3. 41..60: Panic (op 24 + string 14007 + icon 36)
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 24 target = 2 power = 7
                timing = 0 resist_dispel = 1 duration = 6 probability1 = 60 probability2 = 41
                savingthrow = 1 savebonus = (0 - 4) END
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 139 target = 2 power = 7
                parameter1 = 14007 timing = 1 resist_dispel = 1 duration = 0 probability1 = 60 probability2 = 41
                savingthrow = 1 savebonus = (0 - 4) END
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 142 target = 2 power = 7
                parameter2 = 36 timing = 0 resist_dispel = 1 duration = 6 probability1 = 60 probability2 = 41
                savingthrow = 1 savebonus = (0 - 4) END
              // 4. 61..80: Sleep waking on damage (op 39 p2=0 + icon 14)
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 39 target = 2 power = 7
                parameter2 = 0 timing = 0 resist_dispel = 1 duration = 6 probability1 = 80 probability2 = 61
                savingthrow = 1 savebonus = (0 - 4) END
              // 5. 81..100: Hold (op 175 p2=2 + icon 13 + string 14102)
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 175 target = 2 power = 7
                parameter2 = 2 timing = 0 resist_dispel = 1 duration = 6 probability1 = 100 probability2 = 81
                savingthrow = 1 savebonus = (0 - 4) END
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 142 target = 2 power = 7
                parameter2 = 13 timing = 0 resist_dispel = 1 duration = 6 probability1 = 100 probability2 = 81
                savingthrow = 1 savebonus = (0 - 4) END
              LPF cbmagic_insert_effect INT_VAR ability = a position = 999 opcode = 139 target = 2 power = 7
                parameter1 = 14102 timing = 1 resist_dispel = 1 duration = 0 probability1 = 100 probability2 = 81
                savingthrow = 1 savebonus = (0 - 4) END
            END
            SET changed = 1
            PATCH_PRINT ~chriz-bg-magic: Sphere of Chaos (%spell%): updated to 5-outcome table (1 round, Save vs. Spell at -4).~
          END
        END
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Sphere of Chaos~ END
      OUTER_SPRINT cbm_find @40023
      OUTER_SPRINT cbm_replace @40024
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%cbm_find%~ replace = EVAL ~%cbm_replace%~ label = ~Sphere of Chaos~ END
    END
  END
END

