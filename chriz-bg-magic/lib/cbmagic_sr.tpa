DEFINE_ACTION_FUNCTION cbmagic_kept_spell_sequencer
BEGIN
  LAF cbmagic_make_universal_school STR_VAR symbol = ~WIZARD_SPELL_SEQUENCER~ label = ~Spell Sequencer~ END
END

