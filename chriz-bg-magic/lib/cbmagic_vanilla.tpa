// Row divine.entangle: save vs. breath (+3 bonus kept), and flying, incorporeal, elemental
// and giant/dragon creatures are immune.
DEFINE_ACTION_FUNCTION cbmagic_vanilla_entangle
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_ENTANGLE~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Entangle (CLERIC_ENTANGLE) is not in this game; skipped.~
  END ELSE BEGIN
    LAF cbmagic_splprot_row INT_VAR stat = 0x10c value = (0 - 1) relation = 1 RET race_row = row END
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF valid BEGIN
        LPF cbmagic_save_spell_to_breath INT_VAR anchor_opcode = 154 RET changed = anchors already others END
        PATCH_IF (changed = 0) AND (already = 0) BEGIN
          PATCH_WARN ~chriz-bg-magic: Entangle (%spell%): no entangle effect (opcode 154) with a save vs. spell; its save was left as it is.~
        END ELSE BEGIN
          PATCH_PRINT ~chriz-bg-magic: Entangle (%spell%): %changed% entangle effects now save vs. breath (%others% effects of the same roll with them); %already% did already.~
        END
        PATCH_FOR_EACH race IN
          WYVERN BEHOLDER MEPHIT SPECTRE WRAITH SHADOW MIST ELEMENTAL GIANT ETTIN DRAGON
        BEGIN
          SET value = IDS_OF_SYMBOL (~race~ ~%race%~)
          PATCH_IF (value < 0) BEGIN
            PATCH_WARN ~chriz-bg-magic: Entangle (%spell%): RACE.IDS has no %race%; that immunity is left out.~
          END ELSE BEGIN
            LPF cbmagic_add_immunity INT_VAR row = race_row value RET added present END
            PATCH_PRINT ~chriz-bg-magic: Entangle (%spell%): race %race% (%value%) immune in %added% abilities; %present% were already.~
          END
        END
      END ELSE BEGIN
        PATCH_WARN ~chriz-bg-magic: Entangle (%spell%) left as it is: %reason%.~
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Entangle~ END
      OUTER_SPRINT cbm_find @20010
      OUTER_SPRINT cbm_replace @20011
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%cbm_find%~ replace = EVAL ~%cbm_replace%~ label = ~Entangle~ END
    END
  END
END

// Row divine.flame_blade: druid-only, and its blade counts as a magical weapon.
DEFINE_ACTION_FUNCTION cbmagic_vanilla_flame_blade
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_FLAME_BLADE~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Flame Blade (CLERIC_FLAME_BLADE) is not in this game; skipped.~
  END ELSE BEGIN
    OUTER_SPRINT weapon_res ~~
    OUTER_SET spl_changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF valid BEGIN
        LPF cbmagic_set_priest_druid_only RET spl_changed = changed already END
        PATCH_IF (spl_changed > 0) BEGIN
          PATCH_PRINT ~chriz-bg-magic: Flame Blade (%spell%): restricted to druids/rangers.~
        END ELSE BEGIN
          PATCH_PRINT ~chriz-bg-magic: Flame Blade (%spell%): restricted to druids/rangers already.~
        END
        READ_LONG 0x64 ab_off
        READ_SHORT 0x68 ab_cnt
        READ_LONG 0x6a fx_off
        FOR (a = 0; a < ab_cnt; ++a) BEGIN
          READ_SHORT (ab_off + a * 0x28 + 0x1e) n
          READ_SHORT (ab_off + a * 0x28 + 0x20) first
          FOR (i = 0; i < n; ++i) BEGIN
            SET fx = fx_off + (first + i) * 0x30
            READ_SHORT fx op
            READ_ASCII (fx + 0x14) res (8) NULL
            PATCH_IF (op = 111) AND (~%weapon_res%~ STRING_EQUAL ~~) AND !(~%res%~ STRING_EQUAL ~~) BEGIN
              SPRINT weapon_res ~%res%~
            END
          END
        END
      END ELSE BEGIN
        PATCH_WARN ~chriz-bg-magic: Flame Blade (%spell%) left as it is: %reason%.~
      END
    BUT_ONLY
    ACTION_IF (~%weapon_res%~ STRING_EQUAL ~~) BEGIN
      OUTER_SPRINT weapon_res ~FBLADE~
    END
    OUTER_SET itm_changed = 0
    ACTION_IF !(FILE_EXISTS_IN_GAME ~%weapon_res%.itm~) BEGIN
      WARN ~chriz-bg-magic: Flame Blade (%spell%): weapon item %weapon_res%.itm is not in this game; left out.~
    END ELSE BEGIN
      COPY_EXISTING ~%weapon_res%.itm~ ~override~
        PATCH_IF (BUFFER_LENGTH < 0x72) BEGIN
          PATCH_WARN ~chriz-bg-magic: Flame Blade item (%weapon_res%) left as it is: shorter than an ITM header.~
        END ELSE BEGIN
          READ_ASCII 0 sig (8)
          PATCH_IF !(~%sig%~ STRING_EQUAL ~ITM V1  ~) BEGIN
            PATCH_WARN ~chriz-bg-magic: Flame Blade item (%weapon_res%) left as it is: not an ITM V1 file.~
          END ELSE BEGIN
            READ_LONG 0x18 flags
            READ_LONG 0x60 ench
            SET new_flags = flags BOR 0x40
            SET new_ench = (ench < 1) ? 1 : ench
            PATCH_IF (flags = new_flags) AND (ench = new_ench) BEGIN
              PATCH_PRINT ~chriz-bg-magic: Flame Blade item (%weapon_res%): magical weapon already.~
            END ELSE BEGIN
              WRITE_LONG 0x18 new_flags
              WRITE_LONG 0x60 new_ench
              SET itm_changed = 1
              PATCH_PRINT ~chriz-bg-magic: Flame Blade item (%weapon_res%): flagged as a magical weapon (enchantment %new_ench%).~
            END
          END
        END
      BUT_ONLY
    END
    ACTION_IF (itm_changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Flame Blade~ END
      OUTER_SPRINT cbm_find @20012
      OUTER_SPRINT cbm_replace @20013
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%cbm_find%~ replace = EVAL ~%cbm_replace%~ label = ~Flame Blade~ END
    END
  END
END

