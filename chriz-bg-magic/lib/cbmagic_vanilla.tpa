// Vanilla-batch changes of chriz-bg-magic, one action function per decided change.
// Included and called by setup-chriz-bg-magic.tp2 in component 0.

// --- Patch helpers used by the vanilla batch -------------------------------------------

DEFINE_PATCH_FUNCTION cbmagic_set_school
  INT_VAR target_school = 0 target_excl = 0
  RET changed already
BEGIN
  SET changed = 0
  SET already = 0
  READ_SHORT 0x1e excl
  READ_BYTE 0x25 school
  SET new_excl = (excl BAND 0xc03f) BOR target_excl
  PATCH_IF (excl = new_excl) AND (school = target_school) BEGIN
    SET already = 1
  END ELSE BEGIN
    WRITE_SHORT 0x1e new_excl
    WRITE_BYTE 0x25 target_school
    SET changed = 1
  END
END

DEFINE_PATCH_FUNCTION cbmagic_set_priest_druid_only
  RET changed already
BEGIN
  SET changed = 0
  SET already = 0
  READ_SHORT 0x20 w20
  SET new_w20 = (w20 BAND 0x3fff) BOR 0x4000
  PATCH_IF (w20 = new_w20) BEGIN
    SET already = 1
  END ELSE BEGIN
    WRITE_SHORT 0x20 new_w20
    SET changed = 1
  END
END

DEFINE_PATCH_FUNCTION cbmagic_set_casting_time
  INT_VAR target_ct = 0
  RET changed already
BEGIN
  SET changed = 0
  SET already = 0
  READ_LONG 0x64 ab_off
  READ_SHORT 0x68 ab_cnt
  FOR (a = 0; a < ab_cnt; ++a) BEGIN
    READ_SHORT (ab_off + a * 0x28 + 0x12) ct
    PATCH_IF (ct > target_ct) BEGIN
      WRITE_SHORT (ab_off + a * 0x28 + 0x12) target_ct
      SET changed += 1
    END ELSE BEGIN
      SET already += 1
    END
  END
END

DEFINE_PATCH_FUNCTION cbmagic_scale_blindness_duration
  RET changed already missing
BEGIN
  SET changed = 0
  SET already = 0
  SET missing = 0
  READ_LONG 0x64 ab_off
  READ_SHORT 0x68 ab_cnt
  READ_LONG 0x6a fx_off
  PATCH_IF (ab_cnt = 0) BEGIN
    SET missing = 1
  END ELSE BEGIN
    FOR (a = 0; a < ab_cnt; ++a) BEGIN
      READ_SHORT (ab_off + a * 0x28 + 0x1e) n
      READ_SHORT (ab_off + a * 0x28 + 0x20) first
      SET has_blind = 0
      FOR (i = 0; i < n; ++i) BEGIN
        READ_SHORT (fx_off + (first + i) * 0x30) op
        PATCH_IF (op = 74) BEGIN
          SET has_blind = 1
        END
      END
      PATCH_IF !has_blind BEGIN
        SET missing += 1
      END
    END
  END
  PATCH_IF (missing = 0) BEGIN
    PATCH_IF (ab_cnt = 1) BEGIN
      READ_ASCII ab_off ab0_hdr (0x28)
      READ_SHORT (ab_off + 0x1e) ab0_n
      FOR (k = 1; k <= 3; ++k) BEGIN
        SET lvl = (k = 1) ? 6 : ((k = 2) ? 8 : 10)
        READ_LONG 0x64 ab_off
        READ_SHORT 0x68 cur_cnt
        READ_LONG 0x6a fx_off
        READ_SHORT (ab_off + (k - 1) * 0x28 + 0x1e) prev_n
        READ_SHORT (ab_off + (k - 1) * 0x28 + 0x20) prev_first
        SET ins_ab = ab_off + k * 0x28
        INSERT_BYTES ins_ab 0x28
        WRITE_ASCIIE ins_ab ~%ab0_hdr%~ #40
        WRITE_SHORT (ins_ab + 0x10) lvl
        WRITE_SHORT (ins_ab + 0x1e) 0
        WRITE_SHORT (ins_ab + 0x20) (prev_first + prev_n)
        PATCH_IF (fx_off >= ins_ab) BEGIN
          SET fx_off += 0x28
          WRITE_LONG 0x6a fx_off
        END
        WRITE_SHORT 0x68 (cur_cnt + 1)
        FOR (i = 0; i < ab0_n; ++i) BEGIN
          READ_LONG 0x64 ab_off
          READ_LONG 0x6a fx_off
          READ_SHORT (ab_off + 0x20) cur_ab0_first
          READ_ASCII (fx_off + (cur_ab0_first + i) * 0x30) fx_bytes (0x30)
          LPF cbmagic_insert_effect INT_VAR ability = k position = i END
          READ_LONG 0x64 ab_off
          READ_LONG 0x6a fx_off
          READ_SHORT (ab_off + k * 0x28 + 0x20) new_first
          WRITE_ASCIIE (fx_off + (new_first + i) * 0x30) ~%fx_bytes%~ #48
        END
      END
      SET changed += 1
    END
    READ_LONG 0x64 ab_off
    READ_SHORT 0x68 ab_cnt
    READ_LONG 0x6a fx_off
    FOR (a = 0; a < ab_cnt; ++a) BEGIN
      READ_SHORT (ab_off + a * 0x28 + 0x10) min_lvl
      READ_SHORT (ab_off + a * 0x28 + 0x1e) n
      READ_SHORT (ab_off + a * 0x28 + 0x20) first
      SET target_dur = (min_lvl >= 10) ? 30 : ((min_lvl >= 8) ? 24 : ((min_lvl >= 6) ? 18 : 12))
      SET blind_dur = 0 - 1
      FOR (i = 0; i < n; ++i) BEGIN
        SET fx = fx_off + (first + i) * 0x30
        READ_SHORT fx op
        READ_LONG (fx + 0x0e) dur
        PATCH_IF (op = 74) AND (blind_dur < 0) BEGIN
          SET blind_dur = dur
        END
      END
      PATCH_IF (blind_dur = target_dur) BEGIN
        SET already += 1
      END ELSE BEGIN
        FOR (i = 0; i < n; ++i) BEGIN
          SET fx = fx_off + (first + i) * 0x30
          READ_SHORT fx op
          READ_LONG (fx + 0x0e) dur
          PATCH_IF (op = 74) OR ((dur = blind_dur) AND (dur > 3)) BEGIN
            WRITE_LONG (fx + 0x0e) target_dur
          END
        END
        SET changed += 1
      END
    END
  END
END

DEFINE_PATCH_FUNCTION cbmagic_save_to_death_no_penalty
  INT_VAR anchor_opcode = 55
  RET anchors already others
BEGIN
  SET anchors = 0
  SET already = 0
  SET others = 0
  READ_LONG 0x64 ab_off
  READ_SHORT 0x68 ab_cnt
  READ_LONG 0x6a fx_off
  FOR (a = 0; a < ab_cnt; ++a) BEGIN
    READ_SHORT (ab_off + a * 0x28 + 0x1e) n
    READ_SHORT (ab_off + a * 0x28 + 0x20) first
    SPRINT groups ~ ~
    FOR (i = 0; i < n; ++i) BEGIN
      SET fx = fx_off + (first + i) * 0x30
      READ_SHORT fx op
      READ_LONG (fx + 0x24) save
      READ_SLONG (fx + 0x28) bonus
      PATCH_IF (op = anchor_opcode) BEGIN
        PATCH_IF ((save BAND 4) != 0) AND ((save BAND 0x1b) = 0) AND (bonus = 0) BEGIN
          SET already += 1
        END ELSE PATCH_IF ((save BAND 0x1f) != 0) BEGIN
          SET key = save BAND 0x1f
          PATCH_IF (INDEX (CASE_SENSITIVE EXACT_MATCH ~ %key%:%bonus% ~ ~%groups%~) < 0) BEGIN
            SPRINT groups ~%groups%%key%:%bonus% ~
          END
        END
      END
    END
    FOR (i = 0; i < n; ++i) BEGIN
      SET fx = fx_off + (first + i) * 0x30
      READ_SHORT fx op
      READ_LONG (fx + 0x24) save
      READ_SLONG (fx + 0x28) bonus
      SET key = save BAND 0x1f
      PATCH_IF (key != 0) AND (INDEX (CASE_SENSITIVE EXACT_MATCH ~ %key%:%bonus% ~ ~%groups%~) >= 0) BEGIN
        WRITE_LONG (fx + 0x24) ((save BAND (BNOT 0x1f)) BOR 4)
        WRITE_LONG (fx + 0x28) 0
        PATCH_IF (op = anchor_opcode) BEGIN
          SET anchors += 1
        END ELSE BEGIN
          SET others += 1
        END
      END
    END
  END
END

DEFINE_PATCH_FUNCTION cbmagic_add_disintegrate_sword
  INT_VAR sword_race = 201 race_row = 104
  RET added present has_disintegrate
BEGIN
  SET added = 0
  SET present = 0
  SET has_disintegrate = 0
  SPRINT self ~%SOURCE_RES%~
  READ_LONG 0x34 level
  READ_SHORT 0x68 ab_cnt
  FOR (a = 0; a < ab_cnt; ++a) BEGIN
    READ_LONG 0x64 ab_off
    READ_LONG 0x6a fx_off
    READ_SHORT (ab_off + a * 0x28 + 0x1e) n
    READ_SHORT (ab_off + a * 0x28 + 0x20) first
    SET has_238 = 0
    SET has_177 = 0
    FOR (i = 0; i < n; ++i) BEGIN
      SET fx = fx_off + (first + i) * 0x30
      READ_SHORT fx op
      READ_LONG (fx + 0x04) p1
      READ_LONG (fx + 0x08) p2
      READ_ASCII (fx + 0x14) res (8) NULL
      PATCH_IF (op = 238) BEGIN
        SET has_238 = 1
      END
      PATCH_IF (op = 177) AND (p1 = sword_race) AND (p2 = 4) AND (~%res%~ STRING_EQUAL_CASE ~DESTSELF~) BEGIN
        SET has_177 = 1
      END
    END
    PATCH_IF has_238 BEGIN
      SET has_disintegrate += 1
      PATCH_IF has_177 BEGIN
        SET present += 1
      END ELSE BEGIN
        LPF cbmagic_insert_effect INT_VAR ability = a position = 0 opcode = 318 target = 2 power = level
          parameter1 = sword_race parameter2 = race_row timing = 0 duration = 1 resist_dispel = 2
          STR_VAR resource = EVAL ~%self%~ END
        LPF cbmagic_insert_effect INT_VAR ability = a position = 0 opcode = 177 target = 2 power = level
          parameter1 = sword_race parameter2 = 4 timing = 1 duration = 0 resist_dispel = 2
          STR_VAR resource = ~DESTSELF~ END
        SET added += 1
      END
    END
  END
END

DEFINE_PATCH_FUNCTION cbmagic_scale_elemental_chances
  INT_VAR is_druid = 0
  RET changed already missing
BEGIN
  SET changed = 0
  SET already = 0
  SET missing = 0
  READ_LONG 0x64 ab_off
  READ_SHORT 0x68 ab_cnt
  READ_LONG 0x6a fx_off
  PATCH_IF (ab_cnt = 0) BEGIN
    SET missing = 1
  END
  FOR (a = 0; a < ab_cnt; ++a) BEGIN
    READ_SHORT (ab_off + a * 0x28 + 0x10) min_lvl
    READ_SHORT (ab_off + a * 0x28 + 0x1e) n
    READ_SHORT (ab_off + a * 0x28 + 0x20) first
    PATCH_IF !is_druid BEGIN
      SET lvl = (min_lvl < 12) ? 12 : ((min_lvl > 20) ? 20 : min_lvl)
      SET c24 = 1 + (lvl - 12)
      SET c16 = 35
      SET c12 = 100 - c16 - c24
    END ELSE BEGIN
      PATCH_IF (a = 0) AND (min_lvl = 1) AND (ab_cnt > 1) BEGIN
        READ_SHORT (ab_off + 0x28 + 0x10) next_min_lvl
        SET lvl = next_min_lvl - 1
      END ELSE BEGIN
        SET lvl = min_lvl
      END
      SET lvl = (lvl < 11) ? 11 : ((lvl > 20) ? 20 : lvl)
      SET c12 = 64 - 3 * (lvl - 11)
      PATCH_IF (lvl = 11) BEGIN SET c16 = 35 SET c24 = 1 END
      PATCH_IF (lvl = 12) BEGIN SET c16 = 37 SET c24 = 2 END
      PATCH_IF (lvl = 13) BEGIN SET c16 = 39 SET c24 = 3 END
      PATCH_IF (lvl = 14) BEGIN SET c16 = 40 SET c24 = 5 END
      PATCH_IF (lvl = 15) BEGIN SET c16 = 42 SET c24 = 6 END
      PATCH_IF (lvl = 16) BEGIN SET c16 = 44 SET c24 = 7 END
      PATCH_IF (lvl = 17) BEGIN SET c16 = 46 SET c24 = 8 END
      PATCH_IF (lvl = 18) BEGIN SET c16 = 47 SET c24 = 10 END
      PATCH_IF (lvl = 19) BEGIN SET c16 = 49 SET c24 = 11 END
      PATCH_IF (lvl = 20) BEGIN SET c16 = 51 SET c24 = 12 END
    END
    // Collect the 3 distinct sub-100% probability windows (sorted by prob_lo ascending).
    SET n_win = 0
    FOR (i = 0; i < n; ++i) BEGIN
      SET fx = fx_off + (first + i) * 0x30
      READ_BYTE (fx + 0x12) p_hi
      READ_BYTE (fx + 0x13) p_lo
      PATCH_IF !((p_lo = 0) AND (p_hi = 100)) BEGIN
        SET seen = 0
        FOR (w = 0; w < n_win; ++w) BEGIN
          PATCH_IF ($win_lo(~%w%~) = p_lo) AND ($win_hi(~%w%~) = p_hi) BEGIN
            SET seen = 1
          END
        END
        PATCH_IF (seen = 0) BEGIN
          SET $win_lo(~%n_win%~) = p_lo
          SET $win_hi(~%n_win%~) = p_hi
          SET n_win += 1
        END
      END
    END
    PATCH_IF (n_win != 3) BEGIN
      SET missing += 1
    END ELSE BEGIN
      // Sort the 3 windows by win_lo ascending.
      FOR (w1 = 0; w1 < 2; ++w1) BEGIN
        FOR (w2 = w1 + 1; w2 < 3; ++w2) BEGIN
          PATCH_IF ($win_lo(~%w2%~) < $win_lo(~%w1%~)) BEGIN
            SET tmp_lo = $win_lo(~%w1%~)
            SET tmp_hi = $win_hi(~%w1%~)
            SET $win_lo(~%w1%~) = $win_lo(~%w2%~)
            SET $win_hi(~%w1%~) = $win_hi(~%w2%~)
            SET $win_lo(~%w2%~) = tmp_lo
            SET $win_hi(~%w2%~) = tmp_hi
          END
        END
      END
      SET $new_lo(~0~) = 0
      SET $new_hi(~0~) = c12 - 1
      SET $new_lo(~1~) = c12
      SET $new_hi(~1~) = c12 + c16 - 1
      SET $new_lo(~2~) = c12 + c16
      SET $new_hi(~2~) = 100
      SET ab_changed = 0
      FOR (i = 0; i < n; ++i) BEGIN
        SET fx = fx_off + (first + i) * 0x30
        READ_BYTE (fx + 0x12) p_hi
        READ_BYTE (fx + 0x13) p_lo
        FOR (w = 0; w < 3; ++w) BEGIN
          PATCH_IF (p_lo = $win_lo(~%w%~)) AND (p_hi = $win_hi(~%w%~)) BEGIN
            SET t_lo = $new_lo(~%w%~)
            SET t_hi = $new_hi(~%w%~)
            PATCH_IF (p_lo != t_lo) OR (p_hi != t_hi) BEGIN
              WRITE_BYTE (fx + 0x12) t_hi
              WRITE_BYTE (fx + 0x13) t_lo
              SET ab_changed = 1
            END
            SET w = 3
          END
        END
      END
      PATCH_IF (ab_changed > 0) BEGIN
        SET changed += 1
      END ELSE BEGIN
        SET already += 1
      END
    END
  END
END

// Shared action helper for casting-time reductions.
DEFINE_ACTION_FUNCTION cbmagic_apply_casting_time
  INT_VAR target_ct = 0 old_tra = 0 new_tra = 0
  STR_VAR symbol = ~~ label = ~~
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: %label% (%symbol%) is not in this game; skipped.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    OUTER_SET already = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF valid BEGIN
        LPF cbmagic_set_casting_time INT_VAR target_ct RET changed already END
        PATCH_IF (changed > 0) BEGIN
          PATCH_PRINT ~chriz-bg-magic: %label% (%spell%): casting time set to %target_ct% in %changed% abilities; %already% were already.~
        END ELSE BEGIN
          PATCH_PRINT ~chriz-bg-magic: %label% (%spell%): casting time is %target_ct% (or faster) already.~
        END
      END ELSE BEGIN
        PATCH_WARN ~chriz-bg-magic: %label% (%spell%) left as it is: %reason%.~
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label END
      OUTER_SPRINT cbm_find (AT old_tra)
      OUTER_SPRINT cbm_replace (AT new_tra)
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%cbm_find%~ replace = EVAL ~%cbm_replace%~ label END
    END
  END
END

// Shared action helper for druid-only priest class membership.
DEFINE_ACTION_FUNCTION cbmagic_apply_druid_only
  STR_VAR symbol = ~~ label = ~~
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: %label% (%symbol%) is not in this game; skipped.~
  END ELSE BEGIN
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF valid BEGIN
        LPF cbmagic_set_priest_druid_only RET changed already END
        PATCH_IF (changed > 0) BEGIN
          PATCH_PRINT ~chriz-bg-magic: %label% (%spell%): restricted to druids/rangers.~
        END ELSE BEGIN
          PATCH_PRINT ~chriz-bg-magic: %label% (%spell%): restricted to druids/rangers already.~
        END
      END ELSE BEGIN
        PATCH_WARN ~chriz-bg-magic: %label% (%spell%) left as it is: %reason%.~
      END
    BUT_ONLY
  END
END

// Shared action helper for elemental summoning probability scaling.
DEFINE_ACTION_FUNCTION cbmagic_apply_elemental_scaling
  INT_VAR is_druid = 0
  STR_VAR symbol = ~~ label = ~~
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: %label% (%symbol%) is not in this game; skipped.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    OUTER_SET already = 0
    OUTER_SET missing = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF valid BEGIN
        LPF cbmagic_scale_elemental_chances INT_VAR is_druid RET changed already missing END
        PATCH_IF (missing > 0) BEGIN
          PATCH_WARN ~chriz-bg-magic: %label% (%spell%): %missing% abilities lack the 12/16/24 HD summon effects; left as they are.~
        END ELSE PATCH_IF (changed > 0) BEGIN
          PATCH_PRINT ~chriz-bg-magic: %label% (%spell%): elemental HD chances scaled in %changed% abilities; %already% were already.~
        END ELSE BEGIN
          PATCH_PRINT ~chriz-bg-magic: %label% (%spell%): elemental HD chances scaled already.~
        END
      END ELSE BEGIN
        PATCH_WARN ~chriz-bg-magic: %label% (%spell%) left as it is: %reason%.~
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label END
      OUTER_SPRINT cbm_find @20014
      ACTION_IF is_druid BEGIN
        OUTER_SPRINT cbm_replace @20016
      END ELSE BEGIN
        OUTER_SPRINT cbm_replace @20015
      END
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%cbm_find%~ replace = EVAL ~%cbm_replace%~ label END
    END
  END
END

// --- Decided changes: Group A (schools, durations, saves, items, counters) -------------

// Row arcane.level1.find_familiar: school Universal (accessible to all specialist mages).
DEFINE_ACTION_FUNCTION cbmagic_vanilla_find_familiar_universal
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~WIZARD_FIND_FAMILAR~ RET spell = resref found END
  ACTION_IF !found BEGIN
    LAF cbmagic_spell_resref STR_VAR symbol = ~WIZARD_FIND_FAMILIAR~ RET spell = resref found END
  END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Find Familiar (WIZARD_FIND_FAMILAR) is not in this game; skipped.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF valid BEGIN
        LPF cbmagic_set_school INT_VAR target_school = 0 target_excl = 0 RET changed already END
        PATCH_IF (changed > 0) BEGIN
          PATCH_PRINT ~chriz-bg-magic: Find Familiar (%spell%): school set to Universal.~
        END ELSE BEGIN
          PATCH_PRINT ~chriz-bg-magic: Find Familiar (%spell%): school is Universal already.~
        END
      END ELSE BEGIN
        PATCH_WARN ~chriz-bg-magic: Find Familiar (%spell%) left as it is: %reason%.~
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Find Familiar~ END
      OUTER_SPRINT cbm_find @20000
      OUTER_SPRINT cbm_replace @20001
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%cbm_find%~ replace = EVAL ~%cbm_replace%~ label = ~Find Familiar~ END
    END
  END
END

// Row arcane.level1.obscuring_mist: Blindness stays, duration 1 round per 2 caster levels
// (minimum 2 rounds, maximum 5 rounds).
DEFINE_ACTION_FUNCTION cbmagic_vanilla_blindness_duration
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~WIZARD_BLINDNESS~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Blindness (WIZARD_BLINDNESS) is not in this game; skipped.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    OUTER_SET missing = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF valid BEGIN
        LPF cbmagic_scale_blindness_duration RET changed already missing END
        PATCH_IF (missing > 0) BEGIN
          PATCH_WARN ~chriz-bg-magic: Blindness (%spell%) left as it is: %missing% abilities have no blindness effect (opcode 74).~
        END ELSE PATCH_IF (changed > 0) BEGIN
          PATCH_PRINT ~chriz-bg-magic: Blindness (%spell%): duration scaled to 1 round/2 levels (2-5 rounds).~
        END ELSE BEGIN
          PATCH_PRINT ~chriz-bg-magic: Blindness (%spell%): duration scaled to 1 round/2 levels (2-5 rounds) already.~
        END
      END ELSE BEGIN
        PATCH_WARN ~chriz-bg-magic: Blindness (%spell%) left as it is: %reason%.~
      END
    BUT_ONLY
    ACTION_IF (changed > 0) AND (missing = 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Blindness~ END
      OUTER_SPRINT cbm_find @20002
      OUTER_SPRINT cbm_replace @20003
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%cbm_find%~ replace = EVAL ~%cbm_replace%~ label = ~Blindness~ END
    END
  END
END

