      OUTER_SPRINT cbm_find @20004
      OUTER_SPRINT cbm_replace @20005
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%cbm_find%~ replace = EVAL ~%cbm_replace%~ label = ~Web~ END
    END
  END
END

