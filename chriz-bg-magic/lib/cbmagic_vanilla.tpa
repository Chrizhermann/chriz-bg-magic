DEFINE_ACTION_FUNCTION cbmagic_vanilla_cloudkill_school
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~WIZARD_CLOUDKILL~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Cloudkill (WIZARD_CLOUDKILL) is not in this game; skipped.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF valid BEGIN
        LPF cbmagic_set_school INT_VAR target_school = 2 target_excl = 0x0100 RET changed already END
        PATCH_IF (changed > 0) BEGIN
          PATCH_PRINT ~chriz-bg-magic: Cloudkill (%spell%): school set to Conjuration.~
        END ELSE BEGIN
          PATCH_PRINT ~chriz-bg-magic: Cloudkill (%spell%): school is Conjuration already.~
        END
      END ELSE BEGIN
        PATCH_WARN ~chriz-bg-magic: Cloudkill (%spell%) left as it is: %reason%.~
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Cloudkill~ END
      OUTER_SPRINT cbm_find @20004
      OUTER_SPRINT cbm_replace @20005
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%cbm_find%~ replace = EVAL ~%cbm_replace%~ label = ~Cloudkill~ END
    END
  END
END

// Row arcane.level6.acid_fog: Death Fog stays, school Conjuration.
DEFINE_ACTION_FUNCTION cbmagic_vanilla_death_fog_school
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~WIZARD_DEATH_FOG~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Death Fog (WIZARD_DEATH_FOG) is not in this game; skipped.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF valid BEGIN
        LPF cbmagic_set_school INT_VAR target_school = 2 target_excl = 0x0100 RET changed already END
        PATCH_IF (changed > 0) BEGIN
          PATCH_PRINT ~chriz-bg-magic: Death Fog (%spell%): school set to Conjuration.~
        END ELSE BEGIN
          PATCH_PRINT ~chriz-bg-magic: Death Fog (%spell%): school is Conjuration already.~
        END
      END ELSE BEGIN
        PATCH_WARN ~chriz-bg-magic: Death Fog (%spell%) left as it is: %reason%.~
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Death Fog~ END
      OUTER_SPRINT cbm_find @20004
      OUTER_SPRINT cbm_replace @20005
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%cbm_find%~ replace = EVAL ~%cbm_replace%~ label = ~Death Fog~ END
    END
  END
END

// Row arcane.level7.finger_of_death: Save vs. Death without penalty.
DEFINE_ACTION_FUNCTION cbmagic_vanilla_wizard_finger_of_death_save
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~WIZARD_FINGER_OF_DEATH~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Finger of Death (WIZARD_FINGER_OF_DEATH) is not in this game; skipped.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF valid BEGIN
        LPF cbmagic_save_to_death_no_penalty INT_VAR anchor_opcode = 55 RET changed = anchors already others END
        PATCH_IF (changed = 0) AND (already = 0) BEGIN
          PATCH_WARN ~chriz-bg-magic: Finger of Death (%spell%): no slay effect (opcode 55) with a save; left as it is.~
        END ELSE PATCH_IF (changed > 0) BEGIN
          PATCH_PRINT ~chriz-bg-magic: Finger of Death (%spell%): %changed% slay effects now save vs. death with no penalty (%others% effects with them); %already% did already.~
        END ELSE BEGIN
          PATCH_PRINT ~chriz-bg-magic: Finger of Death (%spell%): saves vs. death with no penalty already.~
        END
      END ELSE BEGIN
        PATCH_WARN ~chriz-bg-magic: Finger of Death (%spell%) left as it is: %reason%.~
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Finger of Death~ END
      OUTER_SPRINT cbm_find @20006
      OUTER_SPRINT cbm_replace @20007
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%cbm_find%~ replace = EVAL ~%cbm_replace%~ label = ~Finger of Death~ END
    END
  END
END

