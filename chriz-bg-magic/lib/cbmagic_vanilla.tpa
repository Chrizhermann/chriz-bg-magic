// Row D (arcane.level2.power_word_sleep): school Enchantment (4, exclusion 0x0800),
// elf/half-elf resistance matching SPWI116 (rows 15 at 0-90 and 19 at 0-30), undead/dragon/elemental
// immune, description updated.
DEFINE_ACTION_FUNCTION cbmagic_vanilla_power_word_sleep
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~WIZARD_POWER_WORD_SLEEP~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Power Word, Sleep (WIZARD_POWER_WORD_SLEEP) is not in this game; skipped.~
  END ELSE BEGIN
    OUTER_SET cur_school = 0
    OUTER_SET is_valid = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET is_valid = valid reason END
      PATCH_IF is_valid BEGIN
        READ_BYTE 0x25 cur_school
      END ELSE BEGIN
        PATCH_WARN ~chriz-bg-magic: Power Word, Sleep (%spell%) left as it is: %reason%.~
      END
    BUT_ONLY
    ACTION_IF is_valid AND (cur_school > 0) BEGIN
      LAF cbmagic_splprot_row INT_VAR stat = 0x10c value = (0 - 1) relation = 1 RET race_row = row END
      OUTER_SET changed = 0
      COPY_EXISTING ~%spell%.spl~ ~override~
        LPF cbmagic_set_school INT_VAR target_school = 4 target_excl = 0x0800 RET changed already END
        PATCH_IF (changed > 0) BEGIN
          PATCH_PRINT ~chriz-bg-magic: Power Word, Sleep (%spell%): school set to Enchantment.~
        END ELSE BEGIN
          PATCH_PRINT ~chriz-bg-magic: Power Word, Sleep (%spell%): school is Enchantment already.~
        END
        PATCH_FOR_EACH race IN
          ELEMENTAL DRAGON
        BEGIN
          SET value = IDS_OF_SYMBOL (~race~ ~%race%~)
          PATCH_IF (value < 0) BEGIN
            PATCH_WARN ~chriz-bg-magic: Power Word, Sleep (%spell%): RACE.IDS has no %race%; that immunity is left out.~
          END ELSE BEGIN
            LPF cbmagic_add_immunity INT_VAR row = race_row value RET added present END
            PATCH_PRINT ~chriz-bg-magic: Power Word, Sleep (%spell%): race %race% (%value%) immune in %added% abilities; %present% were already.~
          END
        END
        LPF cbmagic_add_immunity INT_VAR row = 1 value = 0 RET added present END
        PATCH_PRINT ~chriz-bg-magic: Power Word, Sleep (%spell%): undead (SPLPROT row 1) immune in %added% abilities; %present% were already.~
        LPF cbmagic_add_immunity_prob INT_VAR row = 19 value = 0 prob_hi = 30 prob_lo = 0 RET added present END
        PATCH_PRINT ~chriz-bg-magic: Power Word, Sleep (%spell%): half-elf 30%% resistance (row 19) in %added% abilities; %present% were already.~
        LPF cbmagic_add_immunity_prob INT_VAR row = 15 value = 0 prob_hi = 90 prob_lo = 0 RET added present END
        PATCH_PRINT ~chriz-bg-magic: Power Word, Sleep (%spell%): elf 90%% resistance (row 15) in %added% abilities; %present% were already.~
      BUT_ONLY
      ACTION_IF (changed > 0) BEGIN
        LAF cbmagic_warn_text_language STR_VAR label = ~Power Word, Sleep~ END
        OUTER_SPRINT cbm_find @20005
        OUTER_SPRINT cbm_replace @20025
        LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%cbm_find%~ replace = EVAL ~%cbm_replace%~ label = ~Power Word, Sleep~ END
      END
    END
  END
END

// Row E (arcane.level1.spook): undead (SPLPROT row 1) and creatures with True Seeing
// (stat 118 TRUE_SIGHT > 0) are immune.
DEFINE_ACTION_FUNCTION cbmagic_vanilla_spook
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~WIZARD_SPOOK~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Spook (WIZARD_SPOOK) is not in this game; skipped.~
  END ELSE BEGIN
    LAF cbmagic_splprot_row INT_VAR stat = 118 value = 0 relation = 3 RET truesight_row = row END
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF valid BEGIN
        LPF cbmagic_add_immunity INT_VAR row = 1 value = 0 RET added_u = added present_u = present END
        PATCH_PRINT ~chriz-bg-magic: Spook (%spell%): undead (SPLPROT row 1) immune in %added_u% abilities; %present_u% were already.~
        LPF cbmagic_add_immunity INT_VAR row = truesight_row value = 0 RET added_t = added present_t = present END
        PATCH_PRINT ~chriz-bg-magic: Spook (%spell%): True Seeing (SPLPROT row %truesight_row%) immune in %added_t% abilities; %present_t% were already.~
      END ELSE BEGIN
        PATCH_WARN ~chriz-bg-magic: Spook (%spell%) left as it is: %reason%.~
      END
    BUT_ONLY
  END
END

