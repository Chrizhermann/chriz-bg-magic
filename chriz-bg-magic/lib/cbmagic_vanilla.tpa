// --- Helpers for Rows A-L --------------------------------------------------------------

// Add a leading op324 (immunity to resource and message) with explicit probability bounds
// to every ability of the current SPL that does not already have one with the same row,
// value, and probability window.
DEFINE_PATCH_FUNCTION cbmagic_add_immunity_prob
  INT_VAR
    row     = 0
    value   = 0
    prob_hi = 100
    prob_lo = 0
  RET
    added
    present
BEGIN
  SET added = 0
  SET present = 0
  READ_LONG  0x64 ab_off
  READ_SHORT 0x68 ab_cnt
  READ_LONG  0x6a fx_off
  FOR (a = 0; a < ab_cnt; ++a) BEGIN
    SET ab = ab_off + a * 0x28
    READ_SHORT (ab + 0x1e) n
    READ_SHORT (ab + 0x20) first
    SET has = 0
    SET power = 0
    FOR (i = 0; i < n; ++i) BEGIN
      SET fx = fx_off + (first + i) * 0x30
      READ_SHORT fx op
      READ_BYTE  (fx + 0x03) fx_power
      READ_LONG  (fx + 0x04) p1
      READ_LONG  (fx + 0x08) p2
      READ_BYTE  (fx + 0x12) p_hi
      READ_BYTE  (fx + 0x13) p_lo
      READ_ASCII (fx + 0x14) res (8) NULL
      PATCH_IF (power = 0) AND (fx_power > 0) BEGIN
        SET power = fx_power
      END
      PATCH_IF (op = 324) AND (p1 = value) AND (p2 = row) AND (p_hi = prob_hi) AND (p_lo = prob_lo) AND (~%res%~ STRING_EQUAL_CASE ~%SOURCE_RES%~) BEGIN
        SET has = 1
      END
    END
    PATCH_IF has BEGIN
      SET present += 1
    END ELSE BEGIN
      LPF ADD_SPELL_EFFECT
        INT_VAR
          header        = a + 1
          insert_point  = 0
          opcode        = 324
          target        = 2
          power         = power
          parameter1    = value
          parameter2    = row
          timing        = 0
          duration      = 0
          resist_dispel = 2
          probability1  = prob_hi
          probability2  = prob_lo
        STR_VAR
          resource = EVAL ~%SOURCE_RES%~
      END
      SET added += 1
      READ_LONG 0x64 ab_off
      READ_LONG 0x6a fx_off
    END
  END
END

// Helper: add a leading op321 (remove effects of resource) for the given resource to every
// ability of the current SPL that does not already have one for that resource.
DEFINE_PATCH_FUNCTION cbmagic_add_remove_spell_fx
  STR_VAR
    resource = ~~
  RET
    added
    present
BEGIN
  SET added = 0
  SET present = 0
  READ_LONG  0x34 level
  READ_SHORT 0x68 ab_cnt
  FOR (a = 0; a < ab_cnt; ++a) BEGIN
    READ_LONG  0x64 ab_off
    READ_LONG  0x6a fx_off
    READ_BYTE  (ab_off + a * 0x28 + 0x0c) ab_target
    READ_SHORT (ab_off + a * 0x28 + 0x1e) n
    READ_SHORT (ab_off + a * 0x28 + 0x20) first
    SET has = 0
    FOR (i = 0; i < n; ++i) BEGIN
      SET fx = fx_off + (first + i) * 0x30
      READ_SHORT fx op
      READ_ASCII (fx + 0x14) res (8) NULL
      PATCH_IF (op = 321) AND (~%res%~ STRING_EQUAL_CASE ~%resource%~) BEGIN
        SET has = 1
      END
    END
    PATCH_IF has BEGIN
      SET present += 1
    END ELSE BEGIN
      SET fx_target = ((ab_target = 5) OR (ab_target = 7)) ? 1 : 2
      LPF cbmagic_insert_effect
        INT_VAR
          ability       = a
          position      = 0
          opcode        = 321
          target        = fx_target
          power         = level
          timing        = 1
          resist_dispel = 3
        STR_VAR
          resource = EVAL ~%resource%~
      END
      SET added += 1
    END
  END
END

// Helper: set school to Universal (0, exclusion 0) and update the description school header.
DEFINE_ACTION_FUNCTION cbmagic_apply_universal_school
  INT_VAR
    old_tra = 20030
  STR_VAR
    symbol = ~~
    label  = ~~
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: %label% (%symbol%) is not in this game; skipped.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF valid BEGIN
        LPF cbmagic_set_school INT_VAR target_school = 0 target_excl = 0 RET changed already END
        PATCH_IF (changed > 0) BEGIN
          PATCH_PRINT ~chriz-bg-magic: %label% (%spell%): school set to Universal.~
        END ELSE BEGIN
          PATCH_PRINT ~chriz-bg-magic: %label% (%spell%): school is Universal already.~
        END
      END ELSE BEGIN
        PATCH_WARN ~chriz-bg-magic: %label% (%spell%) left as it is: %reason%.~
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label END
      OUTER_SPRINT cbm_find (AT old_tra)
      OUTER_SPRINT cbm_replace @20001
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%cbm_find%~ replace = EVAL ~%cbm_replace%~ label END
    END
  END
END

// --- Decided changes: Rows A-L ---------------------------------------------------------

// Row A (arcane.level1.grease): save vs. breath (+2 bonus stays), flying/incorporeal/dragon
// creatures immune, description updated.
DEFINE_ACTION_FUNCTION cbmagic_vanilla_grease
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~WIZARD_GREASE~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Grease (WIZARD_GREASE) is not in this game; skipped.~
  END ELSE BEGIN
    LAF cbmagic_splprot_row INT_VAR stat = 0x10c value = (0 - 1) relation = 1 RET race_row = row END
    OUTER_SET changed = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF valid BEGIN
        LPF cbmagic_save_spell_to_breath INT_VAR anchor_opcode = 158 RET changed = anchors already others END
        PATCH_IF (changed = 0) AND (already = 0) BEGIN
          PATCH_WARN ~chriz-bg-magic: Grease (%spell%): no grease effect (opcode 158) with a save vs. spell; its save was left as it is.~
        END ELSE BEGIN
          PATCH_PRINT ~chriz-bg-magic: Grease (%spell%): %changed% grease effects now save vs. breath (%others% effects of the same roll with them); %already% did already.~
        END
        PATCH_FOR_EACH race IN
          WYVERN BEHOLDER MEPHIT SPECTRE WRAITH SHADOW MIST DRAGON
        BEGIN
          SET value = IDS_OF_SYMBOL (~race~ ~%race%~)
          PATCH_IF (value < 0) BEGIN
            PATCH_WARN ~chriz-bg-magic: Grease (%spell%): RACE.IDS has no %race%; that immunity is left out.~
          END ELSE BEGIN
            LPF cbmagic_add_immunity INT_VAR row = race_row value RET added present END
            PATCH_PRINT ~chriz-bg-magic: Grease (%spell%): race %race% (%value%) immune in %added% abilities; %present% were already.~
          END
        END
      END ELSE BEGIN
        PATCH_WARN ~chriz-bg-magic: Grease (%spell%) left as it is: %reason%.~
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_warn_text_language STR_VAR label = ~Grease~ END
      OUTER_SPRINT cbm_find @20010
      OUTER_SPRINT cbm_replace @20011
      LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%cbm_find%~ replace = EVAL ~%cbm_replace%~ label = ~Grease~ END
    END
  END
END

// Row B (arcane.level2.stinking_cloud): undead and non-breathing races (GOLEM, ELEMENTAL,
// SLIME) immune; school Conjuration (2, exclusion 0x0100); description updated.
DEFINE_ACTION_FUNCTION cbmagic_vanilla_stinking_cloud
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~WIZARD_STINKING_CLOUD~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: Stinking Cloud (WIZARD_STINKING_CLOUD) is not in this game; skipped.~
  END ELSE BEGIN
    OUTER_SET cur_school = 0
    OUTER_SET is_valid = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET is_valid = valid reason END
      PATCH_IF is_valid BEGIN
        READ_BYTE 0x25 cur_school
      END ELSE BEGIN
        PATCH_WARN ~chriz-bg-magic: Stinking Cloud (%spell%) left as it is: %reason%.~
      END
    BUT_ONLY
    ACTION_IF is_valid AND (cur_school > 0) BEGIN
      LAF cbmagic_splprot_row INT_VAR stat = 0x10c value = (0 - 1) relation = 1 RET race_row = row END
      OUTER_SET changed = 0
      COPY_EXISTING ~%spell%.spl~ ~override~
        LPF cbmagic_set_school INT_VAR target_school = 2 target_excl = 0x0100 RET changed already END
        PATCH_IF (changed > 0) BEGIN
          PATCH_PRINT ~chriz-bg-magic: Stinking Cloud (%spell%): school set to Conjuration.~
        END ELSE BEGIN
          PATCH_PRINT ~chriz-bg-magic: Stinking Cloud (%spell%): school is Conjuration already.~
        END
        LPF cbmagic_add_immunity INT_VAR row = 1 value = 0 RET added present END
        PATCH_PRINT ~chriz-bg-magic: Stinking Cloud (%spell%): undead (SPLPROT row 1) immune in %added% abilities; %present% were already.~
        PATCH_FOR_EACH race IN
          GOLEM ELEMENTAL SLIME
        BEGIN
          SET value = IDS_OF_SYMBOL (~race~ ~%race%~)
          PATCH_IF (value < 0) BEGIN
            PATCH_WARN ~chriz-bg-magic: Stinking Cloud (%spell%): RACE.IDS has no %race%; that immunity is left out.~
          END ELSE BEGIN
            LPF cbmagic_add_immunity INT_VAR row = race_row value RET added present END
            PATCH_PRINT ~chriz-bg-magic: Stinking Cloud (%spell%): race %race% (%value%) immune in %added% abilities; %present% were already.~
          END
        END
      BUT_ONLY
      ACTION_IF (changed > 0) BEGIN
        LAF cbmagic_warn_text_language STR_VAR label = ~Stinking Cloud~ END
        OUTER_SPRINT cbm_find @20004
        OUTER_SPRINT cbm_replace @20005
        LAF cbmagic_update_texts STR_VAR spell find = EVAL ~%cbm_find%~ replace = EVAL ~%cbm_replace%~ label = ~Stinking Cloud~ END
      END
    END
  END
END

