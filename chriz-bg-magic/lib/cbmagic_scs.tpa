// 13. Power Word, Blind (WIZARD_POWER_WORD_BLIND): Conjuration -> Enchantment, single-target (projectile 1).
DEFINE_ACTION_FUNCTION cbmagic_scs_power_word_blind
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~WIZARD_POWER_WORD_BLIND~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: WIZARD_POWER_WORD_BLIND is not in SPELL.IDS or has no .spl file — skipping.~
  END ELSE BEGIN
    LAF cbmagic_conjuration_to_enchantment STR_VAR spell label = ~WIZARD_POWER_WORD_BLIND~ RET sch_changed = changed sch_already = already END
    OUTER_SET proj_changed = 0
    OUTER_SET proj_already = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      READ_SHORT 0x68 ab_cnt
      PATCH_IF valid AND (ab_cnt > 0) BEGIN
        READ_LONG 0x64 ab_off
        FOR (a = 0; a < ab_cnt; ++a) BEGIN
          READ_SHORT (ab_off + a * 0x28 + 0x26) proj
          PATCH_IF (proj = 1) BEGIN
            SET proj_already += 1
          END ELSE BEGIN
            WRITE_SHORT (ab_off + a * 0x28 + 0x26) 1
            SET proj_changed += 1
          END
        END
      END
    BUT_ONLY
    ACTION_IF (proj_changed > 0) BEGIN
      OUTER_SPRINT find @30021
      OUTER_SPRINT replace @30022
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find replace label = ~WIZARD_POWER_WORD_BLIND~ END
      OUTER_SPRINT find @30023
      OUTER_SPRINT replace @30024
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find replace label = ~WIZARD_POWER_WORD_BLIND~ END
      OUTER_SPRINT find @30025
      OUTER_SPRINT replace @30026
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find replace label = ~WIZARD_POWER_WORD_BLIND~ END
    END
    PRINT ~chriz-bg-magic: WIZARD_POWER_WORD_BLIND (%spell%): school %sch_changed%/%sch_already%, projectile %proj_changed%/%proj_already%.~
  END
END

// 14. Simulacrum (WIZARD_SIMULACRUM / SIMULACR.SPL): disable quick-slot items (9, 11, 12), keep innates enabled.
DEFINE_ACTION_FUNCTION cbmagic_scs_simulacrum
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~WIZARD_SIMULACRUM~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: WIZARD_SIMULACRUM is not in SPELL.IDS or has no .spl file — skipping.~
  END ELSE ACTION_IF !(FILE_EXISTS_IN_GAME ~simulacr.spl~) BEGIN
    PRINT ~chriz-bg-magic: WIZARD_SIMULACRUM (%spell%): SIMULACR.SPL not found — skipping.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    OUTER_SET already = 0
    COPY_EXISTING ~simulacr.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: SIMULACR.SPL skipped: %reason%.~
      END ELSE BEGIN
        LPF cbmagic_patch_clone_buttons INT_VAR disable_innates = 0 RET changed already END
      END
    BUT_ONLY
    PRINT ~chriz-bg-magic: WIZARD_SIMULACRUM (%spell% / SIMULACR): changed %changed%, already %already%.~
  END
END

// 16. Symbol, Death (wizard, WIZARD_SYMBOL_DEATH): affects only enemies.
DEFINE_ACTION_FUNCTION cbmagic_scs_wizard_symbol_death
BEGIN
  LAF cbmagic_patch_symbol_spell INT_VAR free_action = 0 STR_VAR symbol = ~WIZARD_SYMBOL_DEATH~ END
END

// 17. Symbol, Stun (wizard, WIZARD_SYMBOL_STUN): affects only enemies, Free Action protects.
DEFINE_ACTION_FUNCTION cbmagic_scs_wizard_symbol_stun
BEGIN
  LAF cbmagic_patch_symbol_spell INT_VAR free_action = 1 STR_VAR symbol = ~WIZARD_SYMBOL_STUN~ END
END

// 18. Symbol, Fear (wizard, WIZARD_SYMBOL_FEAR): affects only enemies.
DEFINE_ACTION_FUNCTION cbmagic_scs_wizard_symbol_fear
BEGIN
  LAF cbmagic_patch_symbol_spell INT_VAR free_action = 0 STR_VAR symbol = ~WIZARD_SYMBOL_FEAR~ END
END

// 19. Absolute Immunity (WIZARD_ABSOLUTE_IMMUNITY): protects against weapons up to +6.
DEFINE_ACTION_FUNCTION cbmagic_scs_absolute_immunity
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~WIZARD_ABSOLUTE_IMMUNITY~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: WIZARD_ABSOLUTE_IMMUNITY is not in SPELL.IDS or has no .spl file — skipping.~
  END ELSE BEGIN
    OUTER_SET added = 0
    OUTER_SET already = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: WIZARD_ABSOLUTE_IMMUNITY (%spell%) skipped: %reason%.~
      END ELSE BEGIN
        LPF cbmagic_add_weapon_immunity INT_VAR enchantment = 6 RET added already END
      END
    BUT_ONLY
    ACTION_IF (added > 0) BEGIN
      OUTER_SPRINT find @30019
      OUTER_SPRINT replace @30020
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find replace label = ~WIZARD_ABSOLUTE_IMMUNITY~ END
    END
    PRINT ~chriz-bg-magic: WIZARD_ABSOLUTE_IMMUNITY (%spell%): added %added%, already %already%.~
  END
END

// 21. Power Word, Kill (WIZARD_POWER_WORD_KILL): Conjuration -> Enchantment.
DEFINE_ACTION_FUNCTION cbmagic_scs_power_word_kill
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~WIZARD_POWER_WORD_KILL~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: WIZARD_POWER_WORD_KILL is not in SPELL.IDS or has no .spl file — skipping.~
  END ELSE BEGIN
    LAF cbmagic_conjuration_to_enchantment STR_VAR spell label = ~WIZARD_POWER_WORD_KILL~ RET changed already END
    PRINT ~chriz-bg-magic: WIZARD_POWER_WORD_KILL (%spell%): changed %changed%, already %already%.~
  END
END

// 31. Symbol, Death (cleric, CLERIC_SYMBOL_DEATH): affects only enemies.
DEFINE_ACTION_FUNCTION cbmagic_scs_cleric_symbol_death
BEGIN
  LAF cbmagic_patch_symbol_spell INT_VAR free_action = 0 STR_VAR symbol = ~CLERIC_SYMBOL_DEATH~ END
END

// 32. Symbol, Stun (cleric, CLERIC_SYMBOL_STUN): affects only enemies, Free Action protects.
DEFINE_ACTION_FUNCTION cbmagic_scs_cleric_symbol_stun
BEGIN
  LAF cbmagic_patch_symbol_spell INT_VAR free_action = 1 STR_VAR symbol = ~CLERIC_SYMBOL_STUN~ END
END

// 33. Symbol, Fear (cleric, CLERIC_SYMBOL_FEAR): affects only enemies.
DEFINE_ACTION_FUNCTION cbmagic_scs_cleric_symbol_fear
BEGIN
  LAF cbmagic_patch_symbol_spell INT_VAR free_action = 0 STR_VAR symbol = ~CLERIC_SYMBOL_FEAR~ END
END

// Helper: install species-specific summoned-fiend combat scripts (CBMGBONF.BCS, CBMGCORN.BCS, CBMGBALR.BCS).
DEFINE_ACTION_FUNCTION cbmagic_install_fiend_scripts
BEGIN
  <<<<<<<< .../chriz-bg-magic-inlined/cbmgbonf.baf
IF
  Allegiance(Myself,ENEMY)
  OR(2)
    Detect([PC])
    Detect([ALLY])
  Global("fearsphere","LOCALS",0)
THEN
  RESPONSE #100
    SetGlobal("fearsphere","LOCALS",1)
    ApplySpell(Myself,DEMON_FEAR)
END

IF
  Detect([PC])
  !See([EVILCUTOFF.0.DEMONIC])
THEN
  RESPONSE #100
    Enemy()
END

IF
  See([0.0.0.0.0.0.0])
  !Race(LastSeenBy(Myself),DEMONIC)
  !CheckStatGT(LastSeenBy(Myself),0,PROTECTION_FROM_EVIL)
  !StateCheck(Myself,STATE_IMPROVEDINVISIBILITY)
  !StateCheck(Myself,STATE_INVISIBLE)
  Global("Prep","LOCALS",0)
THEN
  RESPONSE #100
    SetGlobal("Prep","LOCALS",1)
    ForceSpell(Myself,WIZARD_IMPROVED_INVISIBILITY)
END

IF
  See([0.0.0.0.0.0.0])
  !Race(LastSeenBy(Myself),DEMONIC)
  !CheckStatGT(LastSeenBy(Myself),0,PROTECTION_FROM_EVIL)
THEN
  RESPONSE #35
    ForceSpell(LastSeenBy(Myself),WIZARD_CONE_OF_COLD)
    AttackReevaluate(LastSeenBy(Myself),30)
  RESPONSE #65
    AttackReevaluate(LastSeenBy(Myself),30)
END
