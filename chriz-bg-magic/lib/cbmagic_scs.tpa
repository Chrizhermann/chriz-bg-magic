        PATCH_WARN ~chriz-bg-magic: WIZARD_MANTLE (%spell%) skipped: %reason%.~
      END ELSE BEGIN
        LPF cbmagic_add_weapon_immunity INT_VAR enchantment = 3 RET added already END
      END
    BUT_ONLY
    ACTION_IF (added > 0) BEGIN
      OUTER_SPRINT find @30015
      OUTER_SPRINT replace @30016
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find replace label = ~WIZARD_MANTLE~ END
