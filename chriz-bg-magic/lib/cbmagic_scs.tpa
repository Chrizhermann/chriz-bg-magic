  OUTER_SPRINT replace @30036
  LAF cbmagic_patch_fiend_spell
    STR_VAR symbol = ~WIZARD_SUMMON_FIEND~
            src_cre = ~gorbat3~ dst_cre = ~cbmgcorn~ ovr_script = ~cbmgcorn~
            src_eff = ~spfiend~ dst_eff = ~cbmgfien~
            eff_l = ~cbmgfien~ eff_c = ~spfiend~
            find replace
  END
END

