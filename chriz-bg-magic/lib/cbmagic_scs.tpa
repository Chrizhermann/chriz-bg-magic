// Helper: patch a fiend-summoning spell so Lawful casters summon eff_l, Chaotic casters
// summon eff_c, and L/C Neutral casters have a 50/50 chance of either.
DEFINE_ACTION_FUNCTION cbmagic_patch_fiend_spell
  STR_VAR symbol = ~~
          src_cre = ~~
          dst_cre = ~~
          ovr_script = ~~
          src_eff = ~~
          dst_eff = ~~
          eff_l = ~~
          eff_c = ~~
          find = ~~
          replace = ~~
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: %symbol% is not in SPELL.IDS or has no .spl file — skipping.~
  END ELSE BEGIN
    ACTION_IF (FILE_EXISTS_IN_GAME ~%src_cre%.cre~) AND !(FILE_EXISTS ~override/%dst_cre%.cre~) BEGIN
      COPY_EXISTING ~%src_cre%.cre~ ~override/%dst_cre%.cre~
        PATCH_IF (SOURCE_SIZE >= 0x2d4) BEGIN
          WRITE_LONG 0x14 0
          WRITE_BYTE 0x270 28
          WRITE_BYTE 0x275 9
          WRITE_ASCIIE 0x248 ~%ovr_script%~ #8
          WRITE_ASCII 0x250 ~~ #8
          WRITE_ASCII 0x268 ~WTASIGHT~ #8
          WRITE_ASCIIE 0x280 ~%dst_cre%~ #32
        END
    END
    ACTION_IF (FILE_EXISTS_IN_GAME ~%src_eff%.eff~) AND !(FILE_EXISTS ~override/%dst_eff%.eff~) BEGIN
      COPY_EXISTING ~%src_eff%.eff~ ~override/%dst_eff%.eff~
        PATCH_IF (SOURCE_SIZE >= 0x38) BEGIN
          WRITE_ASCIIE 0x30 ~%dst_cre%~ #8
        END
    END
    OUTER_SET changed = 0
    OUTER_SET already = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      READ_SHORT 0x68 ab_cnt
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: %symbol% (%spell%) skipped: %reason%.~
      END ELSE PATCH_IF (ab_cnt = 0) BEGIN
        PATCH_WARN ~chriz-bg-magic: %symbol% (%spell%) has no abilities — skipping.~
      END ELSE BEGIN
        READ_LONG 0x64 ab_off
        READ_LONG 0x6a fx_off
        FOR (a = 0; a < ab_cnt; ++a) BEGIN
          SET ab = ab_off + a * 0x28
          READ_SHORT (ab + 0x1e) fx_cnt
          READ_SHORT (ab + 0x20) fx_idx
          SET has_aligned = 0
          SET base_e = 0 - 1
          FOR (i = 0; i < fx_cnt; ++i) BEGIN
            SET e = fx_off + (fx_idx + i) * 0x30
            READ_SHORT e op
            PATCH_IF (op = 177) BEGIN
              READ_LONG (e + 0x04) p1
              READ_LONG (e + 0x08) p2
              PATCH_IF (p2 = 8) AND (p1 = 16) BEGIN
                SET has_aligned = 1
              END ELSE PATCH_IF (base_e < 0) BEGIN
                SET base_e = e
              END
            END
          END
          PATCH_IF has_aligned BEGIN
            SET already += 1
          END ELSE PATCH_IF (base_e >= 0) BEGIN
            WRITE_BYTE (ab + 0x0c) 5
            READ_BYTE (base_e + 0x03) pw
            READ_BYTE (base_e + 0x0c) tm
            READ_BYTE (base_e + 0x0d) dp
            READ_LONG (base_e + 0x0e) dur
            WRITE_BYTE (base_e + 0x02) 1
            WRITE_LONG (base_e + 0x04) 16
            WRITE_LONG (base_e + 0x08) 8
            WRITE_BYTE (base_e + 0x12) 100
            WRITE_BYTE (base_e + 0x13) 0
            WRITE_ASCIIE (base_e + 0x14) ~%eff_l%~ #8
            LPF ADD_SPELL_EFFECT
              INT_VAR header = a + 1 opcode = 177 target = 1 power = pw parameter1 = 48 parameter2 = 8
                      timing = tm resist_dispel = dp duration = dur probability1 = 100 probability2 = 0
              STR_VAR resource = EVAL ~%eff_c%~
            END
            LPF ADD_SPELL_EFFECT
              INT_VAR header = a + 1 opcode = 177 target = 1 power = pw parameter1 = 32 parameter2 = 8
                      timing = tm resist_dispel = dp duration = dur probability1 = 49 probability2 = 0
              STR_VAR resource = EVAL ~%eff_l%~
            END
            LPF ADD_SPELL_EFFECT
              INT_VAR header = a + 1 opcode = 177 target = 1 power = pw parameter1 = 32 parameter2 = 8
                      timing = tm resist_dispel = dp duration = dur probability1 = 100 probability2 = 50
              STR_VAR resource = EVAL ~%eff_c%~
            END
            READ_LONG 0x64 ab_off
            READ_LONG 0x6a fx_off
            SET changed += 1
          END
        END
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      LAF cbmagic_scrolls_of STR_VAR spell RET scrolls END
      OUTER_PATCH_SAVE list ~%scrolls%~ BEGIN REPLACE_TEXTUALLY ~^ +~ ~~ END
      OUTER_WHILE !(~%list%~ STRING_EQUAL ~~) BEGIN
        OUTER_PATCH_SAVE sc_itm ~%list%~ BEGIN REPLACE_TEXTUALLY ~ .*$~ ~~ END
        OUTER_PATCH_SAVE list ~%list%~ BEGIN REPLACE_TEXTUALLY ~^[^ ]+ ?~ ~~ END
        ACTION_IF FILE_EXISTS_IN_GAME ~%sc_itm%.itm~ BEGIN
          COPY_EXISTING ~%sc_itm%.itm~ ~override~
            READ_LONG 0x64 i_ab_off
            READ_SHORT 0x68 i_ab_cnt
            READ_LONG 0x6a i_fx_off
            FOR (ia = 0; ia < i_ab_cnt; ++ia) BEGIN
              SET i_ab = i_ab_off + ia * 0x38
              READ_SHORT (i_ab + 0x1e) i_fx_cnt
              READ_SHORT (i_ab + 0x20) i_fx_idx
              FOR (ii = 0; ii < i_fx_cnt; ++ii) BEGIN
                SET ie = i_fx_off + (i_fx_idx + ii) * 0x30
                READ_SHORT ie i_op
                PATCH_IF (i_op = 146) OR (i_op = 148) BEGIN
                  READ_ASCII (ie + 0x14) i_res (8) NULL
                  PATCH_IF (~%i_res%~ STRING_EQUAL_CASE ~%spell%~) BEGIN
                    WRITE_BYTE (i_ab + 0x0c) 5
                  END
                END
              END
            END
          BUT_ONLY
        END
      END
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find replace label = EVAL ~%symbol%~ END
    END
    PRINT ~chriz-bg-magic: %symbol% (%spell%): changed %changed%, already %already%.~
  END
END

// 10. Cacofiend (WIZARD_CACOFIEND): Lawful -> Bone Fiend, Chaotic -> Nabassu, Neutral -> 50/50.
DEFINE_ACTION_FUNCTION cbmagic_scs_cacofiend
BEGIN
  OUTER_SPRINT find @30033
  OUTER_SPRINT replace @30034
  LAF cbmagic_patch_fiend_spell
    STR_VAR symbol = ~WIZARD_CACOFIEND~
            src_cre = ~gorbat5~ dst_cre = ~cbmgbonf~ ovr_script = ~dempitsu~
            src_eff = ~spcaco~ dst_eff = ~cbmgcaco~
            eff_l = ~cbmgcaco~ eff_c = ~spcaco~
            find replace
  END
END

