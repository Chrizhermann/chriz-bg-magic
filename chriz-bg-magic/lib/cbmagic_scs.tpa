// 30. Gate (cleric, CLERIC_GATE): Lawful -> Pit Fiend, Neutral/Chaotic -> Balor.
DEFINE_ACTION_FUNCTION cbmagic_scs_cleric_gate
BEGIN
  OUTER_SPRINT find @30037
  OUTER_SPRINT replace @30038
  LAF cbmagic_patch_fiend_spell
    STR_VAR symbol = ~CLERIC_GATE~
            src_cre = ~dembal01~ dst_cre = ~cbmgbalr~ ovr_script = ~cbmgbalr~
            src_eff = ~spgate~ dst_eff = ~cbmggate~
            eff_l = ~spgate~ eff_c = ~cbmggate~
            find replace
  END
END

// Helper: find the repeating aura payload subspell of a Blade Barrier / Globe of Blades spell
// by inspecting op177 -> .EFF (op146/148/232/272) or direct op146/148/232/272 effects,
// falling back to `%spell%d` if present.
DEFINE_ACTION_FUNCTION cbmagic_find_aura_payload
  STR_VAR spell = ~~
  RET payload
BEGIN
  OUTER_SPRINT payload ~~
  ACTION_IF FILE_EXISTS_IN_GAME ~%spell%.spl~ BEGIN
    COPY_EXISTING - ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF valid BEGIN
        READ_LONG 0x64 ab_off
        READ_SHORT 0x68 ab_cnt
        READ_LONG 0x6a fx_off
        FOR (a = 0; (a < ab_cnt) AND (~%payload%~ STRING_EQUAL ~~); ++a) BEGIN
          SET ab = ab_off + a * 0x28
          READ_SHORT (ab + 0x1e) fx_cnt
          READ_SHORT (ab + 0x20) fx_idx
          FOR (i = 0; (i < fx_cnt) AND (~%payload%~ STRING_EQUAL ~~); ++i) BEGIN
            SET e = fx_off + (fx_idx + i) * 0x30
            READ_SHORT e op
            READ_ASCII (e + 0x14) res (8) NULL
            PATCH_IF (op = 177) AND !(~%res%~ STRING_EQUAL ~~) BEGIN
              PATCH_IF FILE_EXISTS_IN_GAME ~%res%.eff~ BEGIN
                INNER_ACTION BEGIN
                  COPY_EXISTING - ~%res%.eff~ ~override~
                    PATCH_IF (BUFFER_LENGTH >= 0x110) BEGIN
                      READ_LONG 0x10 eff_op
                      PATCH_IF (eff_op = 146) OR (eff_op = 148) OR (eff_op = 232) OR (eff_op = 272) BEGIN
                        READ_ASCII 0x30 eff_sub (8) NULL
                        PATCH_IF !(~%eff_sub%~ STRING_EQUAL ~~) AND (FILE_EXISTS_IN_GAME ~%eff_sub%.spl~) BEGIN
                          SPRINT payload ~%eff_sub%~
                        END
                      END
                    END
                END
              END
              PATCH_IF (~%payload%~ STRING_EQUAL ~~) AND (FILE_EXISTS_IN_GAME ~%res%.spl~) BEGIN
                SPRINT payload ~%res%~
              END
            END ELSE PATCH_IF ((op = 146) OR (op = 148) OR (op = 232) OR (op = 272)) AND !(~%res%~ STRING_EQUAL ~~) BEGIN
              PATCH_IF FILE_EXISTS_IN_GAME ~%res%.spl~ BEGIN
                SPRINT payload ~%res%~
              END
            END
          END
        END
      END
  END
  ACTION_IF (~%payload%~ STRING_EQUAL ~~) AND (FILE_EXISTS_IN_GAME ~%spell%d.spl~) BEGIN
    OUTER_SPRINT payload ~%spell%d~
  END
END

// Helper: patch a Blade Barrier / Globe of Blades payload subspell to affect only enemies
// (leading op318 for !ENEMIES) and allow a save for half damage (special |= 0x100 on op12).
// When set_8d8 = 1 (Blade Barrier player/NPC payloads), also normalize range to 6 and damage to 8d8.
DEFINE_ACTION_FUNCTION cbmagic_patch_blade_payload
  INT_VAR not_enemy_row = 0
          set_8d8       = 0
  STR_VAR payload = ~~
  RET changed already
BEGIN
  OUTER_SET changed = 0
  OUTER_SET already = 0
  ACTION_IF !(~%payload%~ STRING_EQUAL ~~) AND FILE_EXISTS_IN_GAME ~%payload%.spl~ BEGIN
    COPY_EXISTING ~%payload%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      READ_SHORT 0x68 ab_cnt
      PATCH_IF valid AND (ab_cnt > 0) BEGIN
        READ_LONG 0x64 ab_off
        READ_LONG 0x6a fx_off
        FOR (a = 0; a < ab_cnt; ++a) BEGIN
          SET ab = ab_off + a * 0x28
          SET ab_changed = 0
          READ_SHORT (ab + 0x26) proj
          PATCH_IF (proj = 218) BEGIN
            WRITE_SHORT (ab + 0x26) 216
            SET ab_changed = 1
          END
          PATCH_IF set_8d8 BEGIN
            READ_SHORT (ab + 0x0e) rng
            PATCH_IF (rng != 6) BEGIN
              WRITE_SHORT (ab + 0x0e) 6
              SET ab_changed = 1
            END
          END
          READ_SHORT (ab + 0x1e) fx_cnt
          READ_SHORT (ab + 0x20) fx_idx
          SET has_guard = 0
          SET half_changed = 0
          SET half_already = 0
          FOR (i = 0; i < fx_cnt; ++i) BEGIN
            SET e = fx_off + (fx_idx + i) * 0x30
            READ_SHORT e op
            PATCH_IF (op = 318) OR (op = 324) BEGIN
              READ_LONG (e + 0x08) p2
              READ_ASCII (e + 0x14) res (8) NULL
              PATCH_IF (p2 = not_enemy_row) AND (~%res%~ STRING_EQUAL_CASE ~%payload%~) BEGIN
                SET has_guard = 1
              END
            END ELSE PATCH_IF (op = 12) BEGIN
              READ_LONG (e + 0x1c) dice
              READ_LONG (e + 0x20) sides
              READ_LONG (e + 0x24) save_type
              READ_LONG (e + 0x2c) special
              PATCH_IF set_8d8 AND ((dice != 8) OR (sides != 8)) BEGIN
                WRITE_LONG (e + 0x1c) 8
                WRITE_LONG (e + 0x20) 8
                SET ab_changed = 1
              END
              PATCH_IF ((save_type BAND 0x1f) != 0) BEGIN
                PATCH_IF ((special BAND 0x100) != 0) BEGIN
                  SET half_already += 1
                END ELSE BEGIN
                  WRITE_LONG (e + 0x2c) (special BOR 0x100)
                  SET half_changed += 1
                END
              END
            END
          END
          PATCH_IF !has_guard BEGIN
            LPF ADD_SPELL_EFFECT
              INT_VAR header = a + 1 insert_point = 0 opcode = 318 target = 2 power = 0
                      parameter1 = 1 parameter2 = not_enemy_row timing = 0 duration = 0 resist_dispel = 0
              STR_VAR resource = EVAL ~%payload%~
            END
            READ_LONG 0x64 ab_off
            READ_LONG 0x6a fx_off
            SET changed += 1
          END ELSE PATCH_IF (half_changed > 0) OR ab_changed BEGIN
            SET changed += 1
          END ELSE BEGIN
            SET already += 1
          END
        END
      END
    BUT_ONLY
  END
END

// 22. Blade Barrier (CLERIC_BLADE_BARRIER): casting time 9 -> 6, affects only enemies, save for half.
DEFINE_ACTION_FUNCTION cbmagic_scs_blade_barrier
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_BLADE_BARRIER~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: CLERIC_BLADE_BARRIER is not in SPELL.IDS or has no .spl file — skipping.~
  END ELSE BEGIN
    LAF cbmagic_splprot_row INT_VAR stat = 0x114 value = 1 relation = 5 RET not_enemy_row = row END
    OUTER_SET cast_changed = 0
    OUTER_SET cast_already = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      READ_SHORT 0x68 ab_cnt
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: CLERIC_BLADE_BARRIER (%spell%) skipped: %reason%.~
      END ELSE BEGIN
        READ_LONG 0x64 ab_off
        FOR (a = 0; a < ab_cnt; ++a) BEGIN
          READ_SHORT (ab_off + a * 0x28 + 0x12) cast_time
          PATCH_IF (cast_time = 6) BEGIN
            SET cast_already += 1
          END ELSE PATCH_IF (cast_time > 6) BEGIN
            WRITE_SHORT (ab_off + a * 0x28 + 0x12) 6
            SET cast_changed += 1
          END
        END
      END
    BUT_ONLY
    LAF cbmagic_find_aura_payload STR_VAR spell RET pay_res = payload END
    LAF cbmagic_patch_blade_payload INT_VAR not_enemy_row set_8d8 = 1 STR_VAR payload = EVAL ~%pay_res%~ RET pay_changed = changed pay_already = already END
    LAF cbmagic_spell_resref STR_VAR symbol = ~NPC_BLADE_BARRIER~ RET npc_spell = resref npc_found = found END
    ACTION_IF !npc_found BEGIN
      OUTER_SPRINT npc_spell ~sppr698~
    END
    LAF cbmagic_find_aura_payload STR_VAR spell = EVAL ~%npc_spell%~ RET npc_pay = payload END
    LAF cbmagic_patch_blade_payload INT_VAR not_enemy_row set_8d8 = 1 STR_VAR payload = EVAL ~%npc_pay%~ RET npc_changed = changed npc_already = already END
    ACTION_IF (cast_changed > 0) OR (pay_changed > 0) BEGIN
      OUTER_SPRINT find @30039
      OUTER_SPRINT replace @30040
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find replace label = ~CLERIC_BLADE_BARRIER~ END
      OUTER_SPRINT find @30041
      OUTER_SPRINT replace @30042
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find replace label = ~CLERIC_BLADE_BARRIER~ END
      OUTER_SPRINT find @30043
      OUTER_SPRINT replace @30044
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find replace label = ~CLERIC_BLADE_BARRIER~ END
    END
    PRINT ~chriz-bg-magic: CLERIC_BLADE_BARRIER (%spell%): cast %cast_changed%/%cast_already%, payload %pay_changed%/%pay_already%.~
  END
END

// 23. Call Lightning (CLERIC_CALL_LIGHTNING): duration 1 round/level up to 11 bolts (projectiles 85..91).
DEFINE_ACTION_FUNCTION cbmagic_scs_call_lightning
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_CALL_LIGHTNING~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: CLERIC_CALL_LIGHTNING is not in SPELL.IDS or has no .spl file — skipping.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    OUTER_SET already = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      READ_SHORT 0x68 ab_cnt
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: CLERIC_CALL_LIGHTNING (%spell%) skipped: %reason%.~
      END ELSE BEGIN
        READ_LONG 0x64 ab_off
        FOR (a = 0; a < ab_cnt; ++a) BEGIN
          SET ab = ab_off + a * 0x28
          READ_SHORT (ab + 0x10) min_lvl
          READ_SHORT (ab + 0x26) proj
          SET target_proj = (min_lvl <= 5) ? 85 : ((min_lvl >= 11) ? 91 : (80 + min_lvl))
          PATCH_IF (proj = target_proj) BEGIN
            SET already += 1
          END ELSE BEGIN
            WRITE_SHORT (ab + 0x26) target_proj
            SET changed += 1
          END
        END
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      OUTER_SPRINT find @30047
      OUTER_SPRINT replace @30048
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find replace label = ~CLERIC_CALL_LIGHTNING~ END
      OUTER_SPRINT find @30049
      OUTER_SPRINT replace @30050
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find replace label = ~CLERIC_CALL_LIGHTNING~ END
      OUTER_SPRINT find @30051
      OUTER_SPRINT replace @30052
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find replace label = ~CLERIC_CALL_LIGHTNING~ END
    END
    PRINT ~chriz-bg-magic: CLERIC_CALL_LIGHTNING (%spell%): changed %changed%, already %already%.~
  END
END

// 24. Defensive Harmony (CLERIC_DEFENSIVE_HARMONY): cleric-only (0x20 = 0x8000), +4 AC bonus.
DEFINE_ACTION_FUNCTION cbmagic_scs_defensive_harmony
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_DEFENSIVE_HARMONY~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: CLERIC_DEFENSIVE_HARMONY is not in SPELL.IDS or has no .spl file — skipping.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    OUTER_SET already = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      READ_SHORT 0x68 ab_cnt
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: CLERIC_DEFENSIVE_HARMONY (%spell%) skipped: %reason%.~
      END ELSE BEGIN
        READ_SHORT 0x20 priest_type
        PATCH_IF (priest_type != 0x8000) BEGIN
          WRITE_SHORT 0x20 0x8000
          SET changed += 1
        END ELSE BEGIN
          SET already += 1
        END
        READ_LONG 0x64 ab_off
        READ_LONG 0x6a fx_off
        FOR (a = 0; a < ab_cnt; ++a) BEGIN
          SET ab = ab_off + a * 0x28
          READ_SHORT (ab + 0x1e) fx_cnt
          READ_SHORT (ab + 0x20) fx_idx
          FOR (i = 0; i < fx_cnt; ++i) BEGIN
            SET e = fx_off + (fx_idx + i) * 0x30
            READ_SHORT e op
            READ_LONG (e + 0x08) ac_type
            PATCH_IF (op = 0) AND (ac_type = 0) BEGIN
              READ_LONG (e + 0x04) ac_bonus
              PATCH_IF (ac_bonus = 4) BEGIN
                SET already += 1
              END ELSE BEGIN
                WRITE_LONG (e + 0x04) 4
                SET changed += 1
              END
            END
          END
        END
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      OUTER_SPRINT find @30053
      OUTER_SPRINT replace @30054
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find replace label = ~CLERIC_DEFENSIVE_HARMONY~ END
    END
    PRINT ~chriz-bg-magic: CLERIC_DEFENSIVE_HARMONY (%spell%): changed %changed%, already %already%.~
  END
END

// 25. Globe of Blades (CLERIC_GLOBE_OF_BLADES): affects only enemies, save for half.
DEFINE_ACTION_FUNCTION cbmagic_scs_globe_of_blades
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_GLOBE_OF_BLADES~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: CLERIC_GLOBE_OF_BLADES is not in SPELL.IDS or has no .spl file — skipping.~
  END ELSE BEGIN
    LAF cbmagic_splprot_row INT_VAR stat = 0x114 value = 1 relation = 5 RET not_enemy_row = row END
    LAF cbmagic_find_aura_payload STR_VAR spell RET pay_res = payload END
    LAF cbmagic_patch_blade_payload INT_VAR not_enemy_row set_8d8 = 0 STR_VAR payload = EVAL ~%pay_res%~ RET changed already END
    ACTION_IF (changed > 0) BEGIN
      OUTER_SPRINT find @30041
      OUTER_SPRINT replace @30042
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find replace label = ~CLERIC_GLOBE_OF_BLADES~ END
      OUTER_SPRINT find @30045
      OUTER_SPRINT replace @30046
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find replace label = ~CLERIC_GLOBE_OF_BLADES~ END
    END
    PRINT ~chriz-bg-magic: CLERIC_GLOBE_OF_BLADES (%spell%): changed %changed%, already %already%.~
  END
END

// 26. Glyph of Warding (CLERIC_GLYPH_OF_WARDING): casting time 9 -> 5, save for half damage.
DEFINE_ACTION_FUNCTION cbmagic_scs_glyph_of_warding
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_GLYPH_OF_WARDING~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: CLERIC_GLYPH_OF_WARDING is not in SPELL.IDS or has no .spl file — skipping.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    OUTER_SET already = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      READ_SHORT 0x68 ab_cnt
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: CLERIC_GLYPH_OF_WARDING (%spell%) skipped: %reason%.~
      END ELSE BEGIN
        READ_LONG 0x64 ab_off
        READ_LONG 0x6a fx_off
        FOR (a = 0; a < ab_cnt; ++a) BEGIN
          SET ab = ab_off + a * 0x28
          READ_SHORT (ab + 0x12) cast_time
          PATCH_IF (cast_time = 5) BEGIN
            SET already += 1
          END ELSE PATCH_IF (cast_time > 5) BEGIN
            WRITE_SHORT (ab + 0x12) 5
            SET changed += 1
          END
          READ_SHORT (ab + 0x1e) fx_cnt
          READ_SHORT (ab + 0x20) fx_idx
          FOR (i = 0; i < fx_cnt; ++i) BEGIN
            SET e = fx_off + (fx_idx + i) * 0x30
            READ_SHORT e op
            PATCH_IF (op = 12) BEGIN
              READ_LONG (e + 0x24) save_type
              READ_LONG (e + 0x2c) special
              PATCH_IF ((save_type BAND 0x1f) != 0) BEGIN
                PATCH_IF ((special BAND 0x100) != 0) BEGIN
                  SET already += 1
                END ELSE BEGIN
                  WRITE_LONG (e + 0x2c) (special BOR 0x100)
                  SET changed += 1
                END
              END
            END
          END
        END
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      OUTER_SPRINT find @30055
      OUTER_SPRINT replace @30056
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find replace label = ~CLERIC_GLYPH_OF_WARDING~ END
      OUTER_SPRINT find @30057
      OUTER_SPRINT replace @30058
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find replace label = ~CLERIC_GLYPH_OF_WARDING~ END
      OUTER_SPRINT find @30059
      OUTER_SPRINT replace @30060
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find replace label = ~CLERIC_GLYPH_OF_WARDING~ END
    END
    PRINT ~chriz-bg-magic: CLERIC_GLYPH_OF_WARDING (%spell%): changed %changed%, already %already%.~
  END
END

// Helper: create a standalone EFF V2.0 crushing damage resource.
DEFINE_ACTION_FUNCTION cbmagic_write_damage_eff
  INT_VAR dice = 3
          sides = 4
  STR_VAR eff = ~~
BEGIN
  OUTER_SET valid_eff = 0
  ACTION_IF FILE_EXISTS_IN_GAME ~%eff%.eff~ BEGIN
    COPY_EXISTING - ~%eff%.eff~ ~override~
      PATCH_IF (BUFFER_LENGTH >= 0x110) BEGIN
        READ_LONG 0x10 op
        READ_LONG 0x38 d
        READ_LONG 0x3c s
        READ_LONG 0x5c disp
        PATCH_IF (op = 12) AND (d = dice) AND (s = sides) AND (disp = 0) BEGIN
          SET valid_eff = 1
        END
      END
  END
  ACTION_IF !valid_eff BEGIN
    <<<<<<<< .../chriz-bg-magic-inlined/empty_eff
>>>>>>>>
    COPY ~.../chriz-bg-magic-inlined/empty_eff~ ~override/%eff%.eff~
      INSERT_BYTES 0 0x110
      WRITE_ASCII 0x00 ~EFF V2.0~ #8
      WRITE_ASCII 0x08 ~EFF V2.0~ #8
      WRITE_LONG 0x10 12
      WRITE_LONG 0x14 2
      WRITE_LONG 0x18 0
      WRITE_LONG 0x1c 0
      WRITE_LONG 0x20 0
      WRITE_LONG 0x24 1
      WRITE_LONG 0x28 0
      WRITE_SHORT 0x2c 100
      WRITE_SHORT 0x2e 0
      WRITE_LONG 0x38 dice
      WRITE_LONG 0x3c sides
      WRITE_LONG 0x5c 0
  END
END

// 29. Magical Stone (CLERIC_MAGIC_STONE): 3d4 crushing damage (6d4 vs. undead).
DEFINE_ACTION_FUNCTION cbmagic_scs_magical_stone
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_MAGIC_STONE~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: CLERIC_MAGIC_STONE is not in SPELL.IDS or has no .spl file — skipping.~
  END ELSE BEGIN
    LAF cbmagic_write_damage_eff INT_VAR dice = 3 sides = 4 STR_VAR eff = ~cbmgmst1~ END
    LAF cbmagic_write_damage_eff INT_VAR dice = 6 sides = 4 STR_VAR eff = ~cbmgmst2~ END
    OUTER_SET changed = 0
    OUTER_SET already = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      READ_SHORT 0x68 ab_cnt
      PATCH_IF !valid BEGIN
        PATCH_WARN ~chriz-bg-magic: CLERIC_MAGIC_STONE (%spell%) skipped: %reason%.~
      END ELSE BEGIN
        READ_LONG 0x64 ab_off
        READ_LONG 0x6a fx_off
        FOR (a = 0; a < ab_cnt; ++a) BEGIN
          SET ab = ab_off + a * 0x28
          READ_SHORT (ab + 0x1e) fx_cnt
          READ_SHORT (ab + 0x20) fx_idx
          SET g1 = 0
          SET g2 = 0
          SET g4 = 0
          SET g5 = 0
          SET g255 = 0
          SET dmg_e = 0 - 1
          SET any_dmg_e = 0 - 1
          FOR (i = 0; i < fx_cnt; ++i) BEGIN
            SET e = fx_off + (fx_idx + i) * 0x30
            READ_SHORT e op
            PATCH_IF (op = 177) BEGIN
              READ_LONG (e + 0x04) p1
              READ_LONG (e + 0x08) p2
              READ_ASCII (e + 0x14) eff_res (8) NULL
              PATCH_IF (p2 = 3) AND FILE_EXISTS_IN_GAME ~%eff_res%.eff~ BEGIN
                PATCH_IF (p1 = 1) BEGIN SET g1 = 1 END
                PATCH_IF (p1 = 2) BEGIN SET g2 = 1 END
                PATCH_IF (p1 = 4) BEGIN SET g4 = 1 END
                PATCH_IF (p1 = 5) BEGIN SET g5 = 1 END
                PATCH_IF (p1 = 255) BEGIN SET g255 = 1 END
              END
            END ELSE PATCH_IF (op = 12) BEGIN
              READ_LONG (e + 0x1c) dice
              READ_LONG (e + 0x20) sides
              PATCH_IF (dice = 1) AND (sides = 4) AND (dmg_e < 0) BEGIN
                SET dmg_e = e
              END
              PATCH_IF (any_dmg_e < 0) BEGIN
                SET any_dmg_e = e
              END
            END
          END
          PATCH_IF (dmg_e < 0) BEGIN
            SET dmg_e = any_dmg_e
          END
          PATCH_IF g1 AND g2 AND g4 AND g5 AND g255 BEGIN
            SET already += 1
          END ELSE PATCH_IF (dmg_e >= 0) BEGIN
            READ_BYTE (dmg_e + 0x03) pw
            READ_BYTE (dmg_e + 0x0d) dp
            WRITE_SHORT dmg_e 177
            WRITE_BYTE (dmg_e + 0x02) 2
            WRITE_LONG (dmg_e + 0x04) 4
            WRITE_LONG (dmg_e + 0x08) 3
            WRITE_BYTE (dmg_e + 0x0c) 1
            WRITE_LONG (dmg_e + 0x0e) 0
            WRITE_BYTE (dmg_e + 0x12) 100
            WRITE_BYTE (dmg_e + 0x13) 0
            WRITE_ASCII (dmg_e + 0x14) ~cbmgmst2~ #8
            WRITE_LONG (dmg_e + 0x1c) 0
            WRITE_LONG (dmg_e + 0x20) 0
            PATCH_FOR_EACH gen IN 1 2 5 255 BEGIN
              LPF ADD_SPELL_EFFECT
                INT_VAR header = a + 1 opcode = 177 target = 2 power = pw parameter1 = gen parameter2 = 3
                        timing = 1 resist_dispel = dp duration = 0 probability1 = 100 probability2 = 0
                STR_VAR resource = ~cbmgmst1~
              END
            END
            READ_LONG 0x64 ab_off
            READ_LONG 0x6a fx_off
            SET changed += 1
          END
        END
      END
    BUT_ONLY
    ACTION_IF (changed > 0) BEGIN
      OUTER_SPRINT find @30061
      OUTER_SPRINT replace @30062
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find replace label = ~CLERIC_MAGIC_STONE~ END
    END
    PRINT ~chriz-bg-magic: CLERIC_MAGIC_STONE (%spell%): changed %changed%, already %already%.~
  END
END

// Helper: create a standalone EFF V2.0 that casts `subspell` via opcode 146 (instant).
DEFINE_ACTION_FUNCTION cbmagic_write_cast_eff
  STR_VAR eff = ~~
          subspell = ~~
BEGIN
  ACTION_IF !(FILE_EXISTS ~override/%eff%.eff~) BEGIN
    <<<<<<<< .../chriz-bg-magic-inlined/empty_cast_eff
>>>>>>>>
    COPY ~.../chriz-bg-magic-inlined/empty_cast_eff~ ~override/%eff%.eff~
      INSERT_BYTES 0 0x110
      WRITE_ASCII 0x00 ~EFF V2.0~ #8
      WRITE_ASCII 0x08 ~EFF V2.0~ #8
      WRITE_LONG 0x10 146
      WRITE_LONG 0x14 2
      WRITE_LONG 0x18 0
      WRITE_LONG 0x1c 0
      WRITE_LONG 0x20 1
      WRITE_LONG 0x24 1
      WRITE_LONG 0x28 0
      WRITE_SHORT 0x2c 100
      WRITE_SHORT 0x2e 0
      WRITE_ASCIIE 0x30 ~%subspell%~ #8
      WRITE_LONG 0x5c 2
  END
END

// Helper: create a minimal 1-ability SPL V1 file in override (`override/%res%.spl`).
DEFINE_ACTION_FUNCTION cbmagic_create_blank_subspell
  STR_VAR res = ~~
BEGIN
  <<<<<<<< .../chriz-bg-magic-inlined/blank_spl
>>>>>>>>
  COPY ~.../chriz-bg-magic-inlined/blank_spl~ ~override/%res%.spl~
    INSERT_BYTES 0 (0x72 + 0x28)
    WRITE_ASCII 0x00 ~SPL V1  ~ #8
    WRITE_LONG 0x08 (0 - 1)
    WRITE_LONG 0x0c (0 - 1)
    WRITE_SHORT 0x1c 2
    WRITE_BYTE 0x25 0
    WRITE_BYTE 0x27 0
    WRITE_LONG 0x34 1
    WRITE_LONG 0x50 (0 - 1)
    WRITE_LONG 0x64 0x72
    WRITE_SHORT 0x68 1
    WRITE_LONG 0x6a (0x72 + 0x28)
    WRITE_SHORT 0x6e 0
    WRITE_SHORT 0x70 0
    WRITE_BYTE (0x72 + 0x00) 1
    WRITE_BYTE (0x72 + 0x0c) 1
    WRITE_SHORT (0x72 + 0x0e) 300
    WRITE_SHORT (0x72 + 0x10) 1
    WRITE_SHORT (0x72 + 0x26) 1
END

// Helper: patch one insect spell (Summon Insects, Insect Plague, Creeping Doom).
DEFINE_ACTION_FUNCTION cbmagic_patch_insect_spell
  INT_VAR duration = 6
          overall_save = 0
          overall_bonus = 0
          dmg_tick = 2
          sf_pct = 100
          sf_bonus = 0
          fear = 0
          undead_row = 1
          fs_row = 0
          stoneskin_row = 0
          insect_stat = 120
  STR_VAR symbol = ~~
          dmg_eff = ~ipdam1~
          find = ~~
          replace = ~~
  RET spell found
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: %symbol% is not in SPELL.IDS or has no .spl file — skipping.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    OUTER_SET already = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      READ_SHORT 0x68 ab_cnt
      PATCH_IF valid AND (ab_cnt > 0) BEGIN
        READ_LONG 0x64 ab_off
        READ_LONG 0x6a fx_off
        READ_SHORT (ab_off + 0x1e) fx_cnt
        READ_SHORT (ab_off + 0x20) fx_idx
        FOR (i = 0; i < fx_cnt; ++i) BEGIN
          READ_SHORT (fx_off + (fx_idx + i) * 0x30) op0
          READ_ASCII (fx_off + (fx_idx + i) * 0x30 + 0x14) res0 (8) NULL
          PATCH_IF (op0 = 146) AND (~%res0%~ STRING_EQUAL_CASE ~%spell%a~) AND (FILE_EXISTS_IN_GAME ~%spell%a.spl~) BEGIN
            INNER_ACTION BEGIN
              COPY_EXISTING - ~%spell%a.spl~ ~override~
                LPF cbmagic_spl_valid RET sub_valid = valid reason END
                PATCH_IF sub_valid BEGIN
                  READ_SHORT 0x68 sub_ab_cnt
                  PATCH_IF (sub_ab_cnt > 0) BEGIN
                    READ_LONG 0x64 sub_ab_off
                    READ_SHORT (sub_ab_off + 0x1e) sub_fx_cnt
                    PATCH_IF (sub_fx_cnt >= 4) BEGIN
                      SET already = 1
                    END
                  END
                END
            END
          END
        END
      END
    BUT_ONLY
    ACTION_IF !already BEGIN
      LAF cbmagic_write_cast_eff STR_VAR eff = EVAL ~%spell%b~ subspell = EVAL ~%spell%b~ END
      LAF cbmagic_write_cast_eff STR_VAR eff = EVAL ~%spell%c~ subspell = EVAL ~%spell%c~ END

      // Stage A: delivery subspell (%spell%a.spl)
      LAF cbmagic_create_blank_subspell STR_VAR res = EVAL ~%spell%a~ END
      COPY_EXISTING ~%spell%a.spl~ ~override~
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 target = 2 timing = 0 duration = 1 parameter2 = undead_row STR_VAR resource = EVAL ~%spell%a~ END
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 target = 2 timing = 0 duration = 1 parameter2 = fs_row STR_VAR resource = EVAL ~%spell%a~ END
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 233 target = 2 timing = 0 duration = (duration * 6) parameter1 = 1 parameter2 = insect_stat resist_dispel = 2 END
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 215 target = 2 timing = 0 duration = (duration * 6) parameter2 = 1 resist_dispel = 2 STR_VAR resource = ~icinhit~ END
        FOR (r = 0; r < duration; ++r) BEGIN
          SET tm = (r = 0) ? 1 : 4
          LPF ADD_SPELL_EFFECT INT_VAR opcode = 177 target = 2 timing = tm duration = (r * 6) parameter2 = 2 resist_dispel = 2 STR_VAR resource = EVAL ~%spell%b~ END
        END
      BUT_ONLY

      // Stage B: per-round damage + Stoneskin check (%spell%b.spl)
      LAF cbmagic_create_blank_subspell STR_VAR res = EVAL ~%spell%b~ END
      COPY_EXISTING ~%spell%b.spl~ ~override~
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 target = 2 timing = 0 duration = 1 parameter2 = fs_row STR_VAR resource = EVAL ~%spell%b~ END
        SET ticks = 6 / dmg_tick
        FOR (t = 0; t < ticks; ++t) BEGIN
          SET tm = (t = 0) ? 1 : 4
          LPF ADD_SPELL_EFFECT INT_VAR opcode = 177 target = 2 timing = tm duration = (t * dmg_tick) parameter2 = 2 resist_dispel = 2 STR_VAR resource = EVAL ~%dmg_eff%~ END
        END
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 target = 2 timing = 0 duration = 1 parameter2 = stoneskin_row STR_VAR resource = EVAL ~%spell%c~ END
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 177 target = 2 timing = 1 duration = 0 parameter2 = 2 resist_dispel = 2 STR_VAR resource = EVAL ~%spell%c~ END
      BUT_ONLY

      // Stage C: per-round AC/THAC0 penalty, spell failure (save vs. breath), and fear (%spell%c.spl)
      LAF cbmagic_create_blank_subspell STR_VAR res = EVAL ~%spell%c~ END
      COPY_EXISTING ~%spell%c.spl~ ~override~
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 0 target = 2 timing = 0 duration = 6 parameter1 = (0 - 2) resist_dispel = 2 END
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 54 target = 2 timing = 0 duration = 6 parameter1 = (0 - 2) resist_dispel = 2 END
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 60 target = 2 timing = 0 duration = 6 parameter1 = sf_pct parameter2 = 0 resist_dispel = 2 savingthrow = 2 savebonus = sf_bonus END
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 60 target = 2 timing = 0 duration = 6 parameter1 = sf_pct parameter2 = 1 resist_dispel = 2 savingthrow = 2 savebonus = sf_bonus END
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 142 target = 2 timing = 0 duration = 6 parameter2 = 83 resist_dispel = 2 savingthrow = 2 savebonus = sf_bonus END
        PATCH_IF fear BEGIN
          LPF ADD_SPELL_EFFECT INT_VAR opcode = 24 target = 2 timing = 0 duration = 6 resist_dispel = 2 savingthrow = 1 savebonus = (0 - 2) END
          LPF ADD_SPELL_EFFECT INT_VAR opcode = 139 target = 2 timing = 1 duration = 0 parameter1 = 14007 resist_dispel = 2 savingthrow = 1 savebonus = (0 - 2) END
          LPF ADD_SPELL_EFFECT INT_VAR opcode = 142 target = 2 timing = 0 duration = 6 parameter2 = 36 resist_dispel = 2 savingthrow = 1 savebonus = (0 - 2) END
        END
      BUT_ONLY

      // Replace owned main spell effects with op146 -> %spell%a (preserving any foreign mod effects)
      COPY_EXISTING ~%spell%.spl~ ~override~
        LPF cbmagic_spl_valid RET valid reason END
        READ_SHORT 0x68 ab_cnt
        PATCH_IF valid AND (ab_cnt > 0) BEGIN
          PATCH_FOR_EACH del_op IN 60 12 54 0 24 142 215 174 233 BEGIN
            LPF DELETE_EFFECT INT_VAR check_globals = 0 match_opcode = del_op END
          END
          LPF DELETE_EFFECT INT_VAR check_globals = 0 match_opcode = 146 STR_VAR match_resource = EVAL ~%spell%a~ END
          SET st = overall_save ? 2 : 0
          LPF ADD_SPELL_EFFECT
            INT_VAR opcode = 146 target = 2 power = 0 parameter2 = 1 timing = 1 resist_dispel = 2
                    savingthrow = st savebonus = overall_bonus
            STR_VAR resource = EVAL ~%spell%a~
          END
          SET changed = 1
        END
      BUT_ONLY
      ACTION_IF (changed > 0) BEGIN
        ACTION_IF (~%symbol%~ STRING_EQUAL ~CLERIC_INSECT_PLAGUE~) BEGIN
          OUTER_SPRINT f_dmg @30071
          OUTER_SPRINT r_dmg @30072
          LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f_dmg%~ replace = EVAL ~%r_dmg%~ label = EVAL ~%symbol%~ END
          OUTER_SPRINT f_fear @30073
          OUTER_SPRINT r_fear @30074
          LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find = EVAL ~%f_fear%~ replace = EVAL ~%r_fear%~ label = EVAL ~%symbol%~ END
        END
        LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find replace label = EVAL ~%symbol%~ END
      END
    END
    PRINT ~chriz-bg-magic: %symbol% (%spell%): changed %changed%, already %already%.~
  END
END

// Helper: add op321 removals and op206 blocks of insect plague subspells to a Fire Shield spell.
DEFINE_ACTION_FUNCTION cbmagic_add_insect_removal_to_shield
  INT_VAR fs_stat = 125
  STR_VAR shield_sym = ~~
          insects = ~~
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = EVAL ~%shield_sym%~ RET shield = resref found END
  ACTION_IF found BEGIN
    COPY_EXISTING ~%shield%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      READ_SHORT 0x68 ab_cnt
      PATCH_IF valid AND (ab_cnt > 0) BEGIN
        SPRINT list ~%insects%~
        WHILE !(~%list%~ STRING_EQUAL ~~) BEGIN
          INNER_PATCH_SAVE ins ~%list%~ BEGIN REPLACE_TEXTUALLY ~ .*$~ ~~ END
          INNER_PATCH_SAVE list ~%list%~ BEGIN REPLACE_TEXTUALLY ~^[^ ]+ ?~ ~~ END
          READ_LONG 0x64 ab_off
          READ_LONG 0x6a fx_off
          READ_SHORT (ab_off + 0x1e) fx_cnt
          READ_SHORT (ab_off + 0x20) fx_idx
          SET has_206 = 0
          FOR (i = 0; i < fx_cnt; ++i) BEGIN
            SET e = fx_off + (fx_idx + i) * 0x30
            READ_SHORT e op
            READ_ASCII (e + 0x14) res (8) NULL
            PATCH_IF (op = 206) AND (~%res%~ STRING_EQUAL_CASE ~%ins%a~) BEGIN
              SET has_206 = 1
            END
          END
          PATCH_IF !has_206 BEGIN
            LPF CLONE_EFFECT
              INT_VAR silent = 1 check_globals = 0 match_opcode = 233 match_parameter2 = fs_stat
                      opcode = 206 parameter1 = 0 parameter2 = 0
              STR_VAR resource = EVAL ~%ins%a~
            END
          END
          PATCH_FOR_EACH suf IN a b c BEGIN
            SPRINT sub ~%ins%%suf%~
            READ_LONG 0x64 ab_off
            READ_LONG 0x6a fx_off
            READ_SHORT (ab_off + 0x1e) fx_cnt
            READ_SHORT (ab_off + 0x20) fx_idx
            SET has_rem = 0
            FOR (i = 0; i < fx_cnt; ++i) BEGIN
              SET e = fx_off + (fx_idx + i) * 0x30
              READ_SHORT e op
              READ_ASCII (e + 0x14) res (8) NULL
              PATCH_IF (op = 321) AND (~%res%~ STRING_EQUAL_CASE ~%sub%~) BEGIN
                SET has_rem = 1
              END
            END
            PATCH_IF !has_rem BEGIN
              LPF ADD_SPELL_EFFECT INT_VAR insert_point = 0 opcode = 321 target = 1 timing = 1 duration = 0 resist_dispel = 3 STR_VAR resource = EVAL ~%sub%~ END
            END
          END
        END
      END
    BUT_ONLY
  END
END

// Helper: recognize all .itm and .spl resources granting immunity to normal weapons
// (opcode 120, parameter2 = 2) and add op206 / op321 protection against insect swarms,
// and patch WIZARD_DEATH_SPELL (SPWI605) to disperse active insect swarms in its area.
DEFINE_ACTION_FUNCTION cbmagic_apply_insect_pfnw_and_death_spell
  INT_VAR ins_stat = 120
  STR_VAR insects = ~~
BEGIN
  OUTER_PATCH_SAVE first_ins ~%insects%~ BEGIN REPLACE_TEXTUALLY ~ .*$~ ~~ END
  COPY_EXISTING_REGEXP GLOB ~^.+\.itm$~ ~override~
    PATCH_IF (BUFFER_LENGTH >= 0x72) BEGIN
      READ_ASCII 0 sig (8)
      PATCH_IF (~%sig%~ STRING_EQUAL ~ITM V1  ~) BEGIN
        READ_LONG 0x64 ab_off
        READ_SHORT 0x68 ab_cnt
        READ_LONG 0x6a fx_off
        READ_SHORT 0x6e eq_idx
        READ_SHORT 0x70 eq_cnt
        SET total_fx = eq_idx + eq_cnt
        FOR (a = 0; a < ab_cnt; ++a) BEGIN
          PATCH_IF (ab_off + (a + 1) * 0x38 <= BUFFER_LENGTH) BEGIN
            READ_SHORT (ab_off + a * 0x38 + 0x1e) n
            READ_SHORT (ab_off + a * 0x38 + 0x20) first
            PATCH_IF (first + n > total_fx) BEGIN SET total_fx = first + n END
          END
        END
        SET has_pfnw = 0
        SET already_pfnw = 0
        PATCH_IF (fx_off + total_fx * 0x30 <= BUFFER_LENGTH) BEGIN
          FOR (i = 0; i < total_fx; ++i) BEGIN
            SET e = fx_off + i * 0x30
            READ_SHORT e op
            READ_LONG (e + 0x08) p2
            READ_ASCII (e + 0x14) res (8) NULL
            PATCH_IF (op = 120) AND (p2 = 2) BEGIN SET has_pfnw = 1 END
            PATCH_IF (op = 206) AND ((~%res%~ STRING_EQUAL_CASE ~%first_ins%a~) OR (~%res%~ STRING_EQUAL_CASE ~%first_ins%b~)) BEGIN
              SET already_pfnw = 1
            END
          END
        END
        PATCH_IF has_pfnw AND !already_pfnw BEGIN
          SPRINT list ~%insects%~
          WHILE !(~%list%~ STRING_EQUAL ~~) BEGIN
            INNER_PATCH_SAVE ins ~%list%~ BEGIN REPLACE_TEXTUALLY ~ .*$~ ~~ END
            INNER_PATCH_SAVE list ~%list%~ BEGIN REPLACE_TEXTUALLY ~^[^ ]+ ?~ ~~ END
            LPF CLONE_EFFECT
              INT_VAR silent = 1 match_opcode = 120 match_parameter2 = 2 match_duration = 0
                      opcode = 206 parameter1 = 0 parameter2 = 0
              STR_VAR resource = EVAL ~%ins%a~
            END
            LPF CLONE_EFFECT
              INT_VAR silent = 1 match_opcode = 120 match_parameter2 = 2 match_timing = 0
                      opcode = 206 parameter1 = 0 parameter2 = 0
              STR_VAR resource = EVAL ~%ins%b~
            END
            PATCH_FOR_EACH suf IN a b c BEGIN
              LPF CLONE_EFFECT
                INT_VAR silent = 1 match_opcode = 120 match_parameter2 = 2 match_timing = 0
                        opcode = 321 parameter1 = 0 parameter2 = 0 timing = 1 duration = 0
                STR_VAR resource = EVAL ~%ins%%suf%~
              END
            END
          END
        END
      END
    END
  BUT_ONLY

  COPY_EXISTING_REGEXP GLOB ~^.+\.spl$~ ~override~
    LPF cbmagic_spl_valid RET valid reason END
    PATCH_IF valid BEGIN
      READ_LONG 0x64 ab_off
      READ_SHORT 0x68 ab_cnt
      READ_LONG 0x6a fx_off
      READ_SHORT 0x6e eq_idx
      READ_SHORT 0x70 eq_cnt
      SET total_fx = eq_idx + eq_cnt
      FOR (a = 0; a < ab_cnt; ++a) BEGIN
        READ_SHORT (ab_off + a * 0x28 + 0x1e) n
        READ_SHORT (ab_off + a * 0x28 + 0x20) first
        PATCH_IF (first + n > total_fx) BEGIN SET total_fx = first + n END
      END
      SET has_pfnw = 0
      SET already_pfnw = 0
      FOR (i = 0; i < total_fx; ++i) BEGIN
        SET e = fx_off + i * 0x30
        READ_SHORT e op
        READ_LONG (e + 0x08) p2
        READ_ASCII (e + 0x14) res (8) NULL
        PATCH_IF (op = 120) AND (p2 = 2) BEGIN SET has_pfnw = 1 END
        PATCH_IF (op = 206) AND ((~%res%~ STRING_EQUAL_CASE ~%first_ins%a~) OR (~%res%~ STRING_EQUAL_CASE ~%first_ins%b~)) BEGIN
          SET already_pfnw = 1
        END
      END
      PATCH_IF has_pfnw AND !already_pfnw BEGIN
        SPRINT list ~%insects%~
        WHILE !(~%list%~ STRING_EQUAL ~~) BEGIN
          INNER_PATCH_SAVE ins ~%list%~ BEGIN REPLACE_TEXTUALLY ~ .*$~ ~~ END
          INNER_PATCH_SAVE list ~%list%~ BEGIN REPLACE_TEXTUALLY ~^[^ ]+ ?~ ~~ END
          LPF CLONE_EFFECT
            INT_VAR silent = 1 match_opcode = 120 match_parameter2 = 2 match_duration = 0
                    opcode = 206 parameter1 = 0 parameter2 = 0
            STR_VAR resource = EVAL ~%ins%a~
          END
          LPF CLONE_EFFECT
            INT_VAR silent = 1 match_opcode = 120 match_parameter2 = 2 match_timing = 0
                    opcode = 206 parameter1 = 0 parameter2 = 0
            STR_VAR resource = EVAL ~%ins%b~
          END
          PATCH_FOR_EACH suf IN a b c BEGIN
            LPF CLONE_EFFECT
              INT_VAR silent = 1 match_opcode = 120 match_parameter2 = 2 match_timing = 0
                      opcode = 321 parameter1 = 0 parameter2 = 0 timing = 1 duration = 0
              STR_VAR insert = ~first~ resource = EVAL ~%ins%%suf%~
            END
          END
        END
      END
    END
  BUT_ONLY

  // Death Spell (WIZARD_DEATH_SPELL, SPWI605) disperses active insect swarms in its area.
  LAF cbmagic_spell_resref STR_VAR symbol = ~WIZARD_DEATH_SPELL~ RET death_spl = resref death_found = found END
  ACTION_IF death_found BEGIN
    OUTER_SET death_already = 0
    COPY_EXISTING - ~%death_spl%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF valid BEGIN
        READ_LONG 0x64 ab_off
        READ_SHORT 0x68 ab_cnt
        READ_LONG 0x6a fx_off
        FOR (a = 0; a < ab_cnt; ++a) BEGIN
          READ_SHORT (ab_off + a * 0x28 + 0x1e) n
          READ_SHORT (ab_off + a * 0x28 + 0x20) first
          FOR (i = 0; i < n; ++i) BEGIN
            SET e = fx_off + (first + i) * 0x30
            READ_SHORT e op
            READ_ASCII (e + 0x14) res (8) NULL
            PATCH_IF ((op = 146) OR (op = 148)) AND (~%res%~ STRING_EQUAL_CASE ~cbmg605b~) BEGIN
              SET death_already = 1
            END
          END
        END
      END
    ACTION_IF !death_already BEGIN
      LAF cbmagic_splprot_row INT_VAR stat = ins_stat value = 0 relation = 1 RET ins_zero_row = row END
      OUTER_SET inareapa_id = IDS_OF_SYMBOL (~projectl~ ~INAREAPA~)
      ACTION_IF (inareapa_id < 0) BEGIN OUTER_SET inareapa_id = 157 END
      OUTER_SET inareapa_proj = inareapa_id + 1
      COPY_EXISTING ~%death_spl%.spl~ ~override/cbmg605a.spl~
        WRITE_LONG 0x08 (0 - 1)
        WRITE_LONG 0x50 (0 - 1)
      COPY_EXISTING ~%death_spl%.spl~ ~override/cbmg605b.spl~
        WRITE_LONG 0x08 (0 - 1)
        WRITE_LONG 0x50 (0 - 1)
        READ_LONG 0x64 ab_off
        READ_SHORT 0x68 ab_cnt
        FOR (a = 0; a < ab_cnt; ++a) BEGIN
          WRITE_SHORT (ab_off + a * 0x28 + 0x26) inareapa_proj
        END
        LPF DELETE_EFFECT INT_VAR check_globals = 0 END
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 target = 2 timing = 0 duration = 1 parameter2 = ins_zero_row STR_VAR resource = ~cbmg605b~ END
        SPRINT list ~%insects%~
        WHILE !(~%list%~ STRING_EQUAL ~~) BEGIN
          INNER_PATCH_SAVE ins ~%list%~ BEGIN REPLACE_TEXTUALLY ~ .*$~ ~~ END
          INNER_PATCH_SAVE list ~%list%~ BEGIN REPLACE_TEXTUALLY ~^[^ ]+ ?~ ~~ END
          PATCH_FOR_EACH suf IN a b c BEGIN
            LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 target = 2 timing = 1 duration = 0 STR_VAR resource = EVAL ~%ins%%suf%~ END
          END
        END
        SET disp_strref = RESOLVE_STR_REF (~Insect swarm dispersed~)
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 139 target = 2 timing = 1 duration = 0 parameter1 = disp_strref END
      COPY_EXISTING ~%death_spl%.spl~ ~override~
        READ_LONG 0x64 ab_off
        READ_SHORT 0x68 ab_cnt
        FOR (a = 0; a < ab_cnt; ++a) BEGIN
          WRITE_SHORT (ab_off + a * 0x28 + 0x26) 1
        END
        LPF DELETE_EFFECT INT_VAR check_globals = 0 END
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 148 target = 1 power = 6 parameter2 = 1 timing = 1 duration = 0 STR_VAR resource = ~cbmg605a~ END
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 148 target = 1 power = 6 parameter2 = 1 timing = 1 duration = 0 STR_VAR resource = ~cbmg605b~ END
      BUT_ONLY
    END
  END
END

// 27. Summon Insects, Insect Plague, Creeping Doom: per-round save vs. breath against spell
// failure, Fire Shields remove and block, Stoneskin holds off effects while skins remain,
// immunity to nonmagical weapons protects, undead are immune, MR and Dispel Magic do not help.
DEFINE_ACTION_FUNCTION cbmagic_scs_insect_plague
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_SUMMON_INSECTS~ RET f1 = found END
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_INSECT_PLAGUE~ RET f2 = found END
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_CREEPING_DOOM~ RET f3 = found END
  ACTION_IF !(f1 OR f2 OR f3) BEGIN
    PRINT ~chriz-bg-magic: CLERIC_SUMMON_INSECTS, CLERIC_INSECT_PLAGUE, and CLERIC_CREEPING_DOOM are not in SPELL.IDS or have no .spl file — skipping.~
  END ELSE BEGIN
    LAF cbmagic_splprot_row INT_VAR stat = 0x10b value = 4 relation = 1 RET undead_row = row END
    OUTER_SET fs_stat = IDS_OF_SYMBOL (~stats~ ~WIZARD_FIRE_SHIELD~)
    ACTION_IF (fs_stat < 0) BEGIN OUTER_SET fs_stat = 125 END
    OUTER_SET ss_stat = IDS_OF_SYMBOL (~stats~ ~STONESKINS~)
    ACTION_IF (ss_stat < 0) BEGIN OUTER_SET ss_stat = 88 END
    OUTER_SET ins_stat = IDS_OF_SYMBOL (~stats~ ~CLERIC_INSECT_PLAGUE~)
    ACTION_IF (ins_stat < 0) BEGIN OUTER_SET ins_stat = 120 END

    LAF cbmagic_splprot_row INT_VAR stat = fs_stat value = 1 relation = 4 RET fs_row = row END
    LAF cbmagic_splprot_row INT_VAR stat = ss_stat value = 1 relation = 4 RET stoneskin_row = row END

    OUTER_SPRINT patched_insects ~~

    OUTER_SPRINT find @30063
    OUTER_SPRINT replace @30064
    LAF cbmagic_patch_insect_spell
      INT_VAR duration = 7 overall_save = 1 overall_bonus = (0 - 4) dmg_tick = 2 sf_pct = 50 sf_bonus = 0 fear = 0
              undead_row fs_row stoneskin_row insect_stat = ins_stat
      STR_VAR symbol = ~CLERIC_SUMMON_INSECTS~ dmg_eff = ~ipdam1~ find replace
      RET s1 = spell f1 = found
    END
    ACTION_IF f1 BEGIN OUTER_SPRINT patched_insects ~%patched_insects%%s1% ~ END

    OUTER_SPRINT find @30065
    OUTER_SPRINT replace @30066
    LAF cbmagic_patch_insect_spell
      INT_VAR duration = 6 overall_save = 0 overall_bonus = 0 dmg_tick = 1 sf_pct = 100 sf_bonus = (0 - 2) fear = 1
              undead_row fs_row stoneskin_row insect_stat = ins_stat
      STR_VAR symbol = ~CLERIC_INSECT_PLAGUE~ dmg_eff = ~ipdam1~ find replace
      RET s2 = spell f2 = found
    END
    ACTION_IF f2 BEGIN OUTER_SPRINT patched_insects ~%patched_insects%%s2% ~ END

    OUTER_SPRINT find @30067
    OUTER_SPRINT replace @30068
    LAF cbmagic_patch_insect_spell
      INT_VAR duration = 3 overall_save = 0 overall_bonus = 0 dmg_tick = 1 sf_pct = 100 sf_bonus = (0 - 2) fear = 1
              undead_row fs_row stoneskin_row insect_stat = ins_stat
      STR_VAR symbol = ~CLERIC_CREEPING_DOOM~ dmg_eff = ~ipdam2~ find replace
      RET s3 = spell f3 = found
    END
    ACTION_IF f3 BEGIN OUTER_SPRINT patched_insects ~%patched_insects%%s3% ~ END

    OUTER_PATCH_SAVE patched_insects ~%patched_insects%~ BEGIN REPLACE_TEXTUALLY ~ +$~ ~~ END
    ACTION_IF !(~%patched_insects%~ STRING_EQUAL ~~) BEGIN
      ACTION_FOR_EACH sh IN WIZARD_FIRE_SHIELD_BLUE WIZARD_FIRE_SHIELD_RED CLERIC_AURA_OF_FLAMING_DEATH BEGIN
        LAF cbmagic_add_insect_removal_to_shield INT_VAR fs_stat STR_VAR shield_sym = EVAL ~%sh%~ insects = EVAL ~%patched_insects%~ END
      END
      LAF cbmagic_apply_insect_pfnw_and_death_spell INT_VAR ins_stat STR_VAR insects = EVAL ~%patched_insects%~ END
    END
  END
END

// 30. Nature's Beauty (CLERIC_NATURE_BEAUTY): blindness moved to schoolless area subspell
// (CBMGNB1.SPL, school = 0, target = 5, projectile = 159) so True Sight does not dispel it
// and single-target deflections do not intercept it, and gated on the save (failed save =
// humanoids die + permanent blindness with timing=0 duration=999999; successful save = blind
// for 3 rounds with duration=18).
DEFINE_ACTION_FUNCTION cbmagic_scs_natures_beauty
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~CLERIC_NATURE_BEAUTY~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: CLERIC_NATURE_BEAUTY is not in SPELL.IDS or has no .spl file — skipping.~
  END ELSE BEGIN
    OUTER_SET changed = 0
    OUTER_SET already = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      READ_SHORT 0x68 ab_cnt
      PATCH_IF valid AND (ab_cnt > 0) BEGIN
        READ_LONG 0x64 ab_off
        READ_LONG 0x6a fx_off
        READ_SHORT (ab_off + 0x1e) fx_cnt
        READ_SHORT (ab_off + 0x20) fx_idx
        FOR (i = 0; i < fx_cnt; ++i) BEGIN
          SET e = fx_off + (fx_idx + i) * 0x30
          READ_SHORT e op
          READ_BYTE (e + 0x02) tgt
          READ_ASCII (e + 0x14) res (8) NULL
          PATCH_IF (op = 146) AND (tgt = 1) AND (~%res%~ STRING_EQUAL_CASE ~cbmgnb1~) AND (FILE_EXISTS_IN_GAME ~cbmgnb1.spl~) BEGIN
            SET already = 1
          END
        END
      END
    BUT_ONLY
    ACTION_IF !already BEGIN
      // Single schoolless area subspell (CBMGNB1.SPL, school = 0, target = 5, projectile = 159):
      // applies cosmetics, then permanent blindness (timing = 0, duration = 999999) + op318 on failed
      // save vs. spell (+3), followed by 3-round blindness (timing = 0, duration = 18) for creatures
      // that made the save.
      COPY_EXISTING ~%spell%.spl~ ~override/cbmgnb1.spl~
        WRITE_LONG 0x08 (0 - 1)
        WRITE_LONG 0x0c (0 - 1)
        WRITE_BYTE 0x25 0
        READ_LONG 0x64 ab_off
        WRITE_BYTE (ab_off + 0x0c) 5
        WRITE_SHORT (ab_off + 0x26) 159
        LPF DELETE_EFFECT INT_VAR check_globals = 0 END
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 139 target = 2 power = 7 parameter1 = 14674 timing = 1 resist_dispel = 1 END
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 141 target = 2 power = 7 parameter2 = 18 timing = 1 resist_dispel = 1 END
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 61 target = 2 power = 7 parameter1 = 0xc8c8c800 parameter2 = 25 timing = 1 resist_dispel = 1 END
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 174 target = 2 power = 7 timing = 1 resist_dispel = 1 STR_VAR resource = ~EFF_P71B~ END
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 74 target = 2 power = 7 timing = 0 duration = 999999 resist_dispel = 1 savingthrow = 1 savebonus = 3 END
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 142 target = 2 power = 7 parameter2 = 8 timing = 0 duration = 999999 resist_dispel = 1 savingthrow = 1 savebonus = 3 END
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 318 target = 2 power = 7 timing = 0 duration = 1 resist_dispel = 1 savingthrow = 1 savebonus = 3 STR_VAR resource = ~cbmgnb1~ END
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 74 target = 2 power = 7 timing = 0 duration = 18 resist_dispel = 1 END
        LPF ADD_SPELL_EFFECT INT_VAR opcode = 142 target = 2 power = 7 parameter2 = 8 timing = 0 duration = 18 resist_dispel = 1 END

      // Main spell: delete only owned blindness effects (preserving op55, caster op215, and any
      // unrelated effects), and cast CBMGNB1 on self (target = 1) so CBMGNB1's area projectile delivers it.
      COPY_EXISTING ~%spell%.spl~ ~override~
        LPF DELETE_EFFECT INT_VAR check_globals = 0 match_opcode = 74 END
        LPF DELETE_EFFECT INT_VAR check_globals = 0 match_opcode = 139 match_parameter1 = 14674 END
        LPF DELETE_EFFECT INT_VAR check_globals = 0 match_opcode = 141 match_parameter2 = 18 END
        LPF DELETE_EFFECT INT_VAR check_globals = 0 match_opcode = 61 END
        LPF DELETE_EFFECT INT_VAR check_globals = 0 match_opcode = 142 match_parameter2 = 8 END
        LPF DELETE_EFFECT INT_VAR check_globals = 0 match_opcode = 174 STR_VAR match_resource = ~EFF_P71B~ END
        LPF DELETE_EFFECT INT_VAR check_globals = 0 match_opcode = 146 STR_VAR match_resource = ~dw#nbsub~ END
        LPF DELETE_EFFECT INT_VAR check_globals = 0 match_opcode = 146 STR_VAR match_resource = ~cbmgnb1~ END
        LPF DELETE_EFFECT INT_VAR check_globals = 0 match_opcode = 146 STR_VAR match_resource = ~cbmgnb2~ END
        LPF ADD_SPELL_EFFECT
          INT_VAR opcode = 146 target = 1 power = 0 parameter2 = 1 timing = 1 resist_dispel = 0
          STR_VAR resource = ~cbmgnb1~
        END
        SET changed = 1
      BUT_ONLY
      OUTER_SPRINT find @30069
      OUTER_SPRINT replace @30070
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find replace label = ~CLERIC_NATURE_BEAUTY~ END
    END
    PRINT ~chriz-bg-magic: CLERIC_NATURE_BEAUTY (%spell%): changed %changed%, already %already%.~
  END
END




