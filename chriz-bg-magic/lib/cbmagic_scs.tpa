// 7. Power Word, Stun (WIZARD_POWER_WORD_STUN): Conjuration -> Enchantment, Free Action protects.
DEFINE_ACTION_FUNCTION cbmagic_scs_power_word_stun
BEGIN
  LAF cbmagic_spell_resref STR_VAR symbol = ~WIZARD_POWER_WORD_STUN~ RET spell = resref found END
  ACTION_IF !found BEGIN
    PRINT ~chriz-bg-magic: WIZARD_POWER_WORD_STUN is not in SPELL.IDS or has no .spl file — skipping.~
  END ELSE BEGIN
    LAF cbmagic_conjuration_to_enchantment STR_VAR spell label = ~WIZARD_POWER_WORD_STUN~ RET sch_changed = changed sch_already = already END
    LAF cbmagic_free_action_splprot_rows RET splstate_row splstate_val stat_row END
    OUTER_SET fa_added = 0
    OUTER_SET fa_present = 0
    COPY_EXISTING ~%spell%.spl~ ~override~
      LPF cbmagic_spl_valid RET valid reason END
      PATCH_IF valid BEGIN
        LPF cbmagic_add_free_action_immunity INT_VAR splstate_row splstate_val stat_row RET fa_added = added fa_present = present END
      END
    BUT_ONLY
    ACTION_IF (fa_added > 0) BEGIN
      OUTER_SPRINT find @30013
      OUTER_SPRINT replace @30014
      LAF cbmagic_update_texts INT_VAR quiet = 1 STR_VAR spell find replace label = ~WIZARD_POWER_WORD_STUN~ END
    END
    PRINT ~chriz-bg-magic: WIZARD_POWER_WORD_STUN (%spell%): school %sch_changed%/%sch_already%, free action %fa_added%/%fa_present%.~
  END
END

