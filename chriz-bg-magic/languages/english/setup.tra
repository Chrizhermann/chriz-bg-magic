@100 = ~Chriz BG Magic~

@9000 = ~Chriz BG Magic is for Baldur's Gate II: Enhanced Edition and the Enhanced Edition Trilogy (EET).~
@9001 = ~Spell Revisions is installed. Chriz BG Magic replaces it and does not install on top of it.~
@9002 = ~Spell Revisions is installed. Do not use Chriz BG Magic together with Spell Revisions: the two are not compatible, and its changes were made for the base game's spells.~

// Description updates: regular expressions over the game's English texts.
// Save vs. Breath (and Web): "Saving Throw vs. Spell", "Save vs. Spell" -> "... vs. Breath".
@9101 = ~\(Sav[A-Za-z ]+\) vs\. Spells?~
@9102 = ~\1 vs. Breath~
// Minor Spell Deflection: "This spell will only affect up to 7th-level spells".
@9111 = ~up to 7th-level spells~
@9112 = ~up to 4th-level spells~

// SCS batch description updates (@30000+).
@30001 = ~Each orb will do damage to the target against which there is no save\(.*\n?\)*~
@30002 = ~Each orb will do damage to the target against which there is no save and an effect against which the target must save vs. Spell:
 1st Level: 1d4 magic damage and blinds the target for 1 round.
 2nd Level: 1d6 fire damage and inflicts pain (-1 penalty to AC and THAC0) for 1 round.
 3rd Level: 1d8 magic damage and burns the target for an additional 1d3 fire damage.
 4th Level: 1d10 magic damage and blinds the target for 4 rounds.
 5th Level: 1d12 magic damage and stuns the target for 3 rounds.
 7th Level: 2d8 magic damage and paralyzes the target for 13 rounds.~

